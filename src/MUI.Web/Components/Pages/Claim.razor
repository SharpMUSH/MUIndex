@page "/g/{Slug}/claim"
@using Microsoft.AspNetCore.Identity
@using MUI.Catalog
@using MUI.Catalog.Persistence
@using MUI.Discovery
@using MUI.Web.Accounts
@using MUI.Web.Localization
@inject IServiceProvider Services
@inject TimeProvider Clock

@*
    Claiming a game: sign in, then publish a token where a probe can read it (spec §8.1).

    State is durable server-side, so the page can be left and revisited unchanged — nothing has to
    be finished in one sitting. The token is a nonce, not a secret: it will be published where any
    anonymous connection reads it, so holding it proves only write access to that server, and the
    claim is bound to the account that asked.
*@

@* The game's name is its own bytes and goes into the message as an argument, not as text a
   translator could edit — the same rule that keeps a hostname out of the bundle. *@
<SitePreview Title="@PreviewCopy.Titles.Claim(Tag, Game?.Name ?? Slug)" Data="false"
             Description="@PreviewCopy.Pages.Claim(Tag)" />

@if (Game is null)
{
    <section class="prose"><h1>@L("claim.noGame")</h1></section>
}
else if (Claims is null)
{
    <section class="prose">
        <h1>@Title</h1>
        <p>@L("claim.noDatabase")</p>
    </section>
}
else if (User is null)
{
    <section class="prose">
        <h1>@Title</h1>
        <p>@L("claim.needAccount")</p>
        @* Carries this page's address, so signing in comes back here rather than to the dashboard —
           the operator is on this page because they want to claim this game. *@
        <p><a class="button" href="@ReturnPath.SignInFrom(HttpContext)">@L("claim.signIn")</a></p>
    </section>
}
else if (Pending is null)
{
    @* The game already has owners, so arriving here isn't by itself the ask: §8.5 allows several
       owners and §8.4 makes a counter-claim how a game changes hands, and a probe cannot tell them
       apart — both publish the identical line. So the choice is made before the token exists. *@
    <section class="prose">
        <h1>@Title</h1>

        @* Owner count/plural agreement is resolved inside the message, not chosen here — an
           English plural rule compiled into the page has nowhere for a 3- or 6-form language. *@
        <p>@Say("claim.hasOwners", ("count", Owners.Count))</p>

        <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/start")">
            <AntiforgeryToken />
            <input type="hidden" name="intent" value="join" />
            <button type="submit">@L("claim.join.button")</button>
            <p class="faint">@L("claim.join.note")</p>
        </form>

        <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/start")">
            <AntiforgeryToken />
            <input type="hidden" name="intent" value="assume" />
            <button type="submit">@L("claim.assume.button")</button>
            <p class="faint">@Say("claim.assume.note", ("count", Owners.Count))</p>
        </form>
    </section>
}
else
{
    <section class="prose">
        <h1>@Title</h1>

        @if (Pending!.IsVerified)
        {
            @* One id per channel, not one sentence with the channel slotted in: "from the MSSP
               report", "from the connect screen" and "from a TXT record" take different
               prepositions and cases in some languages. *@
            <p class="verified">
                <strong>@L("claim.verified.lead")</strong>
                @Say(
                    Pending.VerifiedVia switch
                    {
                        ClaimChannel.Mssp => "claim.verified.viaMssp",
                        ClaimChannel.DnsTxt => "claim.verified.viaDns",
                        _ => "claim.verified.viaScreen",
                    },
                    ("date", Dates.Absolute(Tag, Pending.ClaimedAt!.Value)))
            </p>
            @* A TXT record is never read off a probe, so it is not §7.3's identity beacon — the
               general sentence would be the page claiming a mechanism this channel does not have. *@
            <p>@L(Pending.VerifiedVia == ClaimChannel.DnsTxt
                     ? "claim.verified.leaveItDns"
                     : "claim.verified.leaveIt")</p>
            <p><a href="@HttpContext.Link("/account")">@L("claim.yourGames")</a></p>
        }
        else
        {
            <p>@L("claim.publish")</p>

            @if (Pending.Intent is ClaimIntent.Assume)
            {
                <p class="refused">
                    <strong>@L("claim.transfer.lead")</strong>
                    @Say("claim.transfer.body", ("count", Owners.Count))
                </p>
            }

            @* translate="no": translating the token would destroy the evidence, not localize it —
               it must be these exact bytes in every language. *@
            <p class="token mono" translate="no">@Pending.Token</p>

            <h2>@L("claim.either.heading")</h2>

            <h3>@L("claim.mssp.heading")</h3>
            <pre class="mono">@ClaimTokenBeacon.MsspVariable @Pending.Token</pre>
            @* Every name below is machine voice, placed rather than translated. Accepted spellings
               come from ClaimTokenBeacon rather than being retyped — two lists that must agree is
               one list that eventually doesn't. *@
            @* Each sentence in its own <span>: Razor drops whitespace on a line that opens a code
               block, so a bare @foreach beside a sibling sentence would run the two together. *@
            <p class="faint">
                <span>
                    @foreach (var part in Sentence.Place(Tag, "claim.mssp.note", ["codebase", "file"]))
                    {
                        @if (part.Slot is "codebase")
                        {
                            <span translate="no">PennMUSH</span>
                        }
                        else if (part.Slot is "file")
                        {
                            <code translate="no">mush.cnf</code>
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                </span>
                <span>
                    @foreach (var part in Sentence.Place(Tag, "claim.mssp.aliases", ["aliases"]))
                    {
                        @if (part.Slot is "aliases")
                        {
                            for (var i = 0; i < Aliases.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <text>, </text>
                                }

                                <code translate="no">@Aliases[i]</code>
                            }
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                </span>
            </p>

            <h3>@L("claim.screen.heading")</h3>
            <pre class="mono">@ClaimTokenBeacon.ConnectScreenPrefix @Pending.Token</pre>
            <p class="faint">@L("claim.screen.note")</p>

            @* §8.3's third channel. Shown only when we know an address to tell them to publish
               under — a game with no endpoint on record has no zone we could look in, and printing
               a record with a blank name would be instructions that cannot work. *@
            @if (Zones.Count > 0)
            {
                <h3>@L("claim.dns.heading")</h3>

                @if (Pending.Intent is ClaimIntent.Assume)
                {
                    @* Said before the record rather than after it: an operator who has already
                       published a TXT record and come back to find nothing happened has been let
                       down by the page, not by the channel. *@
                    <p class="refused">@L("claim.dns.noAssume")</p>
                }
                else
                {
                    @* One line per host, ports and all — a game on six ports is one zone, and the
                       qualifier is what says which listener the record speaks for. The whole line
                       is machine voice and is placed, never translated. *@
                    <pre class="mono" translate="no">@foreach (var zone in Zones)
{
    @($"{zone.Name}. IN TXT \"{Pending.Token}={string.Join(',', zone.Ports)}\"")
    <text>
</text>
}</pre>
                    <p class="faint">@L("claim.dns.note")</p>
                }
            }

            <h2>@L("claim.then.heading")</h2>
            <p>@Say("claim.then.body", ("date", Dates.Absolute(Tag, Pending.ExpiresAt)))</p>

            <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/check")">
                <AntiforgeryToken />
                <button type="submit" disabled="@(!CanCheck)">@L("claim.check.button")</button>
                @* Moves the game to the front of the crawl queue; the crawler still dials on its
                   own schedule, under CRAWL DELAY — must not be worded as dialling immediately. *@
                <span class="faint">@L(CanCheck ? "claim.check.can" : "claim.check.rationed")</span>
            </form>
        }
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private GameRecord? Game { get; set; }

    private ClaimService? Claims { get; set; }

    private MuiUser? User { get; set; }

    private GameClaim? Pending { get; set; }

    /// <summary>Whoever has already proved control of this game (spec §8.5).</summary>
    private IReadOnlyList<GameClaim> Owners { get; set; } = [];

    private bool CanCheck => Pending is not null && Claims!.MayRecheck(Pending);

    /// <summary>
    /// Loads the page, and mints a token if this account has none outstanding for this game.
    /// </summary>
    /// <remarks>
    /// Minting on view rather than behind a second button is deliberate: arriving here is the ask.
    /// <see cref="ClaimService.IssueAsync"/> returns an existing pending claim rather than replacing
    /// it, so a refresh doesn't invalidate a token the operator already pasted into their config.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        // Must read via IGameStore, not the public listing query: a submitted game is hidden from
        // IGameQueries until claimed (migration 0010), so looking it up the listing's way would
        // make claiming the one thing a hidden game could never do.
        Game = Services.GetService<IGameStore>() is { } store
            ? await store.BySlugAsync(Slug)
            : null;

        Claims = Services.GetService<ClaimService>();

        if (Game is null || Claims is null)
        {
            return;
        }

        if (Services.GetService<UserManager<MuiUser>>() is { } users
            && HttpContext?.User is { Identity.IsAuthenticated: true } principal)
        {
            User = await users.GetUserAsync(principal);
        }

        if (User is null)
        {
            return;
        }

        Owners = await Claims.OwnersAsync(Game.Id);

        var mine = (await Services.GetRequiredService<IClaimStore>().ForUserAsync(User.Id))
            .Where(claim => claim.GameId == Game.Id)
            .ToList();

        Pending = mine.FirstOrDefault(claim => claim.IsVerified)
            ?? mine.FirstOrDefault(claim => claim.IsPending(Clock.GetUtcNow()));

        // Only for a game nobody owns; a game with owners has two possible meanings for "the ask"
        // and falls through to the explicit choice above instead.
        if (Pending is null && Owners.Count == 0)
        {
            Pending = await Claims.IssueAsync(Game.Id, User.Id);
        }

        if (Pending is { IsVerified: false } && Services.GetService<IEndpointStore>() is { } endpoints)
        {
            Zones =
            [
                .. (await endpoints.ForGameAsync(Game.Id))
                    .Where(endpoint => endpoint.State is not EndpointState.Gone)
                    .GroupBy(endpoint => endpoint.Host, StringComparer.OrdinalIgnoreCase)
                    .Select(host => new Zone(
                        ClaimTokenBeacon.DnsNameFor(host.Key),
                        [.. host.Select(endpoint => endpoint.Port).Distinct().Order()]))
                    .OrderBy(zone => zone.Name, StringComparer.Ordinal),
            ];
        }
    }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Tag => HttpContext.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.Say(Tag, id, args);

    /// <summary>
    /// The heading, with the game's name placed by the message.
    /// </summary>
    /// <remarks>
    /// A separate id from <c>preview.title.claim</c> despite identical English: one is a tab title,
    /// the other a document heading, and languages that decline the two differently need both ids.
    /// </remarks>
    private string Title => Say("claim.title", ("game", Game!.Name));

    /// <summary>
    /// One TXT record's name and the ports it has to name, per host this game answers on.
    /// </summary>
    /// <param name="Name">The record's fully-qualified name, from <see cref="ClaimTokenBeacon"/>.</param>
    /// <param name="Ports">Every port this game holds on that host, so one record covers them all.</param>
    private sealed record Zone(string Name, IReadOnlyList<int> Ports);

    /// <summary>
    /// The records this operator should create, grouped the way DNS is: one name per host.
    /// </summary>
    /// <remarks>
    /// Addresses the game has moved off are left out, matching <see cref="DnsClaimVerifier"/> — a
    /// page that told somebody to publish under a hostname the verifier will not read would be
    /// instructions that cannot work. Empty when the site has no endpoint store behind it, which is
    /// also when the section is not rendered at all.
    /// </remarks>
    private IReadOnlyList<Zone> Zones { get; set; } = [];

    /// <summary>
    /// The other MSSP variable names a probe accepts, as the crawler spells them.
    /// </summary>
    /// <remarks>
    /// Read from <see cref="ClaimTokenBeacon.AcceptedMsspVariables"/> rather than retyped, so a
    /// parser change can't silently leave this page listing a stale set. First entry is printed in
    /// full above.
    /// </remarks>
    private static IReadOnlyList<string> Aliases =>
        [.. ClaimTokenBeacon.AcceptedMsspVariables.Skip(1)];
}
