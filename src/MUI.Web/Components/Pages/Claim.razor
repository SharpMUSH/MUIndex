@page "/g/{Slug}/claim"
@using Microsoft.AspNetCore.Identity
@using MUI.Catalog
@using MUI.Catalog.Persistence
@using MUI.Discovery
@using MUI.Web.Accounts
@using MUI.Web.Localization
@inject IServiceProvider Services
@inject TimeProvider Clock

@*
    Claiming a game: sign in, then publish a token where a probe can read it (spec §8.1).

    Nobody has to write anything down. What is on this page is durable server-side state, shown for
    as long as the claim is pending, with each channel's exact line ready to copy — close the tab and
    come back next week and it is unchanged. A scheme that had to be finished in one sitting would
    put a transcription error between an owner and their listing.

    The token is a nonce and not a secret. We are asking for it to be published where every anonymous
    connection reads it, so holding it can never confer anything: it proves somebody with write
    access to that server published it, and the account this claim is bound to answers who asked.
*@

@* The game's name is its own bytes and goes into the message as an argument, not as text a
   translator could edit — the same rule that keeps a hostname out of the bundle. *@
<SitePreview Title="@PreviewCopy.Titles.Claim(Tag, Game?.Name ?? Slug)" Data="false"
             Description="@PreviewCopy.Pages.Claim(Tag)" />

@if (Game is null)
{
    <section class="prose"><h1>@L("claim.noGame")</h1></section>
}
else if (Claims is null)
{
    <section class="prose">
        <h1>@Title</h1>
        <p>@L("claim.noDatabase")</p>
    </section>
}
else if (User is null)
{
    <section class="prose">
        <h1>@Title</h1>
        <p>@L("claim.needAccount")</p>
        <p><a class="button" href="@HttpContext.Link("/account/sign-in")">@L("claim.signIn")</a></p>
    </section>
}
else if (Pending is null)
{
    @*
        The game already has owners, so arriving here is not by itself the ask: §8.5 allows several
        owners and §8.4 makes a counter-claim how a game changes hands, and NOTHING IN A PROBE CAN
        TELL THEM APART — both publish the identical line in the identical config file. So the
        choice is made before the token exists, by the person who knows which they mean.
    *@
    <section class="prose">
        <h1>@Title</h1>

        @*
            The owner count agrees inside the message rather than being chosen here: picking
            "an owner" or "3 owners" in C# is an English plural rule compiled into a page, and the
            languages with three or six forms have nowhere to put the rest.
        *@
        <p>@Say("claim.hasOwners", ("count", Owners.Count))</p>

        <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/start")">
            <AntiforgeryToken />
            <input type="hidden" name="intent" value="join" />
            <button type="submit">@L("claim.join.button")</button>
            <p class="faint">@L("claim.join.note")</p>
        </form>

        <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/start")">
            <AntiforgeryToken />
            <input type="hidden" name="intent" value="assume" />
            <button type="submit">@L("claim.assume.button")</button>
            <p class="faint">@Say("claim.assume.note", ("count", Owners.Count))</p>
        </form>
    </section>
}
else
{
    <section class="prose">
        <h1>@Title</h1>

        @if (Pending!.IsVerified)
        {
            @*
                What we read, and where we read it — a fact about our records rather than about the
                game. Two ids and not one sentence with the channel slotted into it: "from the
                game's MSSP report" and "from the connect screen" take different prepositions and
                different cases in the languages that have them.
            *@
            <p class="verified">
                <strong>@L("claim.verified.lead")</strong>
                @Say(
                    Pending.VerifiedVia == ClaimChannel.Mssp
                        ? "claim.verified.viaMssp"
                        : "claim.verified.viaScreen",
                    ("date", Dates.Absolute(Tag, Pending.ClaimedAt!.Value)))
            </p>
            <p>@L("claim.verified.leaveIt")</p>
            <p><a href="@HttpContext.Link("/account")">@L("claim.yourGames")</a></p>
        }
        else
        {
            <p>@L("claim.publish")</p>

            @if (Pending.Intent is ClaimIntent.Assume)
            {
                <p class="refused">
                    <strong>@L("claim.transfer.lead")</strong>
                    @Say("claim.transfer.body", ("count", Owners.Count))
                </p>
            }

            @*
                The token itself. translate="no" for the reason a hostname carries it: translating
                it would destroy the evidence rather than localize anything, and what an operator
                pastes into their config has to be these exact bytes in every language.
            *@
            <p class="token mono" translate="no">@Pending.Token</p>

            <h2>@L("claim.either.heading")</h2>

            <h3>@L("claim.mssp.heading")</h3>
            <pre class="mono">@ClaimTokenBeacon.MsspVariable @Pending.Token</pre>
            @*
                Every name in these two sentences is machine voice and is placed rather than
                translated: a codebase string, a config file name, and the variables a probe
                actually looks for. The accepted spellings come from ClaimTokenBeacon rather than
                being retyped here — two lists that must agree is one list that eventually does not.
            *@
            @*
                Each sentence sits in its own <span>. Razor drops the whitespace on a line that
                opens a code block, so a bare @foreach beside a sibling sentence renders as
                "…has an equivalent.MUINDEX_CLAIM…". Between elements the space is ordinary markup.
            *@
            <p class="faint">
                <span>
                    @foreach (var part in Sentence.Place(Tag, "claim.mssp.note", ["codebase", "file"]))
                    {
                        @if (part.Slot is "codebase")
                        {
                            <span translate="no">PennMUSH</span>
                        }
                        else if (part.Slot is "file")
                        {
                            <code translate="no">mush.cnf</code>
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                </span>
                <span>
                    @foreach (var part in Sentence.Place(Tag, "claim.mssp.aliases", ["aliases"]))
                    {
                        @if (part.Slot is "aliases")
                        {
                            for (var i = 0; i < Aliases.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <text>, </text>
                                }

                                <code translate="no">@Aliases[i]</code>
                            }
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                </span>
            </p>

            <h3>@L("claim.screen.heading")</h3>
            <pre class="mono">@ClaimTokenBeacon.ConnectScreenPrefix @Pending.Token</pre>
            <p class="faint">@L("claim.screen.note")</p>

            <h2>@L("claim.then.heading")</h2>
            <p>@Say("claim.then.body", ("date", Dates.Absolute(Tag, Pending.ExpiresAt)))</p>

            <form method="post" action="@HttpContext.Link($"/g/{Slug}/claim/check")">
                <AntiforgeryToken />
                <button type="submit" disabled="@(!CanCheck)">@L("claim.check.button")</button>
                @*
                    It moves your game to the front of the crawl queue; the crawler still does the
                    dialling, on its own schedule and under CRAWL DELAY. Saying it "dials a real
                    server" was both an overstatement and — for as long as nothing moved the
                    schedule — a description of something that did not happen at all.
                *@
                <span class="faint">@L(CanCheck ? "claim.check.can" : "claim.check.rationed")</span>
            </form>
        }
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private GameRecord? Game { get; set; }

    private ClaimService? Claims { get; set; }

    private MuiUser? User { get; set; }

    private GameClaim? Pending { get; set; }

    /// <summary>Whoever has already proved control of this game (spec §8.5).</summary>
    private IReadOnlyList<GameClaim> Owners { get; set; } = [];

    private bool CanCheck => Pending is not null && Claims!.MayRecheck(Pending);

    /// <summary>
    /// Loads the page, and mints a token if this account has none outstanding for this game.
    /// </summary>
    /// <remarks>
    /// Minting on view rather than behind a second button is deliberate: arriving here is the ask.
    /// <see cref="ClaimService.IssueAsync"/> returns an existing pending claim rather than replacing
    /// it, so a refresh does not invalidate what the operator has just finished pasting into their
    /// config — which would look exactly like the site being broken.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        // The GAME RECORD, not the public page view model, and this is load-bearing. A submitted
        // game is hidden from IGameQueries until it is claimed (migration 0010) — so looking it up
        // through the same read the listing uses made claiming the one thing a hidden game could
        // never do, and hidden-until-claimed a state with no exit. Claiming operates on the row.
        Game = Services.GetService<IGameStore>() is { } store
            ? await store.BySlugAsync(Slug)
            : null;

        Claims = Services.GetService<ClaimService>();

        if (Game is null || Claims is null)
        {
            return;
        }

        if (Services.GetService<UserManager<MuiUser>>() is { } users
            && HttpContext?.User is { Identity.IsAuthenticated: true } principal)
        {
            User = await users.GetUserAsync(principal);
        }

        if (User is null)
        {
            return;
        }

        Owners = await Claims.OwnersAsync(Game.Id);

        var mine = (await Services.GetRequiredService<IClaimStore>().ForUserAsync(User.Id))
            .Where(claim => claim.GameId == Game.Id)
            .ToList();

        Pending = mine.FirstOrDefault(claim => claim.IsVerified)
            ?? mine.FirstOrDefault(claim => claim.IsPending(Clock.GetUtcNow()));

        // Minting on view is right for a game nobody owns — arriving here IS the ask, and
        // IssueAsync returns an existing token rather than replacing one already pasted into a
        // config file. It is wrong for a game that has owners, where the ask has two meanings and
        // only the claimant knows which: that case falls through to the choice above.
        if (Pending is null && Owners.Count == 0)
        {
            Pending = await Claims.IssueAsync(Game.Id, User.Id);
        }
    }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Tag => HttpContext.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.Say(Tag, id, args);

    /// <summary>
    /// The heading, with the game's name placed by the message.
    /// </summary>
    /// <remarks>
    /// A separate id from <c>preview.title.claim</c> even though the English is identical: that one
    /// is a noun phrase in a browser tab and this is the first line of a document, and the
    /// languages that decline the two differently have nowhere to stand if they share an id.
    /// </remarks>
    private string Title => Say("claim.title", ("game", Game!.Name));

    /// <summary>
    /// The other MSSP variable names a probe accepts, as the crawler spells them.
    /// </summary>
    /// <remarks>
    /// Read from <see cref="ClaimTokenBeacon.AcceptedMsspVariables"/> rather than retyped into the
    /// markup, which is where they were: the page listed two of the three by hand, so adding a
    /// fourth spelling to the parser would have left this page quietly telling operators about a
    /// set that no longer matched. The first entry is the one printed in full above.
    /// </remarks>
    private static IReadOnlyList<string> Aliases =>
        [.. ClaimTokenBeacon.AcceptedMsspVariables.Skip(1)];
}
