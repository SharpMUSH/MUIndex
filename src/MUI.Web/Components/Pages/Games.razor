@page "/games"
@using Microsoft.AspNetCore.WebUtilities
@using MUI.Web.Api
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject NavigationManager Nav

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderListing(Listing, Filter, Now)</pre>
}
else
{
    <SitePreview Title="Games" Description="@PreviewCopy.Pages.Games" />

    <header class="listing-head">
        <h1>Games</h1>
        <p class="dim">Every fact below was measured.</p>
    </header>

    @if (Error is { } problem)
    {
        @*
            A filter we cannot read is refused rather than dropped. Listing the whole catalogue under
            a filter that did not apply would present our own parse failure as the answer to
            somebody's question — the same rule that stops an unparseable WHO reading as zero.
        *@
        <p class="problem" role="alert">@problem</p>
        <p><a href="/games">clear filters</a></p>
    }
    else
    {
        <FacetPanel Facets="Listing.Facets" Filter="Filter" Query="@Query" />

        @if (Filter.Codebase is { Exclude: false, Value: { } family })
        {
            @* The facet a reference page links in on. The panel above already shows it selected, and
               this says it again in prose with the way back out and the way back to the page that
               sent them — a reader who arrived from /reference/codebases/pennmush should not have to
               guess why the listing is short. *@
            <p class="kicker">
                codebase <span class="mono">@family</span> ·
                <a href="/reference/codebases/@(family.ToLowerInvariant())">about @family</a> ·
                <a href="/games">all games</a>
            </p>
        }

        <div class="listing-bar">
            <p class="result-count">
                <strong>@Listing.Games.Count</strong>
                <span class="dim">@(Listing.Games.Count == 1 ? "game" : "games")</span>
            </p>
            <p class="kicker listing-order">
                @* The order is stated rather than left to be inferred from the first few rows. *@
                by @FacetWords.Sort(Filter.Sort)
                @if (Listing.Games.Count > 0)
                {
                    @* Only where there is something to be random among. An affordance that cannot do
                       what it offers is worse than one that is not there. *@
                    <text> · </text><a href="@RandomHref">random</a>
                }
            </p>

            @*
                The verb, once, over the column it belongs to. Every row used to carry it — "reached
                2w ago" beside a count that already wore the same age — so the age was on the row
                twice and the word 515 times. The cells hold the bare age now; this says what it is.
            *@
            <p class="kicker reached-head" aria-hidden="true">reached</p>
        </div>

        <ul class="games">
            @foreach (var g in Listing.Games)
            {
                @*
                    Where a sort runs out of things it can rank, the list says so before it goes on.
                    Sorted by players, the counted games end and the ones we reached but could not
                    count begin — and without this break the page reads 54, 11, 2, 0, and then a long
                    tail showing no number, which looks exactly like a tail of empty games. It is a
                    real list item so it survives in the accessibility tree and in plain text.
                *@
                @if (BreakBefore(g))
                {
                    <li class="unranked-break">
                        <span class="kicker">from here</span>
                        <span>@FacetWords.Unranked(Filter.Sort)</span>
                    </li>
                }
                <li class="game-row @(g.State is LifecycleState.Archived ? "archived" : null)">
                    <div class="row-main">
                        @*
                            The game's own face where it published one, and its monogram otherwise —
                            drawn identically for a game that declared no icon and one whose web
                            server we could not reach, because only the first of those is a fact
                            about the game. It is the row's left edge either way, which is what makes
                            five hundred rows scannable by shape rather than only by reading them.
                        *@
                        <GamePlate Slug="@g.Slug" Name="@g.Name" HasIcon="g.HasIcon" />

                        <div class="row-text">
                            <p class="row-head">
                                <a class="name" href="/g/@g.Slug">@g.Name</a>
                                @*
                                    Archived and claimed are the two states worth saying. Unclaimed
                                    is the majority state of the catalogue — it was on all 515 rows,
                                    an administrative fact about our records repeated 515 times to a
                                    reader looking for a game to play, and a mark every row wears
                                    distinguishes no row from any other. It stays on the game page,
                                    where it comes with the invitation to claim, and in the API.
                                *@
                                @if (g.State is LifecycleState.Archived)
                                {
                                    <span class="badge archived">archived</span>
                                }
                                else if (g.IsClaimed)
                                {
                                    <span class="badge claimed">claimed</span>
                                }
                            </p>

                            @if (g.Tagline is { } t)
                            {
                                <p class="tagline">@t</p>
                            }

                            <p class="meta mono">
                                @*
                                    The codebase wears the same chip the game page puts on it — value,
                                    glyph, age — rather than a bare string. A row that showed
                                    "PennMUSH 1.8.5" with nothing beside it cannot tell a reader that
                                    nobody has confirmed it since 2023, and a directory that reads the
                                    same either way is the one this project exists to replace.
                                *@
                                @if (g.CodebaseProvenance is { } codebase)
                                {
                                    <Chip Fact="codebase" Now="Now" />
                                }
                                else if (g.Codebase is { } cb)
                                {
                                    <text>@cb</text>
                                }
                                else
                                {
                                    @*
                                        The commonest state in the catalogue, so it is the quietest
                                        thing on the row — the same reasoning that demoted "unclaimed"
                                        from a pill to a word. "Codebase not identified" was the
                                        longest string on the meta line and appeared on more rows than
                                        any codebase did, so the one row that <em>had</em> an
                                        identified codebase was the one that looked emptiest.

                                        Two words, and they name the field so the label stands on its
                                        own — a row is read on its own, unlike the facet panel and the
                                        plain listing, which both print "codebase" as a heading and go
                                        on saying "not identified" underneath it.

                                        The title carries the longer sentence for a reader who wants
                                        it. It is the one place on this row that says whose limit
                                        this is: an unidentified codebase is a fact about how far our
                                        parsers reach and not about the game, and the shorter label
                                        does not say so by itself.
                                    *@
                                    <span class="state-unknown"
                                          title="we could not identify the codebase this game runs">Unknown Codebase</span>
                                }
                                @*
                                    The protocols, and no dot beside each of them. Every one of these
                                    is measured — that is what puts it on the line — so six accent
                                    dots per row said one thing six times and gave the row six marks
                                    to read past. Three, then a count of the rest: a row is a hint at
                                    what a game is, and the game's page lists all of them with the
                                    handshake each came from.
                                *@
                                @foreach (var p in g.MeasuredProtocols.Take(ProtocolsShown))
                                {
                                    <text> · </text><span class="protocol">@p</span>
                                }
                                @if (g.MeasuredProtocols.Count > ProtocolsShown)
                                {
                                    var rest = g.MeasuredProtocols.Count - ProtocolsShown;
                                    <text> </text>
                                    <span class="protocol more"
                                          title="@($"and {rest} more: {string.Join(", ", g.MeasuredProtocols.Skip(ProtocolsShown))}")">
                                        +@rest
                                    </span>
                                }
                            </p>
                        </div>

                        <p class="row-figure mono">
                            @*
                                Three states, spelled rather than implied. A missing count says so in
                                words — it is never rendered as a zero, and never left blank for a
                                reader to guess at. A measured zero keeps the accent glyph every other
                                count has, because it is every bit as much a measurement.

                                This is the one fact on the row set larger than the rest, and that is
                                the whole of how "players on now" is told apart from the protocol and
                                codebase facts beside it. The glyph could not carry that difference:
                                it means measured-or-declared everywhere on this site, and giving it a
                                second meaning here would cost the first one. Scale and position are
                                free of that constraint — nothing else in a row is 17px, so the count
                                is what the eye lands on, and the vocabulary stays intact.
                            *@
                            @if (g.PlayersNow is { } n)
                            {
                                <span class="players @(n > 0 ? "live" : "empty")">
                                    @*
                                        The glyph follows the provenance, the same way the game page's
                                        does. This row shipped a hard-coded measured dot beside the
                                        declared chip below it — a green ● and a ◇ chip describing one
                                        number, which is the disagreement the chip was added to end.

                                        The chip's own glyph is off (GlyphShown) rather than this one
                                        being dropped: one fact, one glyph, and it belongs at the head
                                        of the figure where a reader scanning the column looks first.
                                    *@
                                    <span class="pip @(g.PlayersNowProvenance?.IsMeasured is false ? "state-declared" : "state-present")" aria-hidden="true">@(g.PlayersNowProvenance?.IsMeasured is false ? "◇" : "●")</span><span class="count">@n</span> <span class="unit">on</span>

                                    @*
                                        And how we know it — said in words on the rows where it is
                                        not what the page has already promised. The chip that used to
                                        sit here carried the word and the age of the same probe the
                                        freshness column dates, so every row stated one age twice and
                                        the word "measured" 515 times under a heading reading "every
                                        fact below was measured".

                                        A declared count is the exception and it is the one a reader
                                        could be misled by, so it keeps its word as well as its
                                        glyph. Rule 1 is intact: the two kinds of number are still
                                        told apart on this row, by shape, by colour and in text.
                                    *@
                                    @if (g.PlayersNowProvenance?.IsMeasured is false)
                                    {
                                        <span class="declared-note">declared</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="players unknown"><span aria-hidden="true">–</span> count unknown</span>
                            }

                            @*
                                What this order ranked the row on, where it ranked on something other
                                than a fact already printed above. A listing sorted by an average that
                                appears nowhere on its rows is one a reader has to take on trust, and
                                the sample tally rides along because a mean is a mean of something
                                (§15.7) — thirty counts and three hundred are not the same evidence
                                and the row is where that shows.
                            *@
                            @if (g.PlayersOverWindow is { } window)
                            {
                                <span class="window">@FacetWords.Window(window, Filter.Sort)</span>
                            }

                            @*
                                What the last-seen facet filters on, shown on the rows it returned, so
                                a reader can check the facet did what it said. Never reached is its own
                                sentence and is never dated from our own first sighting.
                            *@
                            <span class="seen">
                                @if (g.LastReachableAt is { } seen)
                                {
                                    @* The bare age, under the column that says what it is — and the
                                       verb for a reader who is listening rather than scanning. *@
                                    <span class="sr-only">reached </span><Moment At="seen" Now="Now" />
                                }
                                else
                                {
                                    <span class="state-unknown">never reached</span>
                                }
                            </span>
                        </p>
                    </div>
                </li>
            }
        </ul>

        @if (Listing.Games.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-head">Nothing matched.</p>
                <p class="dim">Try fewer words, or drop a filter.</p>
                <p class="kicker">
                    <a href="/games">clear filters</a> · <a href="/archive">archive</a>
                </p>
            </div>
        }
    }

    <p class="faint"><a href="@PlainHref">plain text</a></p>
}

@code {
    private DateTimeOffset Now => Clock.GetUtcNow();

    private GameFilter Filter { get; set; } = new();

    private GameListing Listing { get; set; } = GameListing.Empty;

    private string? Error { get; set; }

    /// <summary>The querystring this render is answering, exactly as the request carried it.</summary>
    private string Query => new Uri(Nav.Uri).Query;

    private bool Plain => Truthy.Is(
        QueryHelpers.ParseQuery(Query).TryGetValue("plain", out var flag) ? flag.ToString() : null);

    /// <summary>
    /// Plain mode keeps the whole question it was reading, whatever that question grows into.
    /// </summary>
    /// <remarks>
    /// Rebuilt from the live querystring rather than from a hand-kept list of parameters. That list
    /// carried <c>q</c> and <c>archived</c> and nothing else, so the day a facet arrived the plain
    /// link would have quietly dropped it and offered the unfiltered catalogue as "this page, as
    /// text" — which is the same page in neither sense.
    /// </remarks>
    private string PlainHref => ListingLinks.With(Query, "plain", "1");

    /// <summary>
    /// Random, within whatever is on screen (spec §9). The filters ride along, because "surprise me"
    /// after narrowing to Evennia games means surprise me among those.
    /// </summary>
    private string RandomHref => "/games/random" + ListingLinks.With(Query, "plain", null);

    /// <summary>
    /// The first game this sort had nothing to rank, which is where the list says so.
    /// </summary>
    /// <remarks>
    /// Held as the game rather than as an index because the loop has the game and not its position,
    /// and resolved once per render rather than per row. Null when the sort ranks everything it was
    /// given — including when it ranks nothing, which is the case where the break is the first thing
    /// on the list and is exactly as worth drawing.
    /// </remarks>
    /// <summary>
    /// How many protocol names a row prints before it counts the rest.
    /// </summary>
    /// <remarks>
    /// A game offering nine of them turned the meta line into the longest thing on the row and
    /// pushed the tagline out of it. Three is enough to tell one kind of game from another at a
    /// glance; the game's own page lists every one with the handshake it came from.
    /// </remarks>
    private const int ProtocolsShown = 3;

    private GameSummary? FirstUnranked => Listing.Games
        .FirstOrDefault(g => GameSorting.IsUnranked(g, Filter.Sort));

    private bool BreakBefore(GameSummary game) => ReferenceEquals(game, FirstUnranked);

    protected override async Task OnParametersSetAsync()
    {
        // One parser, two callers: this is the same function /api/games binds through, so a URL
        // means the same thing whichever surface reads it.
        if (!GameFilterBinding.TryRead(Query, out var query, out var error))
        {
            Error = error;
            Filter = new GameFilter();
            Listing = GameListing.Empty;
            return;
        }

        Error = null;
        Filter = query.Filter;
        Listing = await Queries.SearchAsync(Filter);
    }
}
