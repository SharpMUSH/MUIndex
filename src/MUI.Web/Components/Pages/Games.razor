@page "/games"
@using MUI.Web.Localization
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using MUI.Web.Api
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject NavigationManager Nav

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderListing(Listing, Filter, Now, Tag)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.Games(Tag)" Description="@PreviewCopy.Pages.Games(Tag)" />

    @* Card page: blocks bleed to the card's edges and pad themselves, so the header rule and the
       filter column's fill run full width — inside main's padding neither could. *@
    <div class="card-page">

    @* No count restated here; it already appears in the toolbar's "sorted by" line below. *@
    <header class="listing-head">
        <h1>@Messages.For(Tag, "games.title")</h1>
    </header>

    @if (Error is { } problem)
    {
        @* An unreadable filter is refused, not dropped: listing the whole catalogue under a filter
           that silently failed would present our parse failure as the answer to the question. *@
        <p class="problem" role="alert">@problem</p>
        <p><a href="@Http.Link("/games")">@Messages.For(Tag, "listing.clearFilters")</a></p>
    }
    else
    {
        @* Two columns: filters left, results right, filter edge running the card's full height.
           Source order is filters then listing, so a narrow screen and a screen reader agree
           with the visual layout. *@
        <div class="listing-grid">
        <FacetPanel Facets="Listing.Facets" Filter="Filter" Query="@Query" />

        <div class="listing-side">

        @if (Filter.Codebase is { Exclude: false, Value: { } family })
        {
            @* Only what the facet chip above doesn't already say: the link to the codebase's own page. *@
            <p class="kicker">
                <a href="@Http.Link($"/reference/codebases/{family.ToLowerInvariant()}")">@Messages.For(Tag, "listing.aboutCodebase", new Dictionary<string, object?> { ["codebase"] = family })</a>
            </p>
        }

        @* Toolbar: current order on the left, the order switch and column names on the right. A
           toggle group of links rather than a <select>+button, so a choice applies on click with
           no script and the address bar carries the answer. *@
        <div class="listing-bar">
            <p class="listing-order">
                @((MarkupString)Messages.For(Tag, "listing.sortedBy", new Dictionary<string, object?>
                {
                    ["order"] = $"<span class=\"order-name\">{System.Net.WebUtility.HtmlEncode(FacetWords.Sort(Tag, Filter.Sort))}</span>",
                }))
                @if (Listing.Games.Count > 0)
                {
                    @* Only where there is something to be random among. *@
                    <span class="sep" aria-hidden="true">·</span><a href="@RandomHref">@Messages.For(Tag, "listing.random")</a>
                }
            </p>

            <div class="listing-tools">
                <nav class="switch" aria-label="@Messages.For(Tag, "switch.order")">
                    @foreach (var option in SortOptions)
                    {
                        @if (option.Rule)
                        {
                            <span class="switch-rule" aria-hidden="true"></span>
                        }
                        @if (Filter.Sort == option.Sort)
                        {
                            <span class="on" aria-current="true">@option.Label</span>
                        }
                        else
                        {
                            <a href="@SortHref(option.Sort)">@option.Label</a>
                        }
                    }
                </nav>

                @* Column names said once, here, rather than repeated on every row. *@
                <p class="kicker column-head" aria-hidden="true">@Messages.For(Tag, "listing.columns")</p>
            </div>
        </div>

        @* A median is a median *of* something (§15.7): the window it's computed over is part of
           the order's name, shown only while a statistical order is in force. *@
        @if (SortWindows.Of(Filter.Sort) is not null)
        {
            <nav class="switch windows" aria-label="@Messages.For(Tag, "switch.window")">
                @foreach (var (sort, label) in WindowOptions)
                {
                    @if (Filter.Sort == sort)
                    {
                        <span class="on" aria-current="true">@label</span>
                    }
                    else
                    {
                        <a href="@SortHref(sort)">@label</a>
                    }
                }
            </nav>
        }

        <ul class="games">
            @foreach (var g in Listing.Games)
            {
                @* Marks where a sort runs out of things it can rank — e.g. counted games end and
                   uncountable ones begin — so an unbroken run of blanks doesn't read as a tail of
                   empty games. A real list item, so it survives in the a11y tree and plain text. *@
                @if (BreakBefore(g))
                {
                    <li class="unranked-break">
                        <span class="kicker">@Messages.For(Tag, "listing.fromHere")</span>
                        <span>@FacetWords.Unranked(Tag, Filter.Sort)</span>
                    </li>
                }
                <li class="game-row @(g.State is LifecycleState.Archived ? "archived" : null)">
                    @* Three zones — identity · measurement · freshness — with metadata spanning
                       underneath. No plate/icon on a row: that lives on the game page (GamePlate). *@
                    <div class="row-main">
                        <div class="row-text">
                            <p class="row-head">
                                <a class="name" href="@Http.Link($"/g/{g.Slug}")"><GameName Name="@g.Name" /></a>
                                @* Archived and claimed are the two states worth marking here.
                                   Unclaimed is the majority state, so marking it on every row would
                                   distinguish nothing; it stays on the game page and in the API. *@
                                @if (g.State is LifecycleState.Archived)
                                {
                                    <span class="badge archived">archived</span>
                                }
                                else if (g.IsClaimed)
                                {
                                    @* Ring with a tick, no visible word — the label reaches a
                                       screen reader and tooltip via aria-label/title instead. *@
                                    <span class="claim-ring" role="img"
                                          aria-label="@Messages.For(Tag, "listing.claimed")"
                                          title="@Messages.For(Tag, "listing.claimed")">✓</span>
                                }
                            </p>

                            <p class="meta mono" translate="no">
                                @* Same provenance chip the game page uses (value, glyph, age) rather
                                   than a bare string, so staleness is visible here too. *@
                                @if (g.CodebaseProvenance is { } codebase)
                                {
                                    @* No age on the chip: the row's own freshness column dates the
                                       same probe, and printing it here made every row say one age
                                       twice. *@
                                    <Chip Fact="codebase" Now="Now" AgeShown="false" />
                                }
                                else if (g.Codebase is { } cb)
                                {
                                    <text>@cb</text>
                                }
                                else
                                {
                                    @* An unidentified codebase is a fact about how far our parsers
                                       reach, not about the game — the title attribute says so; the
                                       short label alone would not (rule 5). *@
                                    <span class="state-unknown"
                                          title="@Messages.For(Tag, "listing.unknownCodebase.title")">@Messages.For(Tag, "listing.unknownCodebase")</span>
                                }
                                @* All measured; shown as three then a "+N more" rather than a dot
                                   per protocol. Full list with handshake provenance is on the game page. *@
                                @foreach (var p in g.MeasuredProtocols.Take(ProtocolsShown))
                                {
                                    <text> · </text><span class="protocol">@p</span>
                                }
                                @if (g.MeasuredProtocols.Count > ProtocolsShown)
                                {
                                    var rest = g.MeasuredProtocols.Count - ProtocolsShown;
                                    <text> </text>
                                    @* Protocol names inside are machine voice and pass through
                                       untranslated; the "and … more" wrapper is ours. *@
                                    <span class="protocol more"
                                          title="@Messages.For(Tag, "listing.moreProtocols", new Dictionary<string, object?>(StringComparer.Ordinal)
                                          {
                                              ["count"] = rest,
                                              ["names"] = string.Join(", ", g.MeasuredProtocols.Skip(ProtocolsShown)),
                                          })">
                                        +@rest
                                    </span>
                                }
                                @* A median is a median *of* something (§15.7): the span and sample
                                   tally ride along with the statistic. *@
                                @if (g.PlayersOverWindow is { } window && SortWindows.Of(Filter.Sort) is not null)
                                {
                                    <text> · </text><span class="window">@Sampled(window)</span>
                                }
                            </p>
                        </div>

                        @* Three states, spelled rather than implied: a missing count says so in
                           words, never rendered as zero and never left blank (rules 2/4). No
                           provenance glyph or unit per row — those live on the game page and the
                           column head, so 500 rows don't repeat one string 500 times. *@
                        @* The column head above is aria-hidden, so a screen reader needs a label
                           in the row itself to say which bare number is the count. *@
                        @* The trailing space is an entity because Razor collapses a literal one,
                           and without it the row is announced as "connected219". *@
                        <p class="row-count mono @CountState(g)">
                            <span class="sr-only">@Messages.For(Tag, "listing.row.connected")&#160;</span>@CountText(g)
                        </p>

                        @* This week's median against last week's — its own cell, never folded into
                           row-count, which stays a bare figure or the words for none. Absent, not a
                           steady drawn from nothing, below the sample floor either week (rule 4). *@
                        @if (g.Growth is { } growth)
                        {
                            <p class="row-trend @TrendState(growth)">
                                <span role="img" aria-label="@FacetWords.TrendingWord(Tag, growth)"
                                      title="@FacetWords.TrendingWord(Tag, growth)">@TrendGlyph(growth)</span>
                            </p>
                        }

                        @* Never-reached is its own sentence, never dated from our first sighting.
                           The column reads whichever date the active sort ranks on — reached by
                           default, first-seen while sorting by discovery — rather than showing
                           reached even when the row order says something else. *@
                        <p class="row-seen mono">
                            @if (Filter.Sort == GameSort.Discovered)
                            {
                                <span class="sr-only">@Messages.For(Tag, "listing.row.discovered")&#160;</span>
                                @if (g.FirstSeenAt is { } discovered)
                                {
                                    <Moment At="discovered" Now="Now" />
                                }
                                else
                                {
                                    <span class="state-unknown">@Messages.For(Tag, "listing.never")</span>
                                }
                            }
                            else
                            {
                                <span class="sr-only">@Messages.For(Tag, "listing.row.reached")&#160;</span>
                                @if (g.LastReachableAt is { } seen)
                                {
                                    <Moment At="seen" Now="Now" />
                                }
                                else
                                {
                                    <span class="state-unknown">@Messages.For(Tag, "listing.never")</span>
                                }
                            }
                        </p>
                    </div>
                </li>
            }
        </ul>

        @if (Listing.Games.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-head">@Messages.For(Tag, "listing.empty.head")</p>
                <p class="dim">@Messages.For(Tag, "listing.empty.hint")</p>
                <p class="kicker">
                    <a href="@Http.Link("/games")">@Messages.For(Tag, "listing.clearFilters")</a> · <a href="@Http.Link("/archive")">@Messages.For(Tag, "footer.archive")</a>
                </p>
            </div>
        }

        </div>
        </div>
    }

    </div>
}

@code {
    private DateTimeOffset Now => Clock.GetUtcNow();

    private GameFilter Filter { get; set; } = new();

    private GameListing Listing { get; set; } = GameListing.Empty;

    private string? Error { get; set; }

    /// <summary>The querystring this render is answering, exactly as the request carried it.</summary>
    private string Query => new Uri(Nav.Uri).Query;

    private bool Plain => Truthy.Is(
        QueryHelpers.ParseQuery(Query).TryGetValue("plain", out var flag) ? flag.ToString() : null);

    /// <summary>Random, within whatever is on screen (spec §9) — filters ride along.</summary>
    private string RandomHref => Http.Link("/games/random" + ListingLinks.With(Query, "plain", null));

    /// <summary>The first game this sort had nothing to rank, where the list says so.</summary>
    /// <remarks>Held as the game rather than an index, since the loop has the game, not its position.</remarks>
    /// <summary>How many protocol names a row prints before it counts the rest.</summary>
    private const int ProtocolsShown = 3;

    private GameSummary? FirstUnranked => Listing.Games
        .FirstOrDefault(g => GameSorting.IsUnranked(g, Filter.Sort));

    private bool BreakBefore(GameSummary game) => ReferenceEquals(game, FirstUnranked);

    /// <summary>One option on the order switch: what it says, and whether a rule precedes it.</summary>
    private sealed record SortOption(GameSort Sort, string Label, bool Rule = false);

    /// <summary>The order switch, as the handoff draws it plus the two orders it never had to draw.</summary>
    /// <remarks>
    /// The switch chooses which measurement the count column shows (now / median / peak), not just
    /// row order. <c>name</c> and <c>reached</c> follow a rule because they're a different kind of
    /// order — a spelling and a date rather than a count — kept from the old control though absent
    /// from the mockup.
    /// </remarks>
    private SortOption[] SortOptions =>
    [
        new(GameSort.Players, Messages.For(Tag, "switch.now")),
        new(GameSort.MedianWeek, Messages.For(Tag, "switch.typical")),
        new(GameSort.PeakWeek, Messages.For(Tag, "switch.peak")),
        new(GameSort.Name, Messages.For(Tag, "switch.name"), Rule: true),
        new(GameSort.Reached, Messages.For(Tag, "switch.reached")),
        new(GameSort.Discovered, Messages.For(Tag, "switch.discovered")),
    ];

    /// <summary>
    /// The three spans, spelled for whichever statistic is in force.
    /// </summary>
    /// <remarks>
    /// Derived from the sort rather than listed twice, so a median and a peak cannot drift into
    /// offering different windows.
    /// </remarks>
    private IEnumerable<(GameSort Sort, string Label)> WindowOptions =>
        SortWindows.IsMedian(Filter.Sort)
            ? [(GameSort.MedianWeek, Messages.For(Tag, "window.7")), (GameSort.MedianMonth, Messages.For(Tag, "window.30")), (GameSort.MedianQuarter, Messages.For(Tag, "window.90"))]
            : [(GameSort.PeakWeek, Messages.For(Tag, "window.7")), (GameSort.PeakMonth, Messages.For(Tag, "window.30")), (GameSort.PeakQuarter, Messages.For(Tag, "window.90"))];

    /// <summary>This listing in one other order, keeping every other thing it was asked.</summary>
    private string SortHref(GameSort sort) =>
        Http.Link("/games" + ListingLinks.With(Query, FacetKeys.Sort, FacetTokens.Of(sort)));

    /// <summary>What goes in the count column, whichever measurement the switch is showing.</summary>
    /// <remarks>
    /// Never a zero standing in for an unknown: an unreadable count says so in words. That word is
    /// deliberately generic — a null here can mean an unreadable count, an unmeasured window, or no
    /// rows at all, and naming a specific cause would record our crawl schedule as a fact about the
    /// game (rule 5).
    /// </remarks>
    private string CountText(GameSummary game)
    {
        if (SortWindows.Of(Filter.Sort) is not null)
        {
            return game.PlayersOverWindow is { } window
                ? (SortWindows.IsMedian(Filter.Sort) ? window.Median : window.Peak)
                    .ToString(CultureInfo.InvariantCulture)
                : Messages.For(Tag, "listing.count.none");
        }

        return game.PlayersNow is { } now
            ? now.ToString(CultureInfo.InvariantCulture)
            : Messages.For(Tag, "listing.count.none");
    }

    /// <summary>
    /// The count's register: accent where somebody is on, plain for a measured zero, faint for a
    /// number we do not have.
    /// </summary>
    /// <remarks>
    /// A measured zero is dimmed rather than accented and is never faint: we got in and nobody was
    /// there is a measurement, and it is not the same fact as a count we could not read.
    /// </remarks>
    private string CountState(GameSummary game)
    {
        var value = SortWindows.Of(Filter.Sort) is not null
            ? game.PlayersOverWindow is { } w ? (SortWindows.IsMedian(Filter.Sort) ? w.Median : w.Peak) : (int?)null
            : game.PlayersNow;

        return value switch
        {
            null => "unknown",
            0 => "empty",
            _ => "live",
        };
    }

    /// <summary>The span and the sample tally behind a statistic, in the row's own machine voice.</summary>
    private static string Sampled(PresenceWindow window) =>
        $"{window.Window.TotalDays:0}d · {window.Samples} count{(window.Samples == 1 ? string.Empty : "s")}";

    /// <summary>
    /// The growth arrow's shape. A triangle rather than an ASCII arrow, so it reads at the row's own
    /// small size without anti-aliasing into a smudge the way ↑/↓ can at 13px.
    /// </summary>
    private static string TrendGlyph(GrowthDirection direction) => direction switch
    {
        GrowthDirection.Up => "▲",
        GrowthDirection.Down => "▼",
        _ => "●",
    };

    private static string TrendState(GrowthDirection direction) => direction switch
    {
        GrowthDirection.Up => "up",
        GrowthDirection.Down => "down",
        _ => "steady",
    };

    protected override async Task OnParametersSetAsync()
    {
        // One parser, two callers: this is the same function /api/games binds through, so a URL
        // means the same thing whichever surface reads it.
        if (!GameFilterBinding.TryRead(Query, out var query, out var error))
        {
            Error = error;
            Filter = new GameFilter();
            Listing = GameListing.Empty;
            return;
        }

        Error = null;
        Filter = query.Filter;
        Listing = await Queries.SearchAsync(Filter);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;
}
