@page "/games"
@using Microsoft.AspNetCore.WebUtilities
@using MUI.Web.Api
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject NavigationManager Nav

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderListing(Listing, Filter, Now)</pre>
}
else
{
    <PageTitle>Games — mu*index</PageTitle>

    <header class="listing-head">
        <h1>Games</h1>
        <p class="dim">Every fact below was measured. Nothing here was typed into a form by us.</p>
    </header>

    @if (Error is { } problem)
    {
        @*
            A filter we cannot read is refused rather than dropped. Listing the whole catalogue under
            a filter that did not apply would present our own parse failure as the answer to
            somebody's question — the same rule that stops an unparseable WHO reading as zero.
        *@
        <p class="problem" role="alert">@problem</p>
        <p><a href="/games">start again with no filter</a></p>
    }
    else
    {
        <FacetPanel Facets="Listing.Facets" Filter="Filter" Query="@Query" />

        @if (Filter.CodebaseFamily is { Exclude: false, Value: { } family })
        {
            @* The filter a reference page links in on. It is a filter and not a search, so it says
               which family it is showing and offers the way back out — a reader who arrived from
               /reference/codebases/pennmush should not have to guess why the listing is short. *@
            <p class="kicker">
                codebase <span class="mono">@family</span> ·
                <a href="/reference/codebases/@(family.ToLowerInvariant())">what this codebase is</a> ·
                <a href="/games">every game</a>
            </p>
        }

        <div class="listing-bar">
            <p class="result-count">
                <strong>@Listing.Games.Count</strong>
                <span class="dim">@(Listing.Games.Count == 1 ? "game" : "games")</span>
            </p>
            <p class="kicker listing-order">
                @* The order is stated rather than left to be inferred from the first few rows. *@
                by @FacetWords.Sort(Filter.Sort) · counts measured, never asserted
                @if (Listing.Games.Count > 0)
                {
                    @* Only where there is something to be random among. An affordance that cannot do
                       what it offers is worse than one that is not there. *@
                    <text> · </text><a href="@RandomHref">show me a random one</a>
                }
            </p>
        </div>

        <ul class="games">
            @foreach (var g in Listing.Games)
            {
                @*
                    Where a sort runs out of things it can rank, the list says so before it goes on.
                    Sorted by players, the counted games end and the ones we reached but could not
                    count begin — and without this break the page reads 54, 11, 2, 0, and then a long
                    tail showing no number, which looks exactly like a tail of empty games. It is a
                    real list item so it survives in the accessibility tree and in plain text.
                *@
                @if (BreakBefore(g))
                {
                    <li class="unranked-break">
                        <span class="kicker">from here</span>
                        <span>@FacetWords.Unranked(Filter.Sort)</span>
                    </li>
                }
                <li class="game-row @(g.State is LifecycleState.Archived ? "archived" : null)">
                    <div class="row-main">
                        <div class="row-text">
                            <p class="row-head">
                                <a class="name" href="/g/@g.Slug">@g.Name</a>
                                @*
                                    Archived and claimed are the two states worth a pill. Unclaimed is
                                    the majority state of the catalogue and is drawn as the quiet word
                                    it is — pilled on every row it was chrome, and a badge every game
                                    wears is a badge that distinguishes none of them. The word itself
                                    stays, on every row and in plain text, because "nobody has claimed
                                    this" is a fact about the entry.
                                *@
                                @if (g.State is LifecycleState.Archived)
                                {
                                    <span class="badge archived">archived</span>
                                }
                                else if (g.IsClaimed)
                                {
                                    <span class="badge claimed">claimed</span>
                                }
                                else
                                {
                                    <span class="unclaimed">unclaimed</span>
                                }
                            </p>

                            @if (g.Tagline is { } t)
                            {
                                <p class="tagline">@t</p>
                            }

                            <p class="meta mono">
                                @*
                                    The codebase wears the same chip the game page puts on it — value,
                                    glyph, age — rather than a bare string. A row that showed
                                    "PennMUSH 1.8.5" with nothing beside it cannot tell a reader that
                                    nobody has confirmed it since 2023, and a directory that reads the
                                    same either way is the one this project exists to replace.
                                *@
                                @if (g.CodebaseProvenance is { } codebase)
                                {
                                    <Chip Fact="codebase" Now="Now" />
                                }
                                else if (g.Codebase is { } cb)
                                {
                                    <text>@cb</text>
                                }
                                else
                                {
                                    <span class="state-unknown">codebase not identified</span>
                                }
                                @foreach (var p in g.MeasuredProtocols)
                                {
                                    <text> · </text><span class="protocol">@p <span class="state-present" aria-hidden="true">●</span></span>
                                }
                            </p>
                        </div>

                        <p class="row-figure mono">
                            @*
                                Three states, spelled rather than implied. A missing count says so in
                                words — it is never rendered as a zero, and never left blank for a
                                reader to guess at. A measured zero keeps the accent glyph every other
                                count has, because it is every bit as much a measurement.
                            *@
                            @if (g.PlayersNow is { } n)
                            {
                                <span class="players">
                                    @*
                                        The glyph follows the provenance, the same way the game page's
                                        does. This row shipped a hard-coded measured dot beside the
                                        declared chip below it — a green ● and a ◇ chip describing one
                                        number, which is the disagreement the chip was added to end.
                                    *@
                                    <span class="@(g.PlayersNowProvenance?.IsMeasured is false ? "state-declared" : "state-present")" aria-hidden="true">@(g.PlayersNowProvenance?.IsMeasured is false ? "◇" : "●")</span> @n <span class="unit">on</span>

                                    @*
                                        And how we know it. A number somebody read out of a WHO nine
                                        minutes ago and a number a game asserts about itself are
                                        different facts, and this row said the same thing for both.
                                        The glyph and the age are the difference, in the vocabulary
                                        the game page already uses — and the word is spelled out for
                                        a screen reader, because a glyph is not a fact.
                                    *@
                                    @if (g.PlayersNowProvenance is { } counted)
                                    {
                                        <Chip Fact="counted" Now="Now" ValueShown="false" />
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="players unknown"><span aria-hidden="true">–</span> count unknown</span>
                            }

                            @*
                                What the last-seen facet filters on, shown on the rows it returned, so
                                a reader can check the facet did what it said. Never reached is its own
                                sentence and is never dated from our own first sighting.
                            *@
                            <span class="seen">
                                @if (g.LastReachableAt is { } seen)
                                {
                                    <text>reached @Relative.Ago(Now - seen)</text>
                                }
                                else
                                {
                                    <span class="state-unknown">never reached</span>
                                }
                            </span>
                        </p>
                    </div>
                </li>
            }
        </ul>

        @if (Listing.Games.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-head">Nothing matched.</p>
                <p class="dim">
                    Nothing is ever deleted here, so a name that once worked still does. Try fewer
                    words, or drop a filter.
                </p>
                <p class="kicker">
                    <a href="/games">clear every filter</a> · <a href="/archive">look in the archive</a>
                </p>
            </div>
        }
    }

    <p class="faint"><a href="@PlainHref">read this page as plain text</a></p>
}

@code {
    private DateTimeOffset Now => Clock.GetUtcNow();

    private GameFilter Filter { get; set; } = new();

    private GameListing Listing { get; set; } = GameListing.Empty;

    private string? Error { get; set; }

    /// <summary>The querystring this render is answering, exactly as the request carried it.</summary>
    private string Query => new Uri(Nav.Uri).Query;

    private bool Plain => Truthy.Is(
        QueryHelpers.ParseQuery(Query).TryGetValue("plain", out var flag) ? flag.ToString() : null);

    /// <summary>
    /// Plain mode keeps the whole question it was reading, whatever that question grows into.
    /// </summary>
    /// <remarks>
    /// Rebuilt from the live querystring rather than from a hand-kept list of parameters. That list
    /// carried <c>q</c> and <c>archived</c> and nothing else, so the day a facet arrived the plain
    /// link would have quietly dropped it and offered the unfiltered catalogue as "this page, as
    /// text" — which is the same page in neither sense.
    /// </remarks>
    private string PlainHref => ListingLinks.With(Query, "plain", "1");

    /// <summary>
    /// Random, within whatever is on screen (spec §9). The filters ride along, because "surprise me"
    /// after narrowing to Evennia games means surprise me among those.
    /// </summary>
    private string RandomHref => "/games/random" + ListingLinks.With(Query, "plain", null);

    /// <summary>
    /// The first game this sort had nothing to rank, which is where the list says so.
    /// </summary>
    /// <remarks>
    /// Held as the game rather than as an index because the loop has the game and not its position,
    /// and resolved once per render rather than per row. Null when the sort ranks everything it was
    /// given — including when it ranks nothing, which is the case where the break is the first thing
    /// on the list and is exactly as worth drawing.
    /// </remarks>
    private GameSummary? FirstUnranked => Listing.Games
        .FirstOrDefault(g => GameSorting.IsUnranked(g, Filter.Sort));

    private bool BreakBefore(GameSummary game) => ReferenceEquals(game, FirstUnranked);

    protected override async Task OnParametersSetAsync()
    {
        // One parser, two callers: this is the same function /api/games binds through, so a URL
        // means the same thing whichever surface reads it.
        if (!GameFilterBinding.TryRead(Query, out var query, out var error))
        {
            Error = error;
            Filter = new GameFilter();
            Listing = GameListing.Empty;
            return;
        }

        Error = null;
        Filter = query.Filter;
        Listing = await Queries.SearchAsync(Filter);
    }
}
