@page "/games"
@using MUI.Web.Api
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject NavigationManager Nav

<GamesView Listing="Listing" Filter="Filter" Query="@Query" Error="@Error" Now="Clock.GetUtcNow()" />

@code {
    private GameListing Listing { get; set; } = GameListing.Empty;
    private GameFilter Filter { get; set; } = new();
    private string? Error { get; set; }
    private string Query => new Uri(Nav.Uri).Query;
    [CascadingParameter] private HttpContext? Http { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!GameFilterBinding.TryRead(Query, out var query, out var error))
        {
            Error = error;
            Filter = new GameFilter();
            Listing = GameListing.Empty;
            return;
        }

        Error = null;
        Filter = query.Filter;
        Listing = await Queries.SearchAsync(Filter, Http?.RequestAborted ?? default);
    }
}
