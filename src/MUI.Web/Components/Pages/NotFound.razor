@page "/not-found"
@layout MUI.Web.Components.Layout.MainLayout
@using MUI.Web.Localization

@*
    The site's one not-found page. It's a routable page rather than the <Router>'s <NotFound>
    fragment because that fragment renders nothing under static server rendering, producing an
    empty 404. The layout is named explicitly since this page is also rendered when nothing routed
    at all, so DefaultLayout wouldn't otherwise apply.

    A slug a game used to have never reaches here — redirected before the route is matched (spec
    §5.7). Arriving here means no game ever answered to this URL.
*@

<SitePreview Title="@PreviewCopy.Titles.NotFound(Tag)" Description="@PreviewCopy.Pages.NotFound(Tag)"
             Data="false" />

@* Reuses the game page's own not-found message ids instead of duplicating the copy here. *@
<h1>@Messages.For(Tag, "game.notFound")</h1>
<p class="dim">@Messages.For(Tag, "game.notFound.hint")</p>
<p class="faint"><a href="@Http.Link("/games")">@Messages.For(Tag, "nav.games")</a></p>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;
}
