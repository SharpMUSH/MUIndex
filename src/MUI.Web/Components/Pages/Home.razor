@page "/"
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject ICrawlerPulse Crawler
@inject TimeProvider Clock

@*
    The feeds are the front page, not a sidebar: a front page that says what changed in the hobby
    this week is a record, not a list. Search sits above them because "find one specific game" is
    the second-most-common visit.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderHome(Http.LocaleOf().Tag, Counts, Feeds, Pulse, Now)</pre>
}
else
{
    <SitePreview Description="@PreviewCopy.Site(Http.LocaleOf().Tag)" />

    @* One column, one rhythm: blocks are spaced by the column's own gap rather than a margin on
       each, because a margin on a block that renders nothing (the crawler strip with no pulse)
       leaves its space behind — this page had an 82px dead band there for exactly that reason. *@
    <div class="page-flow">

    <section class="hero">
        @* The heading says what the site is, not what it's called — an h1 reading "mu*index" told
           a first-time reader nothing and duplicated the wordmark down the left edge. *@
        <div class="hero-head">
            <h1>@L("home.title")</h1>
            <p class="lede">@L("home.lede")</p>
        </div>

        @* One field, glyph inside it rather than a second control beside it. The button stays: a
           reader using a switch or pointer can't reach a control that exists only as a keystroke. *@
        <form class="search" method="get" action="@Http.Link("/games")" role="search">
            <label for="q" class="sr-only">@L("home.search.label")</label>
            <span class="search-field">
                <span class="search-glyph mono" aria-hidden="true">⌕</span>
                <input id="q" type="search" name="q"
                       placeholder="@L("home.search.placeholder")" />
            </span>
            <button type="submit">@L("home.search.submit")</button>
        </form>

        @*
            Four tiles: a label and a value, no sub-label. There is no "reachable this week" tile
            because the store can't answer it, and an estimate here would undo the argument.

            All four figures are counts of games, not of players — "populated" means "this many
            games have someone connected right now" (a connection, not a headcount: one player
            with two clients is two connections, and a bot is a connection). "Unknown population"
            is not "answering, but no count" — PlayersNow is also null for a game we simply
            couldn't reach just now, so the tile covers both.
        *@
        <ul class="tiles">
            <li>
                <span class="kicker">@L("tile.gamesKnown")</span>
                <span class="figure mono">@Counts.Known</span>
            </li>
            <li>
                <span class="kicker">@L("tile.connectedNow")</span>
                <span class="figure mono state-present">@Counts.WithPlayersOn</span>
            </li>
            <li>
                <span class="kicker">@L("tile.answeringUncounted")</span>
                <span class="figure mono">@Counts.CountUnknown</span>
            </li>
            <li>
                <a href="@Http.Link("/archive")"><span class="kicker">@L("tile.archived")</span>
                <span class="figure mono">@Counts.Archived</span></a>
            </li>
        </ul>

        @* Under the counts on purpose: it's the provenance of the four numbers above it. *@
        <CrawlerStrip Pulse="Pulse" Now="Now" />
    </section>

    @* Three registers, three colours: accent means measured (discovery and return), amber means
       least-sure (went dark). The heading carries the colour; the rows below don't. *@
    <div class="feeds">
        <section class="feed feed-lit" aria-labelledby="feed-new">
            <h2 id="feed-new" class="kicker">@L("feed.newlyDiscovered")</h2>
            @if (Feeds.NewlyDiscovered.Count == 0)
            {
                <p class="faint">@L("feed.nothingNew")</p>
            }
            @foreach (var entry in Feeds.NewlyDiscovered)
            {
                <FeedCard Entry="entry" Kind="FeedKind.NewlyDiscovered" Now="Now" ShowRegister="false" />
            }
        </section>

        <section class="feed feed-dark" aria-labelledby="feed-dark">
            @* "Still probed" belongs here once, not under every row — nothing is ever deleted (§7.5). *@
            <h2 id="feed-dark" class="kicker">@L("feed.wentDark")</h2>
            @if (Feeds.WentDark.Count == 0)
            {
                <p class="faint">@L("feed.nothingDark")</p>
            }
            @foreach (var entry in Feeds.WentDark)
            {
                <FeedCard Entry="entry" Kind="FeedKind.WentDark" Now="Now" ShowRegister="false" />
            }
        </section>

        <section class="feed feed-lit" aria-labelledby="feed-back">
            <h2 id="feed-back" class="kicker">@L("feed.cameBack")</h2>
            @if (Feeds.CameBack.Count == 0)
            {
                <p class="faint">@L("feed.nothingBack")</p>
            }
            @foreach (var entry in Feeds.CameBack)
            {
                <FeedCard Entry="entry" Kind="FeedKind.CameBack" Now="Now" ShowRegister="false" />
            }
        </section>
    </div>

    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private SiteCounts Counts = new(0, 0, 0, 0);
    private LivenessFeeds Feeds = new([], [], []);
    private CrawlerPulse Pulse = CrawlerPulse.Unknown;

    protected override async Task OnParametersSetAsync()
    {
        // Archived games are still known, still probed and still addressable, so "games known"
        // counts them.
        Counts = SiteCounts.From(await Queries.ListAsync(new GameFilter { IncludeArchived = true }));
        Feeds = await Queries.FeedsAsync();

        // Cannot throw: StoredCrawlerPulse answers Unknown for a missing table or failed query
        // alike, so the strip going quiet never costs a reader the front page.
        Pulse = await Crawler.ReadAsync(Now);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string L(string id) => Messages.For(Http.LocaleOf().Tag, id);
}
