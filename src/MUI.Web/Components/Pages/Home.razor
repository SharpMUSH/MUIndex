@page "/"
@inject IGameQueries Queries
@inject ICrawlerPulse Crawler
@inject TimeProvider Clock

@*
    The feeds are the front page, not a sidebar.

    A directory whose front page is a list of games is a list; a front page that says what changed in
    the hobby this week is a record. Search sits above them because the second-most-common visit is
    "find one specific game".
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderHome(Counts, Feeds, Pulse, Now)</pre>
}
else
{
    <SitePreview Description="@PreviewCopy.Site" />

    <section class="hero">
        @*
            The heading says what the site is rather than what it is called. An h1 reading
            "mu*index" printed the wordmark twice down the left edge and told a first-time reader
            nothing, so it was hidden — but a hidden h1 is a page whose first visible words are a
            search placeholder. This is the sentence the meta description already carried, and it is
            the one thing a stranger needs before they read a count.
        *@
        <h1>A directory of the MU* hobby</h1>
        <p class="lede">Every fact was measured by a crawler that connected to the game.</p>

        <form class="search" method="get" action="/games" role="search">
            <label for="q" class="sr-only">Search games by name, theme, codebase or host</label>
            <input id="q" type="search" name="q" placeholder="search @Counts.Known games" />
            <button type="submit">search</button>
        </form>

        @*
            Four tiles: a label and a value, and no sub-label under either. They were one mono line
            of "9 games known · 5 with players on now · …", which is a sentence pretending to be a
            dashboard — the numbers are the front page's whole claim and they were set at the size
            of the metadata beside them.

            No sub-labels: "games with a count" under "with players on" is a gloss on a label that
            should carry its own meaning, so the label carries it. There is no "reachable this week"
            tile because the store cannot answer it, and an estimate here would undo the argument.
        *@
        <ul class="tiles">
            <li>
                <span class="kicker">games known</span>
                <span class="figure mono">@Counts.Known</span>
            </li>
            <li>
                <span class="kicker">with players on</span>
                <span class="figure mono state-present">@Counts.WithPlayersOn</span>
            </li>
            <li>
                <span class="kicker">answering, not counted</span>
                <span class="figure mono">@Counts.CountUnknown</span>
            </li>
            <li>
                <a href="/archive"><span class="kicker">archived</span>
                <span class="figure mono">@Counts.Archived</span></a>
            </li>
        </ul>

        @* Under the counts on purpose. Every figure above it is only as current as the loop this
           line describes, so it reads as the provenance of the four numbers it sits beneath. *@
        <CrawlerStrip Pulse="Pulse" Now="Now" />
    </section>

    <div class="feeds">
        <section aria-labelledby="feed-new">
            <h2 id="feed-new" class="kicker">newly discovered</h2>
            @if (Feeds.NewlyDiscovered.Count == 0)
            {
                <p class="faint">Nothing new.</p>
            }
            @foreach (var entry in Feeds.NewlyDiscovered)
            {
                <FeedCard Entry="entry" Kind="FeedKind.NewlyDiscovered" Now="Now" ShowRegister="false" />
            }
        </section>

        <section aria-labelledby="feed-dark">
            @* "Still probed" belongs here, once, rather than under every row as "we keep knocking".
               Nothing is ever deleted (§7.5) and this is where that promise is made. *@
            <h2 id="feed-dark" class="kicker">went dark — still probed</h2>
            @if (Feeds.WentDark.Count == 0)
            {
                <p class="faint">Nothing went dark.</p>
            }
            @foreach (var entry in Feeds.WentDark)
            {
                <FeedCard Entry="entry" Kind="FeedKind.WentDark" Now="Now" ShowRegister="false" />
            }
        </section>

        <section aria-labelledby="feed-back">
            <h2 id="feed-back" class="kicker">came back</h2>
            @if (Feeds.CameBack.Count == 0)
            {
                <p class="faint">Nothing came back. We keep knocking.</p>
            }
            @foreach (var entry in Feeds.CameBack)
            {
                <FeedCard Entry="entry" Kind="FeedKind.CameBack" Now="Now" ShowRegister="false" />
            }
        </section>
    </div>

    <p class="faint">
        <a href="/games">all games</a> ·
        <a href="/archive">archive</a> ·
        <a href="/submit">submit a game</a> ·
        <a href="?plain=1">plain text</a>
    </p>
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private SiteCounts Counts = new(0, 0, 0, 0);
    private LivenessFeeds Feeds = new([], [], []);
    private CrawlerPulse Pulse = CrawlerPulse.Unknown;

    protected override async Task OnParametersSetAsync()
    {
        // Archived games are out of the default listing and of nothing else, so the front page's
        // "games known" counts them: they are still known, still probed and still addressable.
        Counts = SiteCounts.From(await Queries.ListAsync(new GameFilter { IncludeArchived = true }));
        Feeds = await Queries.FeedsAsync();

        // Its own read, and it cannot throw: StoredCrawlerPulse answers Unknown for a missing table
        // or a failed query alike, so the strip going quiet never costs a reader the front page.
        Pulse = await Crawler.ReadAsync(Now);
    }
}
