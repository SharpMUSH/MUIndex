@page "/"
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject ICrawlerPulse Crawler
@inject TimeProvider Clock

@*
    The feeds are the front page, not a sidebar.

    A directory whose front page is a list of games is a list; a front page that says what changed in
    the hobby this week is a record. Search sits above them because the second-most-common visit is
    "find one specific game".
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderHome(Http.LocaleOf().Tag, Counts, Feeds, Pulse, Now)</pre>
}
else
{
    <SitePreview Description="@PreviewCopy.Site(Http.LocaleOf().Tag)" />

    @*
        One column, one rhythm. The blocks are spaced by the column's own gap rather than by a
        margin on each of them, because a margin on a block that renders nothing — the crawler strip
        on a deployment with no pulse — leaves its space behind. This page had an 82px dead band
        there for exactly that reason.
    *@
    <div class="page-flow">

    <section class="hero">
        @*
            The heading says what the site is rather than what it is called. An h1 reading
            "mu*index" printed the wordmark twice down the left edge and told a first-time reader
            nothing, so it was hidden — but a hidden h1 is a page whose first visible words are a
            search placeholder. This is the sentence the meta description already carried, and it is
            the one thing a stranger needs before they read a count.
        *@
        <div class="hero-head">
            <h1>@L("home.title")</h1>
            <p class="lede">@L("home.lede")</p>
        </div>

        @*
            One field, with the glyph inside it rather than a second control beside it. The button
            stays: this form's only other way to submit is the return key, and a control that exists
            only as a keystroke is one a reader using a switch or a pointer cannot reach.
        *@
        <form class="search" method="get" action="/games" role="search">
            <label for="q" class="sr-only">@L("home.search.label")</label>
            <span class="search-field">
                <span class="search-glyph mono" aria-hidden="true">⌕</span>
                <input id="q" type="search" name="q"
                       placeholder="@L("home.search.placeholder")" />
            </span>
            <button type="submit">@L("home.search.submit")</button>
        </form>

        @*
            Four tiles: a label and a value, and no sub-label under either. They were one mono line
            of "9 games known · 5 with players on now · …", which is a sentence pretending to be a
            dashboard — the numbers are the front page's whole claim and they were set at the size
            of the metadata beside them.

            No sub-labels: "games with a count" under "connected now" is a gloss on a label that
            should carry its own meaning, so the label carries it. There is no "reachable this week"
            tile because the store cannot answer it, and an estimate here would undo the argument.

            "Connected now" rather than "with players on". The crawler counts open connections and
            not people — one player with two clients is two connections, and a bot is a connection —
            so the word that localizes cleanly is also the one that is true. See the handoff's
            "why players became connected".
        *@
        <ul class="tiles">
            <li>
                <span class="kicker">@L("tile.gamesKnown")</span>
                <span class="figure mono">@Counts.Known</span>
            </li>
            <li>
                <span class="kicker">@L("tile.connectedNow")</span>
                <span class="figure mono state-present">@Counts.WithPlayersOn</span>
            </li>
            <li>
                <span class="kicker">@L("tile.answeringUncounted")</span>
                <span class="figure mono">@Counts.CountUnknown</span>
            </li>
            <li>
                <a href="/archive"><span class="kicker">@L("tile.archived")</span>
                <span class="figure mono">@Counts.Archived</span></a>
            </li>
        </ul>

        @* Under the counts on purpose. Every figure above it is only as current as the loop this
           line describes, so it reads as the provenance of the four numbers it sits beneath. *@
        <CrawlerStrip Pulse="Pulse" Now="Now" />
    </section>

    @*
        Three registers, three colours, and the colours are the site's own: the accent means
        measured and is what a discovery and a return both are, amber means the thing we are least
        sure of and is what a game we can no longer reach is. The heading carries it; nothing on the
        rows below does, because a column of amber ages would say "went dark" once per row.
    *@
    <div class="feeds">
        <section class="feed feed-lit" aria-labelledby="feed-new">
            <h2 id="feed-new" class="kicker">@L("feed.newlyDiscovered")</h2>
            @if (Feeds.NewlyDiscovered.Count == 0)
            {
                <p class="faint">@L("feed.nothingNew")</p>
            }
            @foreach (var entry in Feeds.NewlyDiscovered)
            {
                <FeedCard Entry="entry" Kind="FeedKind.NewlyDiscovered" Now="Now" ShowRegister="false" />
            }
        </section>

        <section class="feed feed-dark" aria-labelledby="feed-dark">
            @* "Still probed" belongs here, once, rather than under every row as "we keep knocking".
               Nothing is ever deleted (§7.5) and this is where that promise is made. *@
            <h2 id="feed-dark" class="kicker">@L("feed.wentDark")</h2>
            @if (Feeds.WentDark.Count == 0)
            {
                <p class="faint">@L("feed.nothingDark")</p>
            }
            @foreach (var entry in Feeds.WentDark)
            {
                <FeedCard Entry="entry" Kind="FeedKind.WentDark" Now="Now" ShowRegister="false" />
            }
        </section>

        <section class="feed feed-lit" aria-labelledby="feed-back">
            <h2 id="feed-back" class="kicker">@L("feed.cameBack")</h2>
            @if (Feeds.CameBack.Count == 0)
            {
                <p class="faint">@L("feed.nothingBack")</p>
            }
            @foreach (var entry in Feeds.CameBack)
            {
                <FeedCard Entry="entry" Kind="FeedKind.CameBack" Now="Now" ShowRegister="false" />
            }
        </section>
    </div>

    <div class="card-footer">
        <a href="/games">@L("footer.allGames")</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/archive">@L("footer.archive")</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/submit">@L("nav.submitGame")</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="?plain=1">@L("a11y.plainText")</a>
            <LanguageSwitcher />
    </div>

    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private SiteCounts Counts = new(0, 0, 0, 0);
    private LivenessFeeds Feeds = new([], [], []);
    private CrawlerPulse Pulse = CrawlerPulse.Unknown;

    protected override async Task OnParametersSetAsync()
    {
        // Archived games are out of the default listing and of nothing else, so the front page's
        // "games known" counts them: they are still known, still probed and still addressable.
        Counts = SiteCounts.From(await Queries.ListAsync(new GameFilter { IncludeArchived = true }));
        Feeds = await Queries.FeedsAsync();

        // Its own read, and it cannot throw: StoredCrawlerPulse answers Unknown for a missing table
        // or a failed query alike, so the strip going quiet never costs a reader the front page.
        Pulse = await Crawler.ReadAsync(Now);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string L(string id) => Messages.For(Http.LocaleOf().Tag, id);
}
