@page "/ecosystem"
@using MUI.Web.Localization
@using MUI.Catalog.Persistence
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject IServiceProvider Services

@*
    The ecosystem dashboard (spec §9). Two load-bearing rules: shares only, never totals (§15.7 —
    an absolute player headcount can't survive unreached/unclaimed games the way a ratio can), and
    a share is stated with its denominator every time ("of the 431 games whose handshake we have
    completed"), never as a bare percentage.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderEcosystem(Dashboard, Now, Tag)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.Ecosystem(Tag)" Description="@PreviewCopy.Pages.Ecosystem(Tag)" />

    <h1>@L("ecosystem.title")</h1>
    <p class="dim">@EcosystemCopy.NoTotals(Tag)</p>

    @* The numeral is an argument to the sentence, not a fragment glued in front, so a language
       that puts the number last may — and the resx a translator opens carries no markup. *@
    <ul class="counts mono">
        <li>@Counted("ecosystem.listed", Dashboard.ListedGames)</li>
        <li>@Counted("ecosystem.handshakes", Dashboard.Handshakes)</li>
        <li>@Counted("ecosystem.msspReports", Dashboard.MsspReports)</li>
    </ul>

    @if (Dashboard.OldestHandshake is { } oldest)
    {
        <p class="faint">@Say("ecosystem.oldestHandshake", ("age", Relative.Format(Http.LocaleOf().Tag, Now - oldest)))</p>
    }

    <section aria-labelledby="codebases">
        <h2 id="codebases">@L("ecosystem.codebases.title")</h2>
        <p class="dim">@EcosystemCopy.CodebaseBasis(Tag, Dashboard.Codebases)</p>

        @if (Dashboard.Codebases.Families.Count == 0)
        {
            <p class="faint">@L("ecosystem.codebases.none")</p>
        }

        <ul class="shares">
            @foreach (var family in Dashboard.Codebases.Shared)
            {
                <li>
                    <span class="share-label">
                        <a href="@Http.Link($"/games?{FacetKeys.Codebase}={Uri.EscapeDataString(family.Label)}")">@family.Label</a>
                    </span>
                    @* The bar carries no fact of its own, so it's hidden from assistive tech rather
                       than announced twice beside the figure that does. *@
                    <span class="share-track" aria-hidden="true">
                        <span class="share-fill" style="width: @Percent(family.Fraction)"></span>
                    </span>
                    <span class="share-figure mono">@EcosystemCopy.Share(Tag, family)</span>
                </li>
            }
        </ul>

        @* The long tail is folded rather than deleted — every sole-use codebase is still one click away. *@
        @if (Dashboard.Codebases.SoleUse.Count > 0)
        {
            <details class="sole-use">
                <summary>@EcosystemCopy.SoleUse(Tag, Dashboard.Codebases)</summary>
                <ul class="sole-use-names">
                    @foreach (var alone in Dashboard.Codebases.SoleUse)
                    {
                        <li>
                            <a href="@Http.Link($"/games?{FacetKeys.Codebase}={Uri.EscapeDataString(alone.Label)}")">@alone.Label</a>
                        </li>
                    }
                </ul>
            </details>
        }
    </section>

    <section aria-labelledby="lineages">
        <h2 id="lineages">@L("ecosystem.lineages.title")</h2>

        @* The one panel here whose numbers are our own judgement, not a count of what a server
           said — the "derived" evidence marker says so up front rather than in a footnote. *@
        <p class="dim">
            @L("ecosystem.lineages.basis")
            <span class="evidence derived">
                <span aria-hidden="true">◆</span> @FacetWords.Evidence(Tag, FacetEvidence.Derived)
            </span>
        </p>

        @if (Dashboard.Codebases.Lineages.Count == 0)
        {
            <p class="faint">@L("ecosystem.lineages.none")</p>
        }

        <ul class="shares">
            @foreach (var lineage in Dashboard.Codebases.Lineages)
            {
                <li>
                    <span class="share-label">
                        <a href="@Http.Link($"/games?{FacetKeys.Lineage}={Uri.EscapeDataString(lineage.Label)}")">@lineage.Label</a>
                    </span>
                    <span class="share-track" aria-hidden="true">
                        <span class="share-fill derived" style="width: @Percent(lineage.Fraction)"></span>
                    </span>
                    <span class="share-figure mono">@EcosystemCopy.Share(Tag, lineage)</span>
                </li>
            }
        </ul>

        @if (Dashboard.Codebases.NotClassified > 0)
        {
            @* Our abstention, kept out of everyone else's bar — counting only classified games
               would inflate every share by exactly the amount we didn't know. *@
            @* The family name is machine voice, so it reaches the sentence as a substituted
               argument rather than a span the message text has to be cut around. *@
            <p class="faint">
                @((MarkupString)Say(
                    "ecosystem.lineages.notClassified",
                    ("count", Dashboard.Codebases.NotClassified),
                    ("family", $"<span class=\"mono\" translate=\"no\">{System.Net.WebUtility.HtmlEncode(EcosystemCopy.CustomFamily)}</span>")))
            </p>
        }
    </section>

    <section aria-labelledby="protocols">
        <h2 id="protocols">@L("ecosystem.protocols.title")</h2>
        <p class="dim">@EcosystemCopy.Floor(Tag)</p>

        @if (Dashboard.Mssp is { } mssp)
        {
            <p class="faint">@EcosystemCopy.MsspBasis(Tag, mssp, Dashboard.MsspReports)</p>
        }

        <div class="table-wrap">
            <table class="protocols">
                <caption class="sr-only">@L("ecosystem.protocols.caption")</caption>
                <thead>
                    <tr>
                        <th scope="col">@L("ecosystem.column.protocol")</th>
                        <th scope="col">
                            @Say("ecosystem.column.measured",
                                 ("basis", EcosystemCopy.Handshakes(Tag, Dashboard.Handshakes)))
                        </th>
                        <th scope="col">
                            @Say("ecosystem.column.declared",
                                 ("basis", EcosystemCopy.MsspReports(Tag, Dashboard.MsspReports)))
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var protocol in Dashboard.Protocols)
                    {
                        <tr>
                            <th scope="row" class="mono">@protocol.Protocol</th>
                            <td>
                                @if (protocol.Measured is { Fraction: { } fraction })
                                {
                                    <span class="share-track narrow" aria-hidden="true">
                                        <span class="share-fill" style="width: @Percent(fraction)"></span>
                                    </span>
                                }
                                <span class="@(protocol.Measured is null ? "faint" : "mono")">
                                    @EcosystemCopy.Measured(Tag, protocol)
                                </span>
                            </td>
                            <td class="declared @(protocol.DeclaredShare is null ? "faint" : "mono")">
                                @EcosystemCopy.Declared(Tag, protocol)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="curve">
        @* Drawn only with two points to draw between — a single snapshot rendered as a trend would
           be inventing a direction we haven't measured (rule 4/5). *@
        @if (Curves.Any(c => c.IsCurve))
        {
            <h2 id="curve">@L("ecosystem.curve.title")</h2>
            <p class="dim">@EcosystemCopy.CurveCaveat(Tag)</p>

            <table class="curve">
                <caption class="sr-only">@L("ecosystem.curve.caption")</caption>
                <thead>
                    <tr>
                        <th scope="col">@L("ecosystem.column.protocol")</th>
                        <th scope="col">@L("ecosystem.curve.then")</th>
                        <th scope="col">@L("ecosystem.curve.now")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var curve in Curves.Where(c => c.IsCurve))
                    {
                        var (first, last) = curve.Ends;
                        <tr>
                            <th scope="row" class="mono">@curve.Protocol</th>
                            <td class="mono">
                                @Share(first)
                                <span class="faint">@curve.Points[0].At.ToString("MMM yyyy")</span>
                            </td>
                            <td class="mono">@Share(last)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h2 id="curve">@L("ecosystem.snapshot.title")</h2>
            <p class="dim">@EcosystemCopy.NoCurve(Tag)</p>
        }

        <p class="mono">@EcosystemCopy.Transitions(Tag, Dashboard.CapabilityTransitions)</p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private EcosystemDashboard Dashboard = EcosystemDashboard.Empty(default);

    /// <summary>§9's adoption curves; empty for the demo fixture or a deployment with no history yet.</summary>
    private IReadOnlyList<AdoptionCurve> Curves { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        Dashboard = await Queries.EcosystemAsync();
        Curves = await CurvesAsync();
    }

    /// <summary>One curve per headline protocol, over the last two years.</summary>
    /// <remarks>
    /// Reads <see cref="EcosystemProtocols.Headline"/> rather than listing protocols here, so the
    /// table above and the curves below can't disagree on which protocols this page covers.
    /// </remarks>
    private async Task<IReadOnlyList<AdoptionCurve>> CurvesAsync()
    {
        if (Services.GetService<IEcosystemSnapshots>() is not { } snapshots)
        {
            return [];
        }

        var now = Now;
        List<AdoptionCurve> curves = [];

        foreach (var protocol in EcosystemProtocols.Headline)
        {
            curves.Add(new AdoptionCurve(
                protocol,
                await snapshots.CurveAsync(protocol, now.AddYears(-2), now)));
        }

        return curves;
    }

    /// <summary>A share, or the honest absence of one.</summary>
    /// <remarks>
    /// A curve's cell carries the percentage alone (the denominator is the column head), so this
    /// is the one figure here that isn't <see cref="EcosystemCopy.Share"/>.
    /// </remarks>
    private string Share(MeasuredShare? share) => share?.Fraction is { } fraction
        ? Say("ecosystem.share.percent", ("fraction", fraction))
        : L("ecosystem.curve.notMeasured");

    /// <summary>
    /// A bar width, formatted by hand and under the invariant culture.
    /// </summary>
    /// <remarks>
    /// <c>P1</c> writes a space before the "%" and a locale-specific decimal separator — both
    /// produce a CSS <c>width</c> value the browser silently discards, making the bar vanish on
    /// somebody else's machine.
    /// </remarks>
    private static string Percent(double? fraction) => fraction is { } f
        ? FormattableString.Invariant($"{f * 100:0.0}%")
        : "0%";

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));

    /// <summary>
    /// One of the three counts at the top, with the numeral drawn heavier than the words.
    /// </summary>
    /// <remarks>
    /// The markup is a substituted argument, not string concatenation, so the resx a translator
    /// opens stays free of tags — and the only argument is a number we formatted ourselves, so
    /// nothing reader-supplied reaches <see cref="MarkupString"/>.
    /// </remarks>
    private MarkupString Counted(string id, int count) => (MarkupString)Say(
        id,
        ("count", count),
        ("value", $"<strong>{System.Net.WebUtility.HtmlEncode(count.ToString(System.Globalization.CultureInfo.InvariantCulture))}</strong>"));
}
