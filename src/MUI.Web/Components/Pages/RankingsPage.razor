@using MUI.Web.Localization
@page "/rankings"
@inject IGameQueries Queries
@inject TimeProvider Clock

@*
    The rankings (spec §9), computed from measured data only.

    What a ranking on this site can honestly be is a short list. "Busiest" is defensible once the
    window, the statistic and the eligible set are stated: it is the median of counts we actually
    read, over seven days, among the games that produced enough samples to have a median. "Best" is
    not defensible at any length, because nobody measured it — and the affordance that would let
    readers assert it is the one thing §2 rules out permanently, since vote-gaming is what reduced
    Top Mud Sites to a link graveyard.

    So both tables here say what they rank on, over what window, out of how many games, and what
    they exclude. A ranking whose arithmetic a reader cannot check is a ranking they have to trust,
    and this site does not ask for trust.

    The component is RankingsPage and not Rankings because the view model it renders is called
    Rankings, and a page class of that name shadows it inside its own code block.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderRankings(Table, Now, Tag)</pre>
}
else
{
    <SitePreview Title="Rankings" Description="@PreviewCopy.Pages.Rankings"
                 Card="PreviewCard.Rankings" />

    <h1>@L("rankings.title")</h1>
    <p class="dim">@EcosystemCopy.NoVote(Tag)</p>

    <section aria-labelledby="busiest">
        <h2 id="busiest">@L("rankings.busiest.title")</h2>

        @*
            Three windows, as links rather than as a control. The page is a document and the window
            is part of its address, so the browser's back button works, the tab can be shared, and a
            text browser gets the same three choices — which is the whole test §9 sets for a
            graphic. aria-current marks the live one, so the state is announced and not only shaded.
        *@
        <nav class="spans" aria-label="@L("rankings.window.label")">
            @foreach (var span in RankingSpans.All)
            {
                <a href="@Href(span)"
                   class="@(span == Table.Span ? "span on" : "span")"
                   aria-current="@(span == Table.Span ? "page" : null)">@EcosystemCopy.SpanLabel(Tag, span)</a>
            }
        </nav>

        <p class="dim">@EcosystemCopy.BusiestBasis(Tag, Table)</p>
        <p class="faint">@EcosystemCopy.SpanChoice(Tag)</p>

        @if (Table.Busiest.Count == 0)
        {
            <p class="faint">@L("rankings.busiest.empty")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="ranking">
                    <caption class="sr-only">
                        @Say("rankings.busiest.caption", ("days", (int)Table.Window.TotalDays))
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col" class="place">@L("rankings.column.place")</th>
                            <th scope="col">@L("rankings.column.game")</th>
                            <th scope="col">@L("rankings.column.median")</th>
                            <th scope="col">@L("rankings.column.peak")</th>
                            <th scope="col">@L("rankings.column.samples")</th>
                            <th scope="col">@L("rankings.column.days")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Table.Busiest)
                        {
                            <tr>
                                <td class="place mono">@Place(Table.Busiest.Select(g => g.Median), game.Median)</td>
                                <th scope="row"><a href="/g/@game.Slug">@game.Name</a></th>
                                @* The rank is on the median, so the median is the emphasised cell and
                                   the peak sits beside it as context. A peak is one sample, and a game
                                   that had forty players for a minute is not busier than one that has
                                   thirty all day. *@
                                <td class="mono state-present">@game.Median</td>
                                <td class="mono">@game.Peak</td>
                                <td class="mono faint">@game.Samples</td>
                                @* The other half of the basis: a thousand samples means something
                                   different over ninety days than over three. *@
                                <td class="mono faint">@game.Days / @((int)Table.Window.TotalDays)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="spells">
        <h2 id="spells">@L("rankings.spells.title")</h2>
        <p class="dim">@EcosystemCopy.SpellBasis(Tag)</p>

        @if (Table.LongestUnbroken.Count == 0)
        {
            <p class="faint">@L("rankings.spells.empty")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="ranking">
                    <caption class="sr-only">@L("rankings.spells.caption")</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="place">@L("rankings.column.place")</th>
                            <th scope="col">@L("rankings.column.game")</th>
                            <th scope="col">@L("rankings.column.since")</th>
                            <th scope="col">@L("rankings.column.duration")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var spell in Table.LongestUnbroken)
                        {
                            <tr>
                                @*
                                    Tied games share a place. Every one of the twenty rows here read
                                    "31 July 2026" and they were numbered 1 to 20 — an order the
                                    measurements do not contain, printed by a site whose whole
                                    argument is that it prints only what it measured.
                                *@
                                <td class="place mono">
                                    @Place(Table.LongestUnbroken.Select(s => s.Since.Ticks), spell.Since.Ticks)
                                </td>
                                <th scope="row"><a href="/g/@spell.Slug">@spell.Name</a></th>
                                <td class="mono">@Dates.Absolute(Tag, spell.Since)</td>
                                <td class="mono state-present">@Wording.Duration(spell.LengthAt(Now))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <p class="faint">
        @L("rankings.archivedNote")
        <a href="/archive">@L("nav.archive")</a> ·
        <a href="/ecosystem">@L("nav.ecosystem")</a> ·
        <a href="?window=@Span.Slug()&plain=1">@L("a11y.plainText")</a>
    </p>
}

@code {

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    /// <summary>Which window to rank over: <c>7d</c>, <c>30d</c> or <c>90d</c>.</summary>
    /// <remarks>
    /// Anything else falls back to the week rather than erroring. A mistyped window on a browsable
    /// league table is not worth a 400 in front of a page that has a right answer to give, and the
    /// selector then shows which window the reader actually got.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "window")] private string? WindowSlug { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private RankingSpan Span => RankingSpans.Parse(WindowSlug);

    private Rankings Table = Rankings.Empty(default, TimeSpan.Zero, 0);

    /// <summary>
    /// Where a row places, with tied rows sharing a place.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Competition ranking: a row's place is one more than the number of rows strictly above it, so
    /// four games on the same median are four number 4s and the next is a 8. Numbering them 4, 5, 6,
    /// 7 would state an order the measurement does not contain — the whole of finding S5, and the
    /// opposite of what every other surface here is careful about.
    /// </para>
    /// <para>
    /// Rows are ordered as the query returned them, and the table's caption says the ties are ties
    /// rather than leaving a reader to infer a tiebreaker we did not apply.
    /// </para>
    /// </remarks>
    private static int Place<T>(IEnumerable<T> values, T value) where T : IComparable<T> =>
        1 + values.Count(v => v.CompareTo(value) > 0);

    /// <summary>The address of one window, carrying plain mode through if that is how we arrived.</summary>
    private string Href(RankingSpan span) =>
        Plain ? $"?window={span.Slug()}&plain=1" : $"?window={span.Slug()}";

    protected override async Task OnParametersSetAsync() => Table = await Queries.RankingsAsync(Span);

    /// <summary>The locale this league table is being read in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));
}
