@using MUI.Web.Localization
@page "/rankings"
@inject IGameQueries Queries
@inject TimeProvider Clock

@*
    The rankings (spec §9), computed from measured data only. "Busiest" is defensible once the
    window, statistic, and eligible set are stated; "best" is not, at any length, because nobody
    measured it — the vote affordance that would let readers assert it is ruled out permanently by
    §2 (vote-gaming is what reduced Top Mud Sites to a link graveyard). Both tables here say what
    they rank on, over what window, out of how many games, and what they exclude.

    Named RankingsPage rather than Rankings because the view model it renders is called Rankings,
    which would shadow a page class of that name inside its own code block.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderRankings(Table, Now, Tag)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.Rankings(Tag)" Description="@PreviewCopy.Pages.Rankings(Tag)"
                 Card="PreviewCard.Rankings" />

    <h1>@L("rankings.title")</h1>
    <p class="dim">@EcosystemCopy.NoVote(Tag)</p>

    <section aria-labelledby="busiest">
        <h2 id="busiest">@L("rankings.busiest.title")</h2>

        @* Three windows as links, not a control: the window is part of the page's address, so
           back/share/text-browsers all work. aria-current marks the live one. *@
        <nav class="spans" aria-label="@L("rankings.window.label")">
            @foreach (var span in RankingSpans.All)
            {
                <a href="@Href(span)"
                   class="@(span == Table.Span ? "span on" : "span")"
                   aria-current="@(span == Table.Span ? "page" : null)">@EcosystemCopy.SpanLabel(Tag, span)</a>
            }
        </nav>

        <p class="dim">@EcosystemCopy.BusiestBasis(Tag, Table)</p>
        <p class="faint">@EcosystemCopy.SpanChoice(Tag)</p>

        @if (Table.Busiest.Count == 0)
        {
            <p class="faint">@L("rankings.busiest.empty")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="ranking">
                    <caption class="sr-only">
                        @Say("rankings.busiest.caption", ("days", (int)Table.Window.TotalDays))
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col" class="place">@L("rankings.column.place")</th>
                            <th scope="col">@L("rankings.column.game")</th>
                            <th scope="col">@L("rankings.column.median")</th>
                            <th scope="col">@L("rankings.column.peak")</th>
                            <th scope="col">@L("rankings.column.samples")</th>
                            <th scope="col">@L("rankings.column.days")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Table.Busiest)
                        {
                            <tr>
                                <td class="place mono">@Place(Table.Busiest.Select(g => g.Median), game.Median)</td>
                                <th scope="row"><a href="@Http.Link($"/g/{game.Slug}")">@game.Name</a></th>
                                @* Ranked on the median, not the peak: a peak is one sample, and a
                                   game with 40 players for a minute isn't busier than one with 30
                                   all day. *@
                                <td class="mono state-present">@game.Median</td>
                                <td class="mono">@game.Peak</td>
                                <td class="mono faint">@game.Samples</td>
                                @* A thousand samples means something different over 90 days than over 3. *@
                                <td class="mono faint">@game.Days / @((int)Table.Window.TotalDays)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="trending">
        <h2 id="trending">@L("rankings.trending.title")</h2>
        <p class="dim">@L("rankings.trending.basis")</p>

        @if (Table.TrendingThisWeek.Count == 0)
        {
            <p class="faint">@L("rankings.trending.empty")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="ranking">
                    <caption class="sr-only">@L("rankings.trending.caption")</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="place">@L("rankings.column.place")</th>
                            <th scope="col">@L("rankings.column.game")</th>
                            <th scope="col">@L("rankings.column.thisWeek")</th>
                            <th scope="col">@L("rankings.column.lastWeek")</th>
                            <th scope="col">@L("rankings.column.change")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Table.TrendingThisWeek)
                        {
                            <tr>
                                <td class="place mono">@Place(Table.TrendingThisWeek.Select(g => g.Change), game.Change)</td>
                                <th scope="row"><a href="@Http.Link($"/g/{game.Slug}")">@game.Name</a></th>
                                <td class="mono state-present">@game.Median</td>
                                <td class="mono faint">@game.PriorMedian</td>
                                <td class="mono state-present">+@Percent(game.Change)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="spells">
        <h2 id="spells">@L("rankings.spells.title")</h2>
        <p class="dim">@EcosystemCopy.SpellBasis(Tag)</p>

        @if (Table.LongestUnbroken.Count == 0)
        {
            <p class="faint">@L("rankings.spells.empty")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="ranking">
                    <caption class="sr-only">@L("rankings.spells.caption")</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="place">@L("rankings.column.place")</th>
                            <th scope="col">@L("rankings.column.game")</th>
                            <th scope="col">@L("rankings.column.since")</th>
                            <th scope="col">@L("rankings.column.duration")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var spell in Table.LongestUnbroken)
                        {
                            <tr>
                                @* Tied games share a place — numbering them sequentially would
                                   print an order the measurements don't contain. Ranked on `Since`
                                   rather than the duration the heading names: `Now` is a fresh
                                   instant on every read, so comparing `LengthAt(Now)` breaks ties by
                                   microseconds and invents a place. `Place` ranks the *greatest*
                                   value first, so this uses `PlaceEarliest` — ranking on
                                   `Since.Ticks` with `Place` put the longest-running game last. *@
                                <td class="place mono">
                                    @PlaceEarliest(Table.LongestUnbroken.Select(s => s.Since), spell.Since)
                                </td>
                                <th scope="row"><a href="@Http.Link($"/g/{spell.Slug}")">@spell.Name</a></th>
                                <td class="mono">@Dates.Absolute(Tag, spell.Since)</td>
                                <td class="mono state-present">@Wording.Duration(spell.LengthAt(Now))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <p class="faint">
        @L("rankings.archivedNote")
    </p>
}

@code {

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    /// <summary>Which window to rank over: <c>7d</c>, <c>30d</c> or <c>90d</c>.</summary>
    /// <remarks>
    /// Anything else falls back to the week rather than erroring. A mistyped window on a browsable
    /// league table is not worth a 400 in front of a page that has a right answer to give, and the
    /// selector then shows which window the reader actually got.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "window")] private string? WindowSlug { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private RankingSpan Span => RankingSpans.Parse(WindowSlug);

    private Rankings Table = Rankings.Empty(default, TimeSpan.Zero, 0);

    /// <summary>Where a row places, with tied rows sharing a place.</summary>
    /// <remarks>
    /// Competition ranking: four games tied on the median are all place 4 and the next is place 8.
    /// Numbering them 4, 5, 6, 7 would state an order the measurement doesn't contain.
    /// </remarks>
    private static int Place<T>(IEnumerable<T> values, T value) where T : IComparable<T> =>
        1 + values.Count(v => v.CompareTo(value) > 0);

    /// <summary>A fraction of change, as the whole number the column prints.</summary>
    private static int Percent(double change) => (int)Math.Round(change * 100);

    /// <summary>The same place, for a column where the smallest value is the best one.</summary>
    /// <remarks>
    /// An earlier start date is the better result, which needs the opposite comparison from
    /// <see cref="Place{T}"/> — sharing that method between them ranked this column backwards.
    /// </remarks>
    private static int PlaceEarliest<T>(IEnumerable<T> values, T value) where T : IComparable<T> =>
        1 + values.Count(v => v.CompareTo(value) < 0);

    /// <summary>The address of one window, carrying plain mode through if that is how we arrived.</summary>
    private string Href(RankingSpan span) =>
        Plain ? $"?window={span.Slug()}&plain=1" : $"?window={span.Slug()}";

    protected override async Task OnParametersSetAsync() => Table = await Queries.RankingsAsync(Span);

    /// <summary>The locale this league table is being read in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));
}
