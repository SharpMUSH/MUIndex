@page "/games/random"
@using MUI.Web.Api
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject NavigationManager Nav

@*
    Random game (spec §9): a link, not a control, so it works with scripting off, is bookmarkable,
    and carries whatever filters were on screen. Renders only when it couldn't pick one — the normal
    path redirects from OnInitializedAsync and never reaches this markup.
*@

<SitePreview Title="@PreviewCopy.Titles.Random(Tag)" Description="@PreviewCopy.Pages.Random(Tag)" />

<h1>@Messages.For(Tag, "random.empty.title")</h1>

@if (Error is { } problem)
{
    <p class="problem" role="alert">@problem</p>
}
else
{
    <p class="dim">
        @foreach (var run in Sentence)
        {
            @if (run.Slot is { } slot)
            {
                <a href="@Http.Link(Address(slot))">@run.Text</a>
            }
            else
            {
                @run.Text
            }
        }
    </p>
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>The empty state's sentence (two links), split into the runs the markup renders.</summary>
    /// <remarks>
    /// <see cref="Sentences"/> walks message-placed markers so a translator writes text, never markup
    /// or anchors trusted through a <c>MarkupString</c> — and the message owns word order per locale.
    /// </remarks>
    private IReadOnlyList<Sentences.Run> Sentence => Sentences.Place(
        Tag,
        "random.empty.body",
        ("listing", Messages.For(Tag, "random.empty.listing")),
        ("archive", Messages.For(Tag, "random.empty.archive")));

    /// <summary>Where each slot of that sentence leads.</summary>
    private static string Address(string slot) =>
        slot == "listing" ? "/games" : "/games?archived=true";

    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!GameFilterBinding.TryRead(new Uri(Nav.Uri).Query, out var query, out var error))
        {
            Error = error;
            return;
        }

        var games = await Queries.ListAsync(query.Filter);

        if (games.Count == 0)
        {
            return;
        }

        // IGameQueries can only answer with a whole-listing read; a cheaper ORDER BY random() LIMIT 1
        // needs a new query, not a different caller here.
        var pick = games[Random.Shared.Next(games.Count)];

        // Http.Link keeps this in the page's own locale — a bare leading slash is host-relative, not
        // base-relative, and previously sent a German reader to the English game page.
        Nav.NavigateTo(Http.Link($"/g/{Uri.EscapeDataString(pick.Slug)}"));
    }
}
