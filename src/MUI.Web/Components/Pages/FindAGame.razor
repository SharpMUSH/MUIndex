@page "/find"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using MUI.Catalog
@using MUI.Web.Api
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject NavigationManager Nav

@*
    §9's find-a-game wizard. The listing's facet panel is exhaustive and assumes MSSP-taxonomy
    knowledge; this asks in a reader's language and answers in facets.

    THE QUERYSTRING IS THE STATE, and every control's name is a FacetKeys constant — this page reads
    its own URL through the listing's own binding, so an answered Find page is linkable, reloadable
    and countable (there is now a server-side moment where a set of answers exists).

    EVERY OPTION IS A LINK: the only scriptless control that applies on click. No script means the
    count is server-rendered, so the handoff's debounced aria-live region is unnecessary — a page
    load announces its own heading.

    NOT SIX FIELDSETS. A <legend> is announced when focus enters a form control in its group; with
    no controls to enter, it would name the group for nobody. Each question is instead a labelled
    group with a real <h2>, which the handoff explicitly allows as the substitution.
*@

<PageTitle>@Say("find.title") — mu*index</PageTitle>

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderFind(Screen, Tag)</pre>
}
else
{
<div class="card-page find-page">

<header class="listing-head">
    @* The heading, and nothing under it: the live count demonstrates that answers filter rather
       than rank, and the escape hatch is in the footer row below, like every other page. *@
    <h1>@Say("find.title")</h1>
</header>

@if (Screen.Error is { } problem)
{
    @* A querystring we cannot read is refused rather than dropped, exactly as the listing refuses
       it — offering the unfiltered catalogue would present our own parse failure as an answer. *@
    <p class="problem" role="alert">@problem</p>
    <p><a href="@Http.Link("/find")">@Say("find.startAgain")</a></p>
}
else
{
@*
    Free text first, so a reader with a name in mind need not read past five taxonomies to type it —
    above the two columns rather than in the left one, so the panel's first line lands on the first
    question's heading. Every answer already given rides along as a hidden input, so typing a name
    refines rather than replaces.
*@
<form class="find-name" method="get" action="@Http.Link("/find")">
    @foreach (var (key, value) in Carried)
    {
        <input type="hidden" name="@key" value="@value" />
    }
    <label for="find-q" class="kicker">@Say("find.name.label")</label>
    <span class="search-field">
        <span class="search-glyph mono" aria-hidden="true">⌕</span>
        <input id="find-q" type="search" name="@FacetKeys.Text" value="@Text"
               placeholder="@Say("find.name.placeholder")" />
        @* A submit that exists only as the return key is one a pointer-only reader cannot fire. *@
        <button type="submit" class="search-go" aria-label="@Say("find.name.submit")">
            <span aria-hidden="true">→</span>
        </button>
    </span>
</form>

<div class="find-grid">

<div class="find-questions">

    @foreach (var (question, index) in Screen.Questions.Select((q, i) => (q, i)))
    {
        <div class="find-q" role="group" aria-labelledby="@Heading(index)">
            <div class="find-q-head">
                <h2 id="@Heading(index)">@question.Text</h2>
                @* On every question, not once at the foot of the page: a reader needs to know
                   whether a filter reads a measurement, a config value, or our own grouping before
                   trusting a count enough to answer with it. *@
                <EvidenceChip Evidence="question.Evidence" />
            </div>

            <div class="find-opts">
                @* Always first, always the widest: a question you cannot un-answer is a trap. *@
                @if (question.Any is { } any)
                {
                    @Option(any)
                }
                @foreach (var option in question.Options)
                {
                    @Option(option)
                }
            </div>

            @if (question.Tail is { Count: > 0 } tail)
            {
                @* The long tail, behind a native disclosure: an option returning one game is trivia
                   rather than a filter, and a submittable "3 more genres" bucket would offer a
                   choice /games cannot express. *@
                <details class="find-tail">
                    <summary>@Say("find.more", ("count", tail.Count))</summary>
                    <div class="find-opts">
                        @foreach (var option in tail)
                        {
                            @Option(option)
                        }
                    </div>
                </details>
            }
        </div>
    }
</div>

@* The count, and everything that acts on it. The inner wrapper sticks, so the number stays in view
   while the last questions are answered — the whole premise of the page. *@
<div class="find-panel">
    <div class="find-panel-inner">
        <p class="kicker">@Say("find.kicker")</p>

        @* One number, counted from the pass that would list them — never a product of the marginals
           beside the options, which assumes independence and is usually wrong. The sentence beside
           it is what a screen reader gets; a bare "19" is unusable. *@
        <p class="find-count">
            <span class="find-n mono" aria-hidden="true">@Screen.Matching</span>
            <span class="find-noun" aria-hidden="true">@Say("find.noun", ("count", Screen.Matching))</span>
            <span class="sr-only">@Say("find.matching", ("count", Screen.Matching))</span>
        </p>

        <p class="find-basis">
            @Say("find.basis", ("listed", Screen.Listed), ("answers", Screen.Answers.Count))
        </p>

        @if (Screen.Answers.Count > 0)
        {
            <div class="find-chips">
                @foreach (var chip in Screen.Answers)
                {
                    @* One chip per answer given, each undoing exactly that one. The × alone is not a
                       description, so the accessible name says which question it clears. *@
                    <a class="find-chip" href="@Http.Link(chip.ClearHref)"
                       aria-label="@Say("find.clear", ("question", chip.Question))">
                        <span class="chip-value">@chip.Label</span>
                        <span class="chip-x" aria-hidden="true">✕</span>
                    </a>
                }
            </div>
        }

        @if (Screen.Loosen is { } loosen)
        {
            @* A way out, not a diagnosis: no warning box, just the count they can already see and
               which answer to drop, counted rather than estimated. *@
            <a class="find-loosen" href="@Http.Link(loosen.Href)">
                <span aria-hidden="true">×</span>
                @Say("find.drop", ("answer", loosen.Label), ("count", loosen.Count))
            </a>
        }

        @if (Screen.Matching > 0)
        {
            @* The listing, asked exactly what this page was asked. Drawn only where there's
               something to show — a control that can't do what it offers is worse than none. *@
            <a class="find-go" href="@Http.Link(Screen.ShowHref)">@Say("find.show", ("count", Screen.Matching))</a>
        }

        @if (Screen.Answers.Count > 0)
        {
            <p class="find-clear"><a href="@Http.Link(Screen.ClearHref)">@Say("find.clearAll")</a></p>
        }
    </div>
</div>

</div>
}

</div>
}

@code {
    /// <summary>The querystring this render is answering, exactly as the request carried it.</summary>
    /// <remarks>
    /// Read off <c>Nav.Uri</c> once per render rather than on every access — it used to be a computed
    /// property allocating a <see cref="Uri"/> on each of several reads per render.
    /// </remarks>
    private string Query { get; set; } = string.Empty;

    /// <summary>The same querystring, parsed once, for the members that read parameters out of it.</summary>
    private Dictionary<string, StringValues> Parsed { get; set; } = [];

    private bool Plain =>
        Truthy.Is(Parsed.TryGetValue("plain", out var flag) ? flag.ToString() : null);

    /// <summary>The six questions and their counts, once the catalogue has answered.</summary>
    /// <remarks>
    /// <see cref="FindScreen.Empty"/> rather than <c>null!</c>: the first render happens before
    /// <see cref="OnParametersSetAsync"/> finishes, and the null it used to hold was dereferenced
    /// whenever the load actually suspended — every request against a real database, none against
    /// the test fixture.
    /// </remarks>
    private FindScreen Screen { get; set; } = FindScreen.Empty;

    /// <summary>The request, for the locale these sentences are spoken in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    /// <summary>
    /// The locale the whole page is built in, screen included.
    /// </summary>
    /// <remarks>
    /// Handed to <see cref="FindScreen.BuildAsync"/> rather than applied to what it returns, since
    /// question texts, labels and glosses are part of the screen and the plain rendering reads them
    /// straight off it — a locale applied afterwards would reach one surface and not the other.
    /// </remarks>
    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// One sentence, as a message rather than as English fragments glued round a number.
    /// </summary>
    /// <remarks>
    /// Every count here is a plural agreement somewhere (Russian: three forms, Arabic: six). "1
    /// games" shipped twice on the version of this page these replace.
    /// </remarks>
    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.For(
            Tag,
            id,
            args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));

    private static string Heading(int index) => $"find-q{index}";

    private string? Text =>
        Parsed.TryGetValue(FacetKeys.Text, out var typed) ? typed.ToString() : null;

    /// <summary>
    /// Every answer the name field has to carry with it, as hidden inputs.
    /// </summary>
    /// <remarks>
    /// Read off the live querystring rather than a hand-kept list of parameters, which used to hold
    /// only <c>q</c> and <c>archived</c> and would quietly drop any new facet on submit. <c>q</c>
    /// itself is excluded since the field supplies it and a second copy would reach the binding as
    /// <c>old,new</c>.
    /// </remarks>
    private IEnumerable<KeyValuePair<string, string>> Carried =>
        Parsed
            .Where(p => !string.Equals(p.Key, FacetKeys.Text, StringComparison.Ordinal))
            .SelectMany(p => p.Value.Select(v => new KeyValuePair<string, string>(p.Key, v ?? string.Empty)));

    /// <summary>One answer, as the state it is in and the address that changes it.</summary>
    /// <remarks>
    /// The glyph carries the pressed state a second way, since colour is never the only one. A
    /// chosen option's own link clears it, reachable in both directions with no second affordance.
    /// The class is written whole rather than interpolated round a null — Razor renders a null
    /// branch as empty and leaves the surrounding space, shipping <c>class="find-opt "</c>.
    /// </remarks>
    private RenderFragment Option(FindOption option) =>
        @<a class="@(option.IsChosen ? "find-opt on" : "find-opt")" href="@Http.Link(option.Href)"
            aria-current="@(option.IsChosen ? "true" : null)"
            aria-label="@Say("facet.value.choose", ("value", option.Label), ("count", option.Count))">
            <span class="tick" aria-hidden="true">@(option.IsChosen ? "◉" : "○")</span>
            <span class="opt-name">@option.Label</span>
            <span class="count mono">@option.Count</span>
        </a>;

    protected override async Task OnParametersSetAsync()
    {
        // Both set before the screen is built, because every member that reads a parameter reads
        // them and the screen is the first thing that does.
        Query = new Uri(Nav.Uri).Query;
        Parsed = QueryHelpers.ParseQuery(Query);

        Screen = await FindScreen.BuildAsync(Queries, Query, Tag);
    }
}
