@page "/archive"
@using MUI.Web.Data
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject IAvailabilityHistory History
@inject TimeProvider Clock

@*
    The archive is a first-class section, not a hidden flag. Nothing is deleted (spec §7.5): every
    URL still works, every game is still probed weekly, and one successful probe restores it to the
    listing. Tone stays dimmed, not "dead" — a catalogue entry, not an obituary.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderArchive(Entries, Query, Now, Tag)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.Archive(Tag)" Description="@PreviewCopy.Pages.Archive(Tag)"
                 Card="PreviewCard.Archive" />

    <h1>@L("archive.title")</h1>
    @* One message stating all three facts (stopped answering / nothing deleted / one probe restores)
       so no locale can drop one and leave this reading as an obituary. *@
    <p class="dim">@L("archive.lede")</p>

    <form method="get" action="@Http.Link("/archive")" role="search">
        <fieldset class="facets">
            <legend>@L("archive.search.legend")</legend>
            <label for="q" class="sr-only">@L("archive.search.label")</label>
            <input id="q" type="search" name="q" value="@Query"
                   placeholder="@L("archive.search.placeholder")" />
            <button type="submit">@L("archive.search.submit")</button>
        </fieldset>
    </form>

    <p class="kicker">@Say("archive.count", ("count", Entries.Count))</p>

    <ul class="archive">
        @foreach (var entry in Entries)
        {
            <li>
                <div class="row-main">
                    <div>
                        <a class="name" href="@Http.Link($"/g/{entry.Summary.Slug}")">@entry.Summary.Name</a>
                        <span class="badge archived">@L("archive.badge")</span>
                        @if (entry.Summary.Tagline is { } tagline)
                        {
                            <div class="dim">@tagline</div>
                        }
                        <div class="meta mono">
                            @* Same chip the listing row wears, for provenance. *@
                            @if (entry.Summary.CodebaseProvenance is { } codebase)
                            {
                                <Chip Fact="codebase" Now="Now" />
                                <text> · </text>
                            }
                            else if (entry.Summary.Codebase is { } bare)
                            {
                                <text>@bare · </text>
                            }
                            @entry.Run(Tag)
                        </div>
                    </div>
                    <dl class="archive-facts mono">
                        <dt class="kicker">@L("archive.lastReachable")</dt>
                        <dd>
                            @entry.LastAnswered(Tag)
                            <span class="faint">@Say("archive.darkFor", ("age", entry.DarkFor(Tag, Now)))</span>
                        </dd>
                        <dt class="kicker">@L("archive.knownLive")</dt>
                        <dd>@entry.KnownLiveWording(Tag)</dd>
                    </dl>
                </div>
            </li>
        }
    </ul>

    @if (Entries.Count == 0)
    {
        <p class="dim">@L("archive.empty")</p>
    }
}

@code {

    [SupplyParameterFromQuery(Name = "q")] private string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private IReadOnlyList<ArchiveEntry> Entries = [];

    protected override async Task OnParametersSetAsync()
    {
        // Queried as the archived band, not filtered client-side from the full set.
        var games = await Queries.ListAsync(new GameFilter
        {
            Text = Query,
            Band = ActivityBand.Archived,
            IncludeArchived = true,
        });

        var entries = new List<ArchiveEntry>(games.Count);
        foreach (var game in games)
        {
            entries.Add(ArchiveEntry.For(game, await History.ForGameAsync(game.Id), Now));
        }

        // Most recently lost first.
        Entries = [.. entries.OrderByDescending(e => e.LastReachableAt ?? DateTimeOffset.MinValue)];
    }

    /// <summary>The locale this catalogue entry is being read in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));
}
