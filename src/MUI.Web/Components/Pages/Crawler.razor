@page "/crawler"
@inject ICrawlerPulse Pulses
@inject IGameQueries Queries
@inject TimeProvider Clock
@inject ILogger<Crawler> Logger

@*
    /crawler used to be a 302 to About's crawler-identity section — deliberately a redirect rather
    than a page, per the doc comment on the old CrawlerContact endpoint, specifically so this
    substitution stayed possible later without an un-withdrawable cached 301. That identity/etiquette
    content stays on About, which already has its own tested audience: an operator retyping this
    exact URL off a log line, wanting to know who is knocking and how to stop it. This page answers a
    different question — is the instrument behind every measurement on the site actually running, and
    what did it just do — so it links to About rather than repeating it.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderCrawler(Tag, Pulse, Recent, RecentChanges, DueSoon, Feeds, Now)</pre>
}
else
{
    <section class="prose">
        <h1>@L("crawler.page.title")</h1>
        <p class="lede">@L("crawler.page.lede")</p>
        <p class="faint"><a href="@Http.Link("/about")">@L("crawler.page.aboutLink")</a></p>

        @if (Pulse.State(Now) is CrawlState.NotYet)
        {
            @* Names no cause: a fresh deployment and an unreachable database both look like this. *@
            <p class="faint">@L("crawler.page.empty")</p>
        }
        else
        {
            <dl class="identity mono">
                <dt class="kicker" translate="yes">@L("crawler.page.statusLabel")</dt>
                <dd>@CrawlerCopy.State(Tag, Pulse, Now)</dd>
                <dt class="kicker" translate="yes">@L("crawler.page.registryLabel")</dt>
                <dd>@CrawlerCopy.Registry(Tag, Pulse)</dd>

                @if (CrawlerCopy.FullCycle(Tag, Pulse) is { } cycle)
                {
                    <dt class="kicker" translate="yes">@L("crawler.page.cycleLabel")</dt>
                    <dd>
                        @cycle
                        @if (CrawlerCopy.CycleFinishedAt(Tag, Pulse) is { } finished)
                        {
                            <br /><span class="faint">@finished</span>
                        }
                    </dd>
                }
            </dl>

            <h2 class="kicker">@L("crawler.history.title")</h2>

            @if (Recent.Count == 0)
            {
                <p class="faint">@L("crawler.history.empty")</p>
            }
            else
            {
                <ul class="mono">
                    @foreach (var past in Recent)
                    {
                        <li>@Dates.Stamp(Tag, past.FinishedAt) — @CrawlerCopy.Cycle(Tag, past)</li>
                    }
                </ul>
            }

            <h2 class="kicker">@L("crawler.liveness.title")</h2>
            <p class="faint">@L("crawler.liveness.lede")</p>

            <div class="feeds">
                <section class="feed feed-dark" aria-labelledby="feed-dark">
                    <h3 id="feed-dark" class="kicker">@L("feed.wentDark")</h3>
                    @if (Feeds.WentDark.Count == 0)
                    {
                        <p class="faint">@L("feed.nothingDark")</p>
                    }
                    @foreach (var entry in Feeds.WentDark)
                    {
                        <FeedCard Entry="entry" Kind="FeedKind.WentDark" Now="Now" ShowRegister="false" />
                    }
                </section>

                <section class="feed feed-lit" aria-labelledby="feed-back">
                    <h3 id="feed-back" class="kicker">@L("feed.cameBack")</h3>
                    @if (Feeds.CameBack.Count == 0)
                    {
                        <p class="faint">@L("feed.nothingBack")</p>
                    }
                    @foreach (var entry in Feeds.CameBack)
                    {
                        <FeedCard Entry="entry" Kind="FeedKind.CameBack" Now="Now" ShowRegister="false" />
                    }
                </section>
            </div>

            <h2 class="kicker">@L("crawler.recent.title")</h2>
            <p class="faint">@L("crawler.recent.lede")</p>

            @if (RecentChanges.Count == 0)
            {
                <p class="faint">@L("crawler.recent.empty")</p>
            }
            else
            {
                <ul class="mono">
                    @foreach (var change in RecentChanges)
                    {
                        <li>
                            @Dates.Stamp(Tag, change.At) —
                            <a href="@Http.Link($"/g/{change.Slug}")">@change.Name</a>
                            @change.Field: @(change.OldValue is { } old ? $"{old} → {change.NewValue}" : change.NewValue)
                        </li>
                    }
                </ul>
            }

            <h2 class="kicker">@L("crawler.due.title")</h2>
            <p class="faint">@L("crawler.due.lede")</p>

            @if (DueSoon.Count == 0)
            {
                <p class="faint">@L("crawler.due.empty")</p>
            }
            else
            {
                <ul class="mono">
                    @foreach (var target in DueSoon)
                    {
                        <li>@Dates.Stamp(Tag, target.NextProbeAt) — @($"{target.Host}:{target.Port}")</li>
                    }
                </ul>
            }
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private DateTimeOffset Now => Clock.GetUtcNow();

    private CrawlerPulse Pulse = CrawlerPulse.Unknown;

    private IReadOnlyList<CrawlCycleRecord> Recent = [];

    private IReadOnlyList<RecentGameChange> RecentChanges = [];

    private IReadOnlyList<DueTarget> DueSoon = [];

    private LivenessFeeds Feeds = new([], [], []);

    protected override async Task OnParametersSetAsync()
    {
        // The three Pulses calls answer their own demo-safe fallback (Unknown / empty) for a missing
        // table or a failed query — see StoredCrawlerPulse. The two IGameQueries calls have no such
        // wrapper (production is NpgsqlGameQueries, and a query failing there throws), so they are
        // caught here on the same terms: a failed section reads as "nothing found", never a 500 for
        // the whole page over one section's query.
        Pulse = await Pulses.ReadAsync(Now);
        Recent = await Pulses.RecentAsync(10);
        DueSoon = await Pulses.DueSoonAsync(Now, 10);

        try
        {
            RecentChanges = await Queries.RecentFieldChangesAsync(10);
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not read the crawler's recent field changes; the status page omits them");
        }

        try
        {
            Feeds = await Queries.FeedsAsync();
        }
        catch (Exception error)
        {
            Logger.LogWarning(error, "Could not read the crawler's liveness feeds; the status page omits them");
        }
    }
}
