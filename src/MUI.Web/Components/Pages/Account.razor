@page "/account"
@using Microsoft.AspNetCore.Identity
@using MUI.Catalog
@using MUI.Catalog.Persistence
@using MUI.Web.Accounts
@using MUI.Web.Api
@using MUI.Web.Localization
@inject IGameQueries Queries
@inject IServiceProvider Services
@inject TimeProvider Clock

@*
    An operator's own page: games claimed, claims still pending, and account passkeys.

    Everything editable here is enrichment (spec §8.5) — nothing on this page can change a player
    count, a capability or a reachability history. The writable set is the field registry's own
    OwnerEnrichable flag; OwnerEnrichment refuses anything outside it, out loud.

    Details/summary rather than open forms, so a handful of claimed games stays readable and it
    still works with scripting off.
*@

<SitePreview Title="@PreviewCopy.Titles.Account(Tag)" Data="false"
             Description="@PreviewCopy.Pages.Account(Tag)" />

@if (Users is null)
{
    <section class="prose">
        <h1>@L("account.title")</h1>
        <p>@L("account.noDatabase")</p>
    </section>
}
else if (User is null)
{
    <section class="prose">
        <h1>@L("account.title")</h1>
        <p><a class="button" href="@HttpContext.Link("/account/sign-in")">@L("account.signInButton")</a></p>
    </section>
}
else
{
    <section class="prose">
        <h1>@L("account.title")</h1>
        @* The display name is the operator's own and goes in as an argument, never translatable
           text — the same rule that keeps a game's name out of the bundle. *@
        <p class="faint">@Say("account.signedInAs", ("name", User.DisplayName))</p>

        @if (Verified.Count == 0 && Pending.Count == 0)
        {
            @* Places its own link and control rather than English glued round an anchor, so a
               translator can reorder the sentence. *@
            <p>
                @foreach (var part in Sentence.Place(Tag, "account.empty.body", ["listing", "claimControl"]))
                {
                    @if (part.Slot is "listing")
                    {
                        <a href="@HttpContext.Link("/games")">@L("account.empty.listing")</a>
                    }
                    else if (part.Slot is "claimControl")
                    {
                        <em>@L("account.empty.claimControl")</em>
                    }
                    else
                    {
                        @part.Text
                    }
                }
            </p>
        }

        @* Else-if, not three independent blocks: a redirect carries exactly one outcome. *@
        @if (Resigned)
        {
            <p class="verified">
                <strong>@L("account.resigned.lead")</strong> @L("account.resigned.body")
            </p>
        }
        else if (Saved is not null)
        {
            <p class="verified"><strong>@L("account.saved.lead")</strong> @Outcome</p>
        }
        else if (RefusedField is { Length: > 0 })
        {
            @* Refused out loud (§8.5) — a silent no-op reads as broken, and a silent write to a
               measured field would make the site a self-report with extra steps. *@
            <p class="refused">
                @* The field name is the registry's own token and goes in as an argument. *@
                <strong>@Say("account.refused.lead", ("field", RefusedField))</strong>
                @if (string.Equals(Because, nameof(EnrichmentVerdict.TooLong), StringComparison.Ordinal))
                {
                    @Say("account.refused.tooLong", ("max", Ceiling))
                }
                else
                {
                    @L("account.refused.measured")
                }
            </p>
        }

        @if (Verified.Count > 0)
        {
            <h2>@L("account.claimed.heading")</h2>
            @foreach (var (claim, game) in Verified)
            {
                <details class="claim" open="@(Verified.Count == 1)">
                    <summary>
                        @* Through GameName: a bare right-to-left name renegotiates order with the
                           neutral characters and date beside it, and the line comes apart. *@
                        <a href="@HttpContext.Link($"/g/{game.Slug}")"><GameName Name="@game.Name" /></a>
                        @* A date about OUR record, never a measurement of the game. Written through
                           Dates.Absolute so the month is the reader's, not the invariant culture's. *@
                        <span class="faint">@ClaimNote(claim)</span>
                        @* §8.5's scorecard. Owner-only, so it is reachable from here and nowhere. *@
                        <a class="faint" href="@HttpContext.Link($"/g/{game.Slug}/mssp")">@L("account.claim.mssp")</a>
                    </summary>

                    @if (CoOwners(claim) is { Count: > 0 } others)
                    {
                        @* §8.5 — a game may have several owners, and each of them should know. *@
                        <p class="faint">
                            @Say(
                                "account.claim.coOwners",
                                ("count", others.Count),
                                ("names", string.Join(", ", others.Select(Name))))
                        </p>
                    }

                    @* Name="@game.Name" is not decoration — a string parameter written as
                       Name="game.Name" is a LITERAL, and every owner was shown "...about
                       game.Name" instead of the actual name. *@
                    <OwnerPanel GameId="game.Id"
                                Name="@game.Name"
                                Declared="DeclaredFor(game.Id)"
                                Reported="ReportedFor(game.Id)"
                                OptOut="CrawlFor(game.Id)"
                                Listing="ListingFor(game.Id)"
                                Now="Now" />

                    @* In the block's body, not its summary: a <details> inside a <summary> nests
                       interactive content in a control, which no browser owes a sane answer for. *@
                    @* The two addresses here carry no locale prefix, deliberately: the snippet is
                       markup an owner pastes on *their* site, and the badge answers the same bytes
                       to everybody — like /api/… and robots.txt. *@
                    <details class="publish">
                        <summary class="faint">@L("account.badge.summary")</summary>
                        <pre class="mono">&lt;a href="/g/@game.Slug"&gt;&lt;img src="/g/@game.Slug/badge.svg" alt="@game.Name on mu*index"&gt;&lt;/a&gt;</pre>
                        @* Three sentences rather than one with emphasis inside a clause a translator
                           cannot move. The badge words are the image's OWN bytes, placed as
                           arguments rather than translated. *@
                        @* Each placed sentence sits in its own <span>: Razor drops the whitespace on
                           a line that opens a code block, so two bare @foreach siblings would render
                           as "…answering.There is JSON too…" without it. *@
                        <p class="faint">
                            @L("account.badge.carries")
                            <span>
                                @foreach (var part in Sentence.Place(Tag, "account.badge.states", ["unknown", "archived"]))
                                {
                                    @if (part.Slot is "unknown")
                                    {
                                        <em translate="no">@BadgeReading.UnknownText</em>
                                    }
                                    else if (part.Slot is "archived")
                                    {
                                        <em translate="no">@BadgeReading.ArchivedText</em>
                                    }
                                    else
                                    {
                                        @part.Text
                                    }
                                }
                            </span>
                            <span>
                                @foreach (var part in Sentence.Place(Tag, "account.badge.json", ["json"]))
                                {
                                    @if (part.Slot is "json")
                                    {
                                        <a href="/g/@game.Slug/badge.json" translate="no">JSON</a>
                                    }
                                    else
                                    {
                                        @part.Text
                                    }
                                }
                            </span>
                        </p>
                    </details>

                    <details class="history">
                        <summary class="faint">@L("account.history.summary")</summary>
                        <ol class="events mono">
                            @foreach (var entry in History(claim))
                            {
                                <li>
                                    @* Machine spelling, out of the bundle — a localized log stamp
                                       would be a bug in every language at once. *@
                                    <span class="faint">@Stamp(entry.At)</span>
                                    @Word(entry.Kind)@(entry.Detail is { Length: > 0 } d ? $" · {d}" : string.Empty)
                                </li>
                            }
                        </ol>
                    </details>

                    @* Explicit and typed (§8.4): a bare button beside a game's name is one misclick
                       from a listing somebody no longer owns. *@
                    <details class="resign" open="@(Confirming == claim.Id)">
                        <summary class="faint">@L("account.resign.summary")</summary>
                        <form method="post" action="@HttpContext.Link($"/account/claims/{claim.Id}/resign")">
                            <AntiforgeryToken />
                            @* Placed, not translated — the endpoint compares against this literal,
                               and a translated word is one the form would refuse. *@
                            <p class="faint">
                                @foreach (var part in Sentence.Place(Tag, "account.resign.confirm", ["word"]))
                                {
                                    @if (part.Slot is "word")
                                    {
                                        <code translate="no">@OwnershipWrites.ResignConfirmation</code>
                                    }
                                    else
                                    {
                                        @part.Text
                                    }
                                }
                            </p>
                            <input type="text" name="confirm" autocomplete="off" />
                            <button type="submit" class="quiet">@Say("account.resign.button", ("game", game.Name))</button>
                        </form>
                    </details>
                </details>
            }
        }

        @if (Pending.Count > 0)
        {
            <h2>@L("account.pending.heading")</h2>
            <ul class="claims">
                @foreach (var (claim, game) in Pending)
                {
                    <li>
                        <a href="@HttpContext.Link($"/g/{game.Slug}/claim")"><GameName Name="@game.Name" /></a>
                        <span class="faint">
                            @Say(
                                "account.pending.dates",
                                ("issued", Dates.Absolute(Tag, claim.IssuedAt)),
                                ("expires", Dates.Absolute(Tag, claim.ExpiresAt)))
                        </span>
                    </li>
                }
            </ul>
        }

        <h2>@L("account.passkeys.heading")</h2>
        <ul class="passkeys">
            @foreach (var key in Keys)
            {
                <li>
                    @* A passkey's name is the authenticator's own bytes; only "unnamed" is ours and
                       goes through the bundle. *@
                    <span class="mono">@(key.Name ?? L("account.passkey.unnamed"))</span>
                    <span class="faint">
                        @Say(
                            key.IsBackedUp ? "account.passkey.added" : "account.passkey.addedOneDevice",
                            ("date", Dates.Absolute(Tag, key.CreatedAt)))
                    </span>
                </li>
            }
        </ul>

        @if (Keys.Any(k => !k.IsBackedUp) && Keys.Count == 1)
        {
            <p class="faint">@L("account.passkey.single")</p>
        }

        <form data-passkey="register" method="post" action="@HttpContext.Link("/account/passkey/register")">
            <button type="submit" disabled>@L("account.passkey.add")</button>
            <p class="faint" data-passkey-status></p>
        </form>

        <form method="post" action="@HttpContext.Link("/account/sign-out")">
            <AntiforgeryToken />
            <button type="submit" class="quiet">@L("account.signOut")</button>
        </form>
    </section>

    <script src="/passkey.js" defer></script>
}

@code {
    private UserManager<MuiUser>? Users { get; set; }

    private MuiUser? User { get; set; }

    private List<(GameClaim Claim, GameSummary Game)> Verified { get; set; } = [];

    private List<(GameClaim Claim, GameSummary Game)> Pending { get; set; } = [];

    private IList<UserPasskeyInfo> Keys { get; set; } = [];

    /// <summary>What each claimed game's owners have already declared, keyed by game.</summary>
    /// <remarks>Owner rows only. A measurement has no editable form on this site at all.</remarks>
    private Dictionary<Guid, IReadOnlyDictionary<string, GameField>> Owned { get; } = [];

    /// <summary>What each claimed game reports about itself, keyed by game.</summary>
    /// <remarks>Shown beside the override boxes, never used as their value.</remarks>
    private Dictionary<Guid, IReadOnlyDictionary<string, GameField>> Reports { get; } = [];

    /// <summary>§11's answer per game: which of its addresses we are still dialling.</summary>
    private Dictionary<Guid, OwnerOptOutState> Crawling { get; } = [];

    private Dictionary<Guid, OwnerListingState> Listings { get; } = [];

    /// <summary>
    /// What the last write did, carried back through a redirect (see <see cref="OwnerWrites"/>).
    /// </summary>
    /// <remarks>
    /// The querystring, because that is what survives a plain form post and a redirect — the whole
    /// write path works with scripting off (§8.2), except the WebAuthn ceremony itself.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "saved")]
    private string? Saved { get; set; }

    /// <summary>Which of the three writes just landed (see <see cref="OwnerWrites"/>).</summary>
    [SupplyParameterFromQuery(Name = "did")]
    private string? Did { get; set; }

    [SupplyParameterFromQuery(Name = "refused")]
    private string? Refused { get; set; }

    [SupplyParameterFromQuery(Name = "because")]
    private string? Because { get; set; }

    /// <summary>Every verified claim on each of this account's games, so co-owners can be named.</summary>
    private Dictionary<Guid, IReadOnlyList<GameClaim>> Owners { get; } = [];

    /// <summary>Each of this account's claims' audit log (spec §8.5).</summary>
    private Dictionary<Guid, IReadOnlyList<ClaimEvent>> Events { get; } = [];

    /// <summary>Display names for the accounts that co-own something here.</summary>
    private Dictionary<Guid, string> Names { get; } = [];

    [SupplyParameterFromQuery(Name = "resigned")]
    private string? ResignedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "resign")]
    private string? ResignFlag { get; set; }

    private bool Resigned => ResignedFlag is not null;

    private Guid? Confirming => Guid.TryParse(ResignFlag, out var id) ? id : null;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Tag => HttpContext.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    private string Say(string id, params (string Key, object? Value)[] args) =>
        Messages.Say(Tag, id, args);

    /// <summary>
    /// The enrichment ceiling, as a label rather than as a quantity.
    /// </summary>
    /// <remarks>
    /// A string, not a number argument — an ICU number formats for the locale, and past a thousand a
    /// German page would offer "1.000 characters", which reads as one to half of Europe.
    /// </remarks>
    private static string Ceiling =>
        OwnerEnrichment.MaxValueLength.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// One audit line's instant, in the machine spelling.
    /// </summary>
    /// <remarks>
    /// Invariant on purpose: a sortable instant, not a date somebody says out loud. The ambient
    /// culture would silently give a Japanese reader a different year number.
    /// </remarks>
    private static string Stamp(DateTimeOffset at) =>
        at.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private DateTimeOffset Now => Clock.GetUtcNow();

    /// <summary>The game a save landed on, if it is one this account holds.</summary>
    private string? SavedName => Guid.TryParse(Saved, out var id)
        ? Verified.FirstOrDefault(held => held.Game.Id == id).Game?.Name
        : null;

    /// <summary>
    /// What the last write actually did, in a sentence about that write.
    /// </summary>
    /// <remarks>
    /// One sentence per write kind (a new <c>Did</c> value needs a new branch here, not a default
    /// that lies about it — §11's two crawl outcomes were once left off this switch, so stopping a
    /// crawl reported the wrong thing happened). The game's name is an argument, not a prefix,
    /// so a language that puts the subject elsewhere has somewhere to say so.
    /// </remarks>
    private string Outcome
    {
        get
        {
            var game = SavedName ?? L("account.saved.thatGame");

            var id = Did switch
            {
                "screen-hidden" => "account.saved.screenHidden",
                "screen-shown" => "account.saved.screenShown",
                "crawl-stopped" => "account.saved.crawlStopped",
                "crawl-resumed" => "account.saved.crawlResumed",
                "unlisted" => "account.saved.unlisted",
                "relisted" => "account.saved.relisted",
                _ => "account.saved.fields",
            };

            return Say(id, ("game", game));
        }
    }

    /// <summary>
    /// The refused field name, bounded.
    /// </summary>
    /// <remarks>
    /// Echoed from the querystring and capped rather than trusted — printing whatever a crafted link
    /// put in front of it would be a billboard on somebody's own dashboard, escaped or not.
    /// </remarks>
    private string? RefusedField => Refused is { Length: > 0 } named
        ? named.Length <= 60 ? named : named[..60]
        : null;

    private IReadOnlyDictionary<string, GameField> DeclaredFor(Guid gameId) =>
        Owned.TryGetValue(gameId, out var declared)
            ? declared
            : new Dictionary<string, GameField>(StringComparer.Ordinal);

    /// <summary>What a game reports about itself, for the boxes that override a report.</summary>
    private IReadOnlyDictionary<string, GameField> ReportedFor(Guid gameId) =>
        Reports.TryGetValue(gameId, out var reported)
            ? reported
            : new Dictionary<string, GameField>(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Whether we are dialling this game, per address — or null where there is no register to ask.
    /// </summary>
    /// <remarks>
    /// Null, not an empty state — "we are crawling you" and "nothing here records whether we are"
    /// are different answers, and the panel offers the button only for the first.
    /// </remarks>
    private OwnerOptOutState? CrawlFor(Guid gameId) =>
        Crawling.TryGetValue(gameId, out var state) ? state : null;

    /// <summary>Whether this game is in the listing, or null where nothing here records it.</summary>
    private OwnerListingState? ListingFor(Guid gameId) =>
        Listings.TryGetValue(gameId, out var state) ? state : null;

    protected override async Task OnInitializedAsync()
    {
        Users = Services.GetService<UserManager<MuiUser>>();

        if (Users is null
            || Services.GetService<IClaimStore>() is not { } claims
            || HttpContext?.User is not { Identity.IsAuthenticated: true } principal)
        {
            return;
        }

        User = await Users.GetUserAsync(principal);

        if (User is null)
        {
            return;
        }

        Keys = await Users.GetPasskeysAsync(User);

        var now = Now;

        foreach (var claim in await claims.ForUserAsync(User.Id))
        {
            // Resolved one at a time: an operator holds a handful of games, not a page of them. If
            // that stops being true, this wants a batch read instead of a loop.
            if (await Queries.FindByIdAsync(claim.GameId) is not { } game)
            {
                continue;
            }

            if (claim.IsVerified)
            {
                Verified.Add((claim, game));

                if (Services.GetService<OwnerEnrichment>() is { } enrichment)
                {
                    Owned[game.Id] = await enrichment.DeclaredAsync(game.Id);
                    Reports[game.Id] = await enrichment.ReportedAsync(game.Id);
                }

                // §11, per address — read here so the panel renders from one pass.
                if (Services.GetService<OwnerOptOut>() is { } optOut)
                {
                    Crawling[game.Id] = await optOut.StateAsync(game.Id);
                }

                if (Services.GetService<OwnerListing>() is { } listing)
                {
                    Listings[game.Id] = await listing.StateAsync(game.Id);
                }

                if (Services.GetService<ClaimService>() is { } service)
                {
                    Owners[claim.Id] = await service.OwnersAsync(game.Id);
                    Events[claim.Id] = await service.HistoryAsync(claim.Id);

                    foreach (var owner in Owners[claim.Id].Where(o => o.UserId != User.Id))
                    {
                        // Never an address, never an identity claim (§8.2) — only their own chosen
                        // display name, shown only to people they share a game with.
                        Names.TryAdd(
                            owner.UserId,
                            (await Users.FindByIdAsync(owner.UserId.ToString()))?.DisplayName
                                ?? L("account.coOwner.unnamed"));
                    }
                }
            }
            else if (claim.IsPending(now))
            {
                Pending.Add((claim, game));
            }
        }
    }

    /// <summary>The other verified owners of this claim's game.</summary>
    private IReadOnlyList<GameClaim> CoOwners(GameClaim mine) =>
        Owners.TryGetValue(mine.Id, out var all)
            ? [.. all.Where(other => other.UserId != mine.UserId)]
            : [];

    private IReadOnlyList<ClaimEvent> History(GameClaim mine) =>
        Events.TryGetValue(mine.Id, out var events) ? events : [];

    private string Name(GameClaim claim) =>
        Names.TryGetValue(claim.UserId, out var name) ? name : L("account.coOwner.unnamed");

    /// <summary>
    /// One audit entry in words. The vocabulary is the enum's, spelled for a person.
    /// </summary>
    /// <remarks>
    /// <c>BeaconMissing</c> reads as an observation, not a warning: a probe not reading the token
    /// happens for reasons that have nothing to do with the owner, and absence never revokes (§8.4).
    /// </remarks>
    private string Word(ClaimEventKind kind) => L(kind switch
    {
        ClaimEventKind.Issued => "account.event.issued",
        ClaimEventKind.Reissued => "account.event.reissued",
        ClaimEventKind.Verified => "account.event.verified",
        ClaimEventKind.BeaconSeen => "account.event.beaconSeen",
        ClaimEventKind.BeaconMissing => "account.event.beaconMissing",
        ClaimEventKind.Revoked => "account.event.revoked",
        ClaimEventKind.Expired => "account.event.expired",
        ClaimEventKind.CounterClaimed => "account.event.counterClaimed",
        _ => "account.event.checkRequested",
    });

    /// <summary>
    /// When we verified this claim, and when a probe last read the token.
    /// </summary>
    /// <remarks>
    /// Both are facts about <em>our records</em>, never a measurement of the game. Two ids rather
    /// than one with a suffix appended, so a translator can move the beacon clause.
    /// </remarks>
    private string ClaimNote(GameClaim claim) =>
        claim.BeaconLastSeenAt is { } seen
            ? Say(
                "account.claim.verifiedAndSeen",
                ("date", Dates.Absolute(Tag, claim.ClaimedAt!.Value)),
                ("seen", Dates.Absolute(Tag, seen)))
            : Say("account.claim.verified", ("date", Dates.Absolute(Tag, claim.ClaimedAt!.Value)));
}
