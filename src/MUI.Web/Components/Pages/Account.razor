@page "/account"
@using Microsoft.AspNetCore.Identity
@using MUI.Catalog
@using MUI.Catalog.Persistence
@using MUI.Web.Accounts
@inject IGameQueries Queries
@inject IServiceProvider Services
@inject TimeProvider Clock

@*
    An operator's own page: the games they have claimed, the ones still waiting on a token, and the
    passkeys that reach the account.

    Everything editable from here is enrichment (spec §8.5) — an owner may add what MSSP has no
    field for, and their connect screen is theirs to withdraw (§11) — so there is nothing on this
    page that could change a player count, a capability or a reachability history. The writable set
    is the field registry's own OwnerEnrichable flag and is never repeated here; OwnerEnrichment
    refuses anything outside it, out loud, however the request was assembled.

    A claimed game is a collapsed block rather than a line, because an operator holds a handful of
    games and a page of five open forms is a page nobody reads. Details/summary, so it works with
    scripting off along with the rest of the write path.
*@

<PageTitle>Your games — mu*index</PageTitle>

@if (Users is null)
{
    <section class="prose">
        <h1>Your games</h1>
        <p>Accounts need a database behind them, and this site is running on the demo fixture.</p>
    </section>
}
else if (User is null)
{
    <section class="prose">
        <h1>Your games</h1>
        <p><a class="button" href="/account/sign-in">Sign in</a></p>
    </section>
}
else
{
    <section class="prose">
        <h1>Your games</h1>
        <p class="faint">Signed in as @User.DisplayName.</p>

        @if (Verified.Count == 0 && Pending.Count == 0)
        {
            <p>
                You have not claimed anything yet. Find your game in
                <a href="/games">the listing</a> and press <em>claim this game</em> on its page.
            </p>
        }

        @if (Saved is not null)
        {
            <p class="verified"><strong>Saved.</strong> @Outcome</p>
        }
        else if (RefusedField is { Length: > 0 })
        {
            @*
                Refused out loud (§8.5). A silent no-op teaches an owner that the site is broken, and
                a successful write to a measured field would make the whole site a self-report with
                extra steps — so the field is named and the reason is given.
            *@
            <p class="refused">
                <strong>@RefusedField was not changed.</strong>
                @if (string.Equals(Because, nameof(EnrichmentVerdict.TooLong), StringComparison.Ordinal))
                {
                    @($"These are one-line answers; {OwnerEnrichment.MaxValueLength} characters is the most we store.")
                }
                else
                {
                    @("That field is measured. A claim lets you add what MSSP has no room for; "
                        + "it never lets anybody edit what we observed, and that includes us.")
                }
            </p>
        }

        @if (Verified.Count > 0)
        {
            <h2>Claimed</h2>
            @foreach (var (claim, game) in Verified)
            {
                <details class="claim" open="@(Verified.Count == 1)">
                    <summary>
                        <a href="/g/@game.Slug">@game.Name</a>
                        <span class="faint">
                            verified @claim.ClaimedAt!.Value.ToString("d MMM yyyy")@(BeaconNote(claim))
                        </span>
                        @* §8.5's scorecard. Owner-only, so it is reachable from here and nowhere. *@
                        <a class="faint" href="/g/@game.Slug/mssp">check your MSSP</a>
                    </summary>
                    <OwnerPanel GameId="game.Id"
                                Name="game.Name"
                                Declared="DeclaredFor(game.Id)"
                                Now="Now" />

                    @*
                        §8.5's owner-published outputs. Shown here because this is where the person
                        who would paste it is, and shown as the exact line to copy — the same reason
                        the claim page prints the MSSP variable in full. In the block's body rather
                        than its summary: a <details> inside a <summary> is interactive content
                        nested in a control, which no browser owes anybody a sane answer for.
                    *@
                    <details class="publish">
                        <summary class="faint">put your player count on your own site</summary>
                        <pre class="mono">&lt;a href="/g/@game.Slug"&gt;&lt;img src="/g/@game.Slug/badge.svg" alt="@game.Name on mu*index"&gt;&lt;/a&gt;</pre>
                        <p class="faint">
                            The badge carries the count <em>and</em> when we measured it, because a
                            number with no age is the thing this site exists to replace. It says
                            <em>players unknown</em> rather than nought when we could not count, and
                            <em>archived</em> if the game stops answering. There is
                            <a href="/g/@game.Slug/badge.json">JSON</a> too, if you would rather draw
                            your own.
                        </p>
                    </details>
                </details>
            }
        }

        @if (Pending.Count > 0)
        {
            <h2>Waiting on a token</h2>
            <ul class="claims">
                @foreach (var (claim, game) in Pending)
                {
                    <li>
                        <a href="/g/@game.Slug/claim">@game.Name</a>
                        <span class="faint">
                            token issued @claim.IssuedAt.ToString("d MMM yyyy"), good until
                            @claim.ExpiresAt.ToString("d MMM yyyy")
                        </span>
                    </li>
                }
            </ul>
        }

        <h2>Passkeys</h2>
        <ul class="passkeys">
            @foreach (var key in Keys)
            {
                <li>
                    <span class="mono">@(key.Name ?? "unnamed")</span>
                    <span class="faint">
                        added @key.CreatedAt.ToString("d MMM yyyy")@(key.IsBackedUp ? string.Empty : " · on one device only")
                    </span>
                </li>
            }
        </ul>

        @if (Keys.Any(k => !k.IsBackedUp) && Keys.Count == 1)
        {
            <p class="faint">
                That passkey lives on one device rather than syncing. If you lose the device you can
                still get back in by publishing a fresh token on your game — but adding a second
                passkey is quicker.
            </p>
        }

        <form data-passkey="register" method="post" action="/account/passkey/register">
            <button type="submit" disabled>Add another passkey</button>
            <p class="faint" data-passkey-status></p>
        </form>

        <form method="post" action="/account/sign-out">
            <AntiforgeryToken />
            <button type="submit" class="quiet">Sign out</button>
        </form>
    </section>

    <script src="/passkey.js" defer></script>
}

@code {
    private UserManager<MuiUser>? Users { get; set; }

    private MuiUser? User { get; set; }

    private List<(GameClaim Claim, GameSummary Game)> Verified { get; set; } = [];

    private List<(GameClaim Claim, GameSummary Game)> Pending { get; set; } = [];

    private IList<UserPasskeyInfo> Keys { get; set; } = [];

    /// <summary>What each claimed game's owners have already declared, keyed by game.</summary>
    /// <remarks>
    /// Owner rows only, read once here and handed to the panels. The dashboard edits what owners
    /// wrote; a measurement has no editable form on this site at all.
    /// </remarks>
    private Dictionary<Guid, IReadOnlyDictionary<string, GameField>> Owned { get; } = [];

    /// <summary>
    /// What the last write did, carried back through a redirect (see <see cref="OwnerWrites"/>).
    /// </summary>
    /// <remarks>
    /// The querystring, because that is what survives a plain form post and a redirect — the whole
    /// write path works with scripting off, which §8.2 requires of everything but the WebAuthn
    /// ceremony itself.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "saved")]
    private string? Saved { get; set; }

    /// <summary>Which of the three writes just landed (see <see cref="OwnerWrites"/>).</summary>
    [SupplyParameterFromQuery(Name = "did")]
    private string? Did { get; set; }

    [SupplyParameterFromQuery(Name = "refused")]
    private string? Refused { get; set; }

    [SupplyParameterFromQuery(Name = "because")]
    private string? Because { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private DateTimeOffset Now => Clock.GetUtcNow();

    /// <summary>The game a save landed on, if it is one this account holds.</summary>
    private string? SavedName => Guid.TryParse(Saved, out var id)
        ? Verified.FirstOrDefault(held => held.Game.Id == id).Game?.Name
        : null;

    /// <summary>
    /// What the last write actually did, in a sentence about that write.
    /// </summary>
    /// <remarks>
    /// Three outcomes and not one, because hiding a connect screen used to report "now shows it as
    /// owner-declared" — the enrichment sentence, on a page whose whole job is to say what happened.
    /// </remarks>
    private string Outcome
    {
        get
        {
            var game = SavedName ?? "That game";

            return Did switch
            {
                "screen-hidden" =>
                    $"We have stopped republishing {game}'s connect screen. The page says so plainly "
                    + "rather than leaving a hole.",
                "screen-shown" => $"{game}'s connect screen is on its page again.",
                _ => $"{game}'s page now shows it as owner-declared.",
            };
        }
    }

    /// <summary>
    /// The refused field name, bounded.
    /// </summary>
    /// <remarks>
    /// It is echoed from the querystring, because that is the only thing that survives the redirect,
    /// and a field name is short — so the length is capped here rather than trusted. A page that
    /// printed whatever a crafted link put in front of it would be a billboard on somebody's own
    /// dashboard, escaped or not.
    /// </remarks>
    private string? RefusedField => Refused is { Length: > 0 } named
        ? named.Length <= 60 ? named : named[..60]
        : null;

    private IReadOnlyDictionary<string, GameField> DeclaredFor(Guid gameId) =>
        Owned.TryGetValue(gameId, out var declared)
            ? declared
            : new Dictionary<string, GameField>(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Users = Services.GetService<UserManager<MuiUser>>();

        if (Users is null
            || Services.GetService<IClaimStore>() is not { } claims
            || HttpContext?.User is not { Identity.IsAuthenticated: true } principal)
        {
            return;
        }

        User = await Users.GetUserAsync(principal);

        if (User is null)
        {
            return;
        }

        Keys = await Users.GetPasskeysAsync(User);

        var now = DateTimeOffset.UtcNow;

        foreach (var claim in await claims.ForUserAsync(User.Id))
        {
            // A claim names a game id; the listing names a slug. Resolved one at a time because an
            // operator holds a handful of games, not a page of them — if that stops being true this
            // wants a single query rather than a loop, and the shape of the fix is a batch read.
            if (await Queries.FindByIdAsync(claim.GameId) is not { } game)
            {
                continue;
            }

            if (claim.IsVerified)
            {
                Verified.Add((claim, game));

                if (Services.GetService<OwnerEnrichment>() is { } enrichment)
                {
                    Owned[game.Id] = await enrichment.DeclaredAsync(game.Id);
                }
            }
            else if (claim.IsPending(now))
            {
                Pending.Add((claim, game));
            }
        }
    }

    /// <summary>
    /// Says when the beacon was last seen, and never treats its absence as a problem.
    /// </summary>
    /// <remarks>
    /// Spec §8.4: presence establishes, absence never revokes. This is a note, not a warning — a
    /// missing beacon means a probe did not read one, which happens for reasons that have nothing to
    /// do with the owner, and alarming them about it would be the interface arguing for a rule the
    /// system does not have.
    /// </remarks>
    private static string BeaconNote(GameClaim claim) =>
        claim.BeaconLastSeenAt is { } seen
            ? $", token last seen {seen:d MMM yyyy}"
            : string.Empty;
}
