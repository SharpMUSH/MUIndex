@page "/g/{Slug}"
@using MUI.Web.Localization
@using MUI.Web.Data
@using MUI.Catalog.Persistence
@inject IGameQueries Queries
@inject IAvailabilityHistory History
@inject TimeProvider Clock
@inject IServiceProvider Services
@inject NavigationManager Navigation

@if (Page is not null)
{
    @* Above the plain switch: ?plain=1 is the same document and gets the same metadata, with a
       canonical URL that drops the query so one game isn't indexed as two. *@
    <SitePreview Title="@Page.Summary.Name"
                 Description="@PreviewCopy.ForGame(Http.LocaleOf().Tag, Page, Now)"
                 Card="PreviewCard.Game"
                 Graph="GraphFor" />
}

@if (Page is null)
{
    @* Not reached over HTTP — OnParametersSetAsync signals not-found and the framework answers with
       its own 404 page. This is what a headless render produces instead, with no response to
       status. *@
    <h1>@L("game.notFound")</h1>
    <p class="dim">@L("game.notFound.hint")</p>
}
else if (Plain)
{
    @* Plain mode is a real second surface, not a courtesy: if a fact cannot survive here, its
       graphic on the main page is decoration. Renders from the same view models (spec §9). *@
    <pre class="mono plain">@PlainText.Render(Page, Now, Reach, Trend, Http.LocaleOf().Tag)</pre>
}
else
{
    @* The game is the hero; the connect screen follows as evidence, rather than leading and handing
       the top of the page to whatever a stranger's server happens to send. *@
    <article class="game card-page @(Archived ? "archived" : null)">
        <header class="game-head">
          <div class="game-identity">
            @* The icon a game publishes, and nothing where it published none — a generated monogram
               would invent a brand the game never supplied. Indent collapses by itself: it's the
               row's gap, not a padding value. *@
            <GamePlate Slug="@Page.Summary.Slug" Name="@Page.Summary.Name"
                       HasIcon="Icon is not null" Size="64" />
            <div class="game-title">
                <h1><GameName Name="@Page.Summary.Name" /></h1>

                @* Where this game's people are, under its name and above everything we have to say
                   about it — a reader looking for the Discord finds it before reading a word of ours. *@
                <ReachRow Links="Page.Links" Now="Now" />

                @if (Archived)
                {
                    <p class="badges"><span class="badge archived">@L("facet.archived")</span></p>
                }
                @if (Page.Summary.Tagline is { } tagline)
                {
                    <p class="tagline dim">@tagline</p>
                }
                @if (LocalizedLede is { } description)
                {
                    <p class="lede">@description</p>
                }
                @* The claim state as one sentence rather than a badge and a paragraph three blocks
                   apart. A link and not a button — nothing happens until they are signed in
                   (spec §8.1). *@
                @if (Page.Summary.IsClaimed)
                {
                    <p class="claim-line dim">
                        @L("game.claimed")
                    </p>
                }
                else if (!Archived)
                {
                    <p class="claim-line dim">
                        @L("game.unclaimed")
                        @if (Claimable)
                        {
                            @* A bare space here is whitespace-only text next to a Razor code block,
                               which the compiler drops — without this escape the sentence and link
                               ran together with no space between them. *@
                            <text>&#32;</text><a href="@Http.Link($"/g/{Page.Summary.Slug}/claim")">@L("game.claim")</a>
                        }
                    </p>
                }

                @* The address, nested in the title's own column so the indent collapses when there
                   is no logo. Current addresses first, then departed ones — rendered rather than
                   dropped, since §7.5's promise that nothing is deleted is invisible otherwise. Lines
                   rather than boxes: a bordered panel gave a hostname the furniture of a card on a
                   page whose only framed thing is the connect screen. *@
                @foreach (var e in Page.Endpoints.OrderByDescending(e => e.IsCurrent).ThenBy(e => e.Port))
                {
                    <p class="endpoint mono @(e.IsCurrent ? null : "former")" translate="no">
                        <span class="address">@e.Host @e.Port</span>
                        @if (e.TlsMeasured)
                        {
                            <span class="state-present">● tls</span>
                        }
                        @if (e.IsCurrent)
                        {
                            <span class="faint">@L("game.answeringSince", ("date", Dates.Absolute(Http.LocaleOf().Tag, e.FirstSeenAt)))</span>
                        }
                        else
                        {
                            @* Named as ours to have stopped reaching, never as theirs to have gone.
                               The state itself is the catalogue's own token and stays machine voice. *@
                            <span class="faint">
                                <span translate="no">@e.State</span> — @L("game.endpoint.lastAnswered")
                                <Moment At="e.LastSeenAt" Now="Now" Ago="true" Spoken="true" />
                            </span>
                        }
                    </p>
                }

                @* How this site came to know about the game, and when. A statement about our own
                   crawl, deliberately dated: the channel on its own would read as a claim about
                   where the game came from, which is not a thing we know — any game worth listing
                   appears in several places at once. Absent for every game listed before the column
                   existed, and silence is the right answer there rather than a guess. *@
                @if (Page.DiscoveredVia is { } via && Page.Summary.FirstSeenAt is { } found)
                {
                    <p class="faint discovery">
                        @DiscoveryLine.FirstSeen(
                            Http.LocaleOf().Tag, via, Dates.Absolute(Http.LocaleOf().Tag, found))
                    </p>
                }
            </div>
          </div>

            @*
                The figure and the kicker that dates it read as one block, since a count is only as
                good as the probe that produced it.

                "connected" and not "players on now": the crawler counts open connections, and one
                person with two clients is two connections.
            *@
            <div class="game-figure">
                @if (Page.Summary.PlayersNow is { } n)
                {
                    <p class="figure-count mono @(Counted?.IsMeasured is false ? "declared" : null)">
                        @n <span class="unit">@L("term.connected")</span>
                    </p>
                    <p class="kicker figure-age">
                        @L(Counted?.IsMeasured is false ? "kicker.declared" : "kicker.measured")
                        <Moment At="@(Counted?.LastConfirmedAt ?? Now)" Now="Now" Ago="true" Spoken="true" />
                    </p>
                }
                else
                {
                    @*
                        Never a zero and never a blank — different facts, only one a measurement.
                        And never "not counted" either: that's the glossary's word for rule 2's
                        middle state, but a null count here is every state at once — unmeasured,
                        uncountable, or stale — and nothing on this page can tell them apart. Naming
                        the middle one would file our own silence as a probe of theirs (rule 5), so
                        the figure states the absence and leaves the cause to the strip and grid
                        below, which *can* tell them apart.
                    *@
                    <p class="figure-count mono unknown">@L("game.count.none")</p>
                    <p class="kicker figure-age">@L("game.count.none.why")</p>
                }
            </div>
        </header>

        @if (Archived)
        {
            <div class="archive-plate">
                <p>
                    @L("game.archived.lastAnswered",
                        ("date", Entry.LastAnswered(Http.LocaleOf().Tag)), ("ago", Entry.DarkFor(Http.LocaleOf().Tag, Now)))
                    @L("game.archived.stillProbed")
                </p>
                @if (Entry.Run(Http.LocaleOf().Tag) is { } run)
                {
                    <p class="mono faint">
                        <span translate="no">@run</span> ·
                        @L("game.archived.knownLive", ("span", Entry.KnownLiveWording(Http.LocaleOf().Tag)))
                    </p>
                }
            </div>
        }

        @*
            The two plates say different things because the decisions are different. An exclusion is
            OURS and has to be arguable, so it prints the argument. An unlisting is THEIRS, so it
            prints no reason at all — publishing our paraphrase of somebody's take-down request would
            be answering it with a smaller version of itself.
        *@
        @if (Excluded)
        {
            <div class="archive-plate">
                <p>@L("game.excluded")</p>
                @if (Page.ExcludedReason is { Length: > 0 } why)
                {
                    <p class="faint">@L("game.excluded.reason", ("why", why))</p>
                }
            </div>
        }
        else if (Unlisted)
        {
            <div class="archive-plate">
                <p>@L("game.unlisted")</p>
            </div>
        }

        @* One column, not two: a right rail put the DOM's whole left column ahead of a panel the eye
           meets at the top right, so the tab key ran to the bottom and jumped back up. *@
        <div class="game-body">

        <section aria-labelledby="screen-heading">
            <h2 id="screen-heading">@L("game.connectScreen")</h2>
            <AnsiQuote Screen="ConnectScreen" CapturedAt="Captured" Now="Now"
                       Name="@Page.Summary.Name"
                       Frozen="@(Archived || Unlisted)"
                       Charset="@Page.ConnectScreenCharset" />
        </section>

            <section aria-labelledby="activity-heading">
                @* "Connections by hour" and not "when people are on": naming it for people is a
                   claim about who is behind a connection that no probe can make. *@
                <h2 id="activity-heading">@L("game.connectionsByHour")</h2>
                <ActivityHeatmap Cells="Page.Activity" />

                @* The heatmap above folds every week into one grid, answering "when is anyone on"
                   and destroying "is this game growing" — a game that doubled and one that halved
                   draw the same 168 cells. This is the second question. *@
                @if (Trend is not null)
                {
                    <h2 id="trend-heading">@L("game.howMany")</h2>
                    <PresenceTrend Series="Trend" Shape="Shape" />

                    @* The range is in the address, so seeking is links and needs no script. *@
                    @* The option you are already on is not a link to itself — no keystroke lands on
                       a control whose only effect is to re-fetch the page you're reading. *@
                    <nav class="spans" aria-label="@L("trend.spans.label")">
                        @foreach (var days in RangePresets)
                        {
                            @if (Range.Covers(days, Today))
                            {
                                <span class="span on" aria-current="true">@L("trend.preset", ("days", days))</span>
                            }
                            else
                            {
                                <a href="@RangeHref(TrendRange.Preset(days, Today))" class="span">@L("trend.preset", ("days", days))</a>
                            }
                        }
                        <a class="span" href="@RangeHref(Range.Previous())" rel="prev">@L("trend.earlier")</a>
                        @if (Range.Next(Today) is { } next)
                        {
                            <a class="span" href="@RangeHref(next)" rel="next">@L("trend.later")</a>
                        }
                    </nav>

                    @* And the shape, same reasoning: neither drawing is right for every game — see
                       TrendShape — so it's a link rather than a preference. *@
                    <nav class="spans shapes" aria-label="@L("trend.shapes.label")">
                        @foreach (var shape in new[] { TrendShape.Line, TrendShape.Bar })
                        {
                            @if (Shape == shape)
                            {
                                <span class="span on" aria-current="true">@shape.Label(Tag)</span>
                            }
                            else
                            {
                                <a href="@ShapeHref(shape)" class="span">@shape.Label(Tag)</a>
                            }
                        }
                    </nav>
                }

                <h2>@L("game.reachable")</h2>
                <AvailabilityStrip Summary="Reach" />

                @*
                    §9's referral neighbours. Split by direction on purpose: "we list them" is a fact
                    about what THIS game published, "they list us" is a fact about what somebody else
                    published — one combined list would attribute each to the other.
                *@
                @if (Page.Referrals.Count > 0)
                {
                    <h2>@L("game.referrals")</h2>

                    @foreach (var group in Page.Referrals.GroupBy(n => n.Direction))
                    {
                        <p class="faint">
                            @L(group.Key is ReferralDirection.Lists
                                ? "game.referrals.lists"
                                : "game.referrals.listedBy")
                        </p>
                        <ul class="neighbours">
                            @foreach (var neighbour in group)
                            {
                                <li class="@(neighbour.Present ? null : "former")">
                                    <a href="@Http.Link($"/g/{neighbour.Slug}")">@neighbour.Name</a>
                                    @if (neighbour.Present)
                                    {
                                        <span class="faint">
                                            @L("game.referral.since", ("date", Dates.Absolute(Http.LocaleOf().Tag, neighbour.FirstSeenAt)))
                                        </span>
                                    }
                                    else
                                    {
                                        @* Dropped from the list, not deleted — the edge is kept. *@
                                        <span class="faint">
                                            @L("game.referral.dropped")
                                            <Moment At="neighbour.LastSeenAt" Now="Now" Ago="true" />
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }

                @if (Page.Changes.Count > 0)
                {
                    <h2 id="changed">@L("game.whatChanged")</h2>
                    <ol class="changes mono">
                        @foreach (var change in Page.Changes.OrderByDescending(c => c.At))
                        {
                            <li>
                                @* One date format, site-wide — this list, the address line, and the
                                   rankings used to each say it differently. *@
                                <span class="faint">@Dates.Absolute(Http.LocaleOf().Tag, change.At)</span> @change.Summary
                            </li>
                        }
                    </ol>
                }
            </section>

            <section aria-labelledby="capabilities" class="cap-section">
                <CapabilityMatrix Rows="Page.Capabilities" Now="Now" />

                <h2 id="declared">@L("game.declaredByGame")</h2>
                <dl class="declared">
                    @* The field name is the MSSP token the game itself published, lowercased — an
                       open set we could not translate without inventing a word for `FANDOM`. *@
                    @foreach (var (name, chip) in Page.Declared)
                    {
                        <dt class="kicker" translate="no">@name</dt>
                        <dd><Chip Fact="chip" Now="Now" /></dd>
                    }
                </dl>
                @if (StaleCount > 0)
                {
                    <p class="note faint">@L("game.stale", ("count", StaleCount))</p>
                }
            </section>

        </div>
    </article>
}

@code {
    /// <summary>
    /// Whether claiming is available at all — it needs a database, and the demo has none.
    /// </summary>
    /// <remarks>
    /// Asked of the container so the page and the endpoints cannot disagree about whether accounts
    /// exist.
    /// </remarks>
    private bool Claimable => Services.GetService<MUI.Catalog.Persistence.ClaimService>() is not null;

    [Parameter] public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    /// <summary>The first and last day of the trend range, as <c>yyyy-MM-dd</c>.</summary>
    /// <remarks>
    /// Clamped rather than validated: see <see cref="TrendRange.Parse"/>. What the reader gets is
    /// always printed over the graphic, so an adjusted range says so rather than silently drawing a
    /// different one.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "from")] private string? RangeFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")] private string? RangeTo { get; set; }

    /// <summary>Which drawing of the trend: <c>line</c> or <c>bar</c>.</summary>
    /// <remarks>
    /// Anything else falls back to the line rather than erroring; the selector under the graphic
    /// shows which shape the reader actually got.
    /// </remarks>
    [SupplyParameterFromQuery(Name = TrendShapes.Query)] private string? ChartShape { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    /// <summary>The widths the presets offer, ending today.</summary>
    private static readonly int[] RangePresets = [30, 90, 365];

    private GamePage? Page;

    private TrendSeries? Trend;

    private DateOnly Today => DateOnly.FromDateTime(Now.UtcDateTime);

    private TrendRange Range => TrendRange.Parse(RangeFrom, RangeTo, Today);

    private TrendShape Shape => TrendShapes.Parse(ChartShape);

    /// <summary>
    /// The address of one range, keeping whatever else the reader is already looking at.
    /// </summary>
    /// <remarks>
    /// A query with no path in front of it, meaning <em>this page, asked differently</em> — only
    /// worked once <c>&lt;base href="@Http.Link("/")"&gt;</c> was gone from <c>App.razor</c>, since a
    /// base resolves a query-only href against itself.
    /// </remarks>
    private string RangeHref(TrendRange range) => Href(range, Shape);

    /// <summary>The address of one shape, over the range the reader is already looking at.</summary>
    private string ShapeHref(TrendShape shape) => Href(Range, shape);

    private string Href(TrendRange range, TrendShape shape)
    {
        var query = $"?{range.Query}";

        // The default is left out, so the address a reader copies says only what they chose.
        if (shape is not TrendShape.Line)
        {
            query += $"&{TrendShapes.Query}={shape.Slug()}";
        }

        return Plain ? $"{query}&plain=1" : query;
    }

    /// <summary>
    /// The icon we hold for this game, or null — which covers "the field names none", "we could not
    /// fetch it" and "no database behind this site" alike.
    /// </summary>
    /// <remarks>
    /// Service-located like <see cref="Claimable"/>: the store is registered only when a connection
    /// string is, so the demo fixture renders the monogram exactly as a game with no icon does. A
    /// failed fetch is our afternoon and not a fact about the game (rule 5), so it gets no sentence,
    /// no placeholder and no broken image.
    /// </remarks>
    private GameIcon? Icon;
    private ReachSummary Reach = default!;
    private ArchiveEntry Entry = default!;
    private AnsiScreen ConnectScreen = default!;

    private DateTimeOffset Now => Clock.GetUtcNow();

    /// <summary>
    /// The schema.org graph for this game, built once the origin is known.
    /// </summary>
    /// <remarks>
    /// Handed to <c>SitePreview</c> as a function rather than a string, since only that component
    /// knows the absolute origin and whether a catalogue exists at all. Never called over the demo
    /// fixture — nothing reading a graph would see the banner saying the games are invented.
    /// </remarks>
    private string GraphFor(Uri origin) => GameStructuredData.For(Page!, origin);

    private bool Archived => Page?.Summary.State is LifecycleState.Archived;

    private bool Excluded => Page?.Summary.State is LifecycleState.Excluded;

    private bool Unlisted => Page?.Summary.State is LifecycleState.Unlisted;

    /// <summary>
    /// When what is on this page was last true.
    /// </summary>
    /// <remarks>
    /// An unlisted game is frozen for the same reason an archived one is: its connect screen is dated
    /// from the last probe that answered, not presented as minutes old. Saying "just now" over a
    /// capture from before somebody asked us to stop would be the freshest lie on the page.
    /// </remarks>
    private DateTimeOffset? Captured =>
        Archived || Unlisted ? Entry.LastReachableAt : Now.AddMinutes(-4);

    private int StaleCount => Page?.Declared.Count(d => d.Value.IsStale) ?? 0;

    /// <summary>The label on the live count, or null where there is no count to label.</summary>
    private ProvenanceChip? Counted => Page?.Summary.PlayersNowProvenance;

    protected override async Task OnParametersSetAsync()
    {
        Page = await Queries.FindAsync(Slug);

        Icon = Page is not null && Services.GetService<IIconStore>() is { } icons
            ? await icons.ForGameAsync(Page.Summary.Id)
            : null;

        // Service-located like the icon store above: a deployment without a trend source renders
        // the page without the chart rather than failing entirely.
        Trend = Page is not null && Services.GetService<IPresenceTrends>() is { } trends
            ? await trends.ForGameAsync(Page.Summary.Id, Range.From, Range.To)
            : null;

        if (Page is null)
        {
            // A slug a game used to have is redirected before this page is reached (§5.7), so
            // arriving here means no game ever answered to this URL — a 200 would tell a crawler to
            // index a page about a game that does not exist. Under a request this yields a 404;
            // under the headless renderer the tests use it does nothing, which is what the block at
            // the top of this file is still for.
            Navigation.NotFound();
            return;
        }

        var intervals = await History.ForGameAsync(Page.Summary.Id);
        Reach = ReachSeries.Build(intervals, Now);
        Entry = ArchiveEntry.For(Page.Summary, intervals, Now);
        ConnectScreen = Ansi.Parse(Page.ConnectScreen, Page.ConnectScreenSuppressed);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// The game's own description, in whichever <c>DESCRIPTION-&lt;lang&gt;</c> the browser asked
    /// for, if it published one — plain <c>DESCRIPTION</c> otherwise.
    /// </summary>
    /// <remarks>
    /// A content-language match against what THIS game published, not <see cref="Tag"/> — the site's
    /// interface locale is a different question. See <see cref="LocalizedDescription"/>.
    /// </remarks>
    private string? LocalizedLede => Page is null
        ? null
        : LocalizedDescription.Choose(
            Http?.Request.Headers.AcceptLanguage.ToString(), Page.Description, Page.Declared);

    private string L(string id) => Messages.For(Tag, id);

    private string L(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));
}
