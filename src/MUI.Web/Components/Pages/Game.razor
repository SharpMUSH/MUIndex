@page "/g/{Slug}"
@using MUI.Web.Localization
@using MUI.Web.Data
@using MUI.Catalog.Persistence
@inject IGameQueries Queries
@inject IAvailabilityHistory History
@inject TimeProvider Clock
@inject IServiceProvider Services
@inject NavigationManager Navigation

@if (Page is not null)
{
    @*
        Above the plain switch and outside it, because ?plain=1 is the same document rendered for a
        text browser and gets the same metadata — its canonical URL is this page without the query,
        which is what stops one game being indexed as two.
    *@
    <SitePreview Title="@Page.Summary.Name"
                 Description="@PreviewCopy.ForGame(Page, Now)"
                 Card="PreviewCard.Game"
                 Graph="GraphFor" />
}

@if (Page is null)
{
    @* Not reached over HTTP: OnParametersSetAsync signals not-found, and the framework answers with
       the site's own page and a 404 rather than with this. It is what a headless render of this
       component produces, where there is no response to give a status line to. *@
    <h1>Not found</h1>
    <p class="dim">No game at this address. Check the spelling.</p>
}
else if (Plain)
{
    @* Plain mode is a real second surface, not a courtesy. If a fact cannot survive here, its
       graphic on the main page is decoration. It renders from the same view models — this page is
       the graphical one with the graphics removed, which is what bounds its cost (spec §9). *@
    <pre class="mono plain">@PlainText.Render(Page, Now, Reach, Trend)</pre>
}
else
{
    @* The game is the hero; the connect screen follows as evidence. Leading with the art would hand
       the top of every page to whatever a stranger's server happens to send. *@
    <article class="game card-page @(Archived ? "archived" : null)">
        <header class="game-head">
          <div class="game-identity">
            @*
                The icon a game publishes, and nothing where it published none. No monogram, no grey
                square, no initial in a circle: an empty frame on five hundred pages is noise, and a
                generated monogram invents a brand the game never supplied — which on a site that
                publishes only what it measured is the one decoration that costs something. The
                indent collapses by itself, because it is the row's gap and not a padding value.
            *@
            <GamePlate Slug="@Page.Summary.Slug" Name="@Page.Summary.Name"
                       HasIcon="Icon is not null" Size="64" />
            <div class="game-title">
                <h1><GameName Name="@Page.Summary.Name" /></h1>
                @if (Archived)
                {
                    <p class="badges"><span class="badge archived">@L("facet.archived")</span></p>
                }
                @if (Page.Summary.Tagline is { } tagline)
                {
                    <p class="tagline dim">@tagline</p>
                }
                @if (Page.Description is { } description)
                {
                    <p class="lede">@description</p>
                }
                @*
                    The claim state as one sentence rather than a badge and a paragraph three blocks
                    apart. "Unclaimed" was a pill on the page and the same fact was restated below in
                    prose; the invitation sits with the fact because an owner arriving at their own
                    listing is the one reader for whom it is an action. A link and not a button —
                    nothing happens until they are signed in (spec §8.1).
                *@
                @if (Page.Summary.IsClaimed)
                {
                    <p class="claim-line dim">
                        @L("game.claimed")
                    </p>
                }
                else if (!Archived)
                {
                    <p class="claim-line dim">
                        @L("game.unclaimed")
                        @if (Claimable)
                        {
                            <a href="/g/@Page.Summary.Slug/claim">@L("game.claim")</a>
                        }
                    </p>
                }

                @*
                    The address, inside the title's own column and sharing its left edge. It used to
                    be a sibling of the outer row, beside the count — so it hung under the logo and
                    read as belonging to it, and on a game with no logo it sat in a column of its
                    own for no reason. Nested like this the indent is the title's, and it collapses
                    to nothing by itself when there is no logo.

                    Current addresses first, then the ones the game has left. A departed address is
                    rendered rather than dropped, because the reader most in need of this page is the
                    one holding an address that stopped answering — and §7.5's promise that nothing is
                    deleted is invisible if the row is simply not shown.
                *@
                @*
                    The addresses, as lines rather than boxes. Each was a bordered panel the full
                    width of the title column, which gave a hostname the furniture of a card on a
                    page whose only framed thing is the connect screen — somebody else's output,
                    quoted.
                *@
                @foreach (var e in Page.Endpoints.OrderByDescending(e => e.IsCurrent).ThenBy(e => e.Port))
                {
                    <p class="endpoint mono @(e.IsCurrent ? null : "former")" translate="no">
                        <span class="address">@e.Host @e.Port</span>
                        @if (e.TlsMeasured)
                        {
                            <span class="state-present">● tls</span>
                        }
                        @if (e.IsCurrent)
                        {
                            <span class="faint">@L("game.answeringSince", ("date", Dates.Absolute(e.FirstSeenAt)))</span>
                        }
                        else
                        {
                            @* Named as ours to have stopped reaching, never as theirs to have gone. *@
                            <span class="faint">
                                @e.State — last answered <Moment At="e.LastSeenAt" Now="Now" Ago="true" Spoken="true" />
                            </span>
                        }
                    </p>
                }
            </div>
          </div>

            @*
                The figure, and the kicker that dates it. Both are one fact — a count is only as good
                as the probe that produced it — so they read as one block at the far end of the
                header rather than as a number and a chip on one line.

                "connected" and not "players on now": the crawler counts open connections, not
                people, and one person with two clients is two connections. The word that localizes
                cleanly is the one that is true.
            *@
            <div class="game-figure">
                @if (Page.Summary.PlayersNow is { } n)
                {
                    <p class="figure-count mono @(Counted?.IsMeasured is false ? "declared" : null)">
                        @n <span class="unit">@L("term.connected")</span>
                    </p>
                    <p class="kicker figure-age">
                        @L(Counted?.IsMeasured is false ? "kicker.declared" : "kicker.measured")
                        <Moment At="@(Counted?.LastConfirmedAt ?? Now)" Now="Now" Ago="true" Spoken="true" />
                    </p>
                }
                else
                {
                    @* Never a zero and never a blank: those are different facts and only one of
                       them is a measurement. *@
                    <p class="figure-count mono unknown">@L("state.notCounted")</p>
                    <p class="kicker figure-age">@L("game.unknownCount")</p>
                }
            </div>
        </header>

        @if (Archived)
        {
            <div class="archive-plate">
                <p>
                    Last answered <strong>@Entry.LastAnswered</strong>, @Entry.DarkFor(Now) ago.
                    Still probed weekly; this page updates the day it answers.
                </p>
                @if (Entry.Run is { } run)
                {
                    <p class="mono faint">@run · @Entry.KnownLiveWording known live</p>
                }
            </div>
        }

        @*
            The other two ways out of the listing, which had no copy at all until now: migration 0024
            shipped `excluded` with a reason column and nothing that printed it, so a reader who
            arrived at one of the nine stock instances saw an ordinary page and no sign that anybody
            had decided anything about it.

            The two plates say different things because the decisions are different. An exclusion is
            OURS and has to be arguable, so it prints the argument. An unlisting is THEIRS, so it
            prints no reason at all — publishing our paraphrase of somebody's request on the page they
            asked us to take down would be answering it with a smaller version of itself.
        *@
        @if (Excluded)
        {
            <div class="archive-plate">
                <p>
                    Not in the listing, the rankings or the daily figure: we do not think this address
                    is a game somebody can play. Everything below is what it told us, unchanged.
                </p>
                @if (Page.ExcludedReason is { Length: > 0 } why)
                {
                    <p class="faint">Our reason: @why</p>
                }
            </div>
        }
        else if (Unlisted)
        {
            <div class="archive-plate">
                <p>
                    Not in the listing, the rankings or the daily figure, at the request of the people
                    who run it. Everything below is preserved as it was, this page and every address
                    it has ever had go on answering, and we are not dialling it.
                </p>
            </div>
        }

        @*
            One column. The page was two — the charts on the left, capabilities and the declared
            fields in a right rail — which put the DOM's whole left column ahead of a panel the eye
            meets at the top right, so the tab key ran to the bottom of the page and jumped back up.
            Stacked, reading order and focus order are the same order.
        *@
        <div class="game-body">

        <section aria-labelledby="screen-heading">
            <h2 id="screen-heading">@L("game.connectScreen")</h2>
            <AnsiQuote Screen="ConnectScreen" CapturedAt="Captured" Now="Now"
                       Name="@Page.Summary.Name"
                       Frozen="@(Archived || Unlisted)"
                       Charset="@Page.ConnectScreenCharset" />
        </section>

            <section aria-labelledby="activity-heading">
                @*
                    "Connections by hour" and not "when people are on": the grid counts connections,
                    which is what the crawler can see, and naming it for people is a claim about who
                    is behind them that no probe can make.
                *@
                <h2 id="activity-heading">@L("game.connectionsByHour")</h2>
                <ActivityHeatmap Cells="Page.Activity" />

                @*
                    The heatmap above folds every week measured into one grid, which answers "when
                    is anyone on" and destroys "is this game growing" — a game that doubled last
                    month and one that halved draw the same 168 cells. This is the second question.
                *@
                @if (Trend is not null)
                {
                    <h2 id="trend-heading">@L("game.howMany")</h2>
                    <PresenceTrend Series="Trend" Shape="Shape" />

                    @* The range is in the address, so seeking is links and needs no script. *@
                    @*
                        The option you are already on is not a link to itself. A pressed state, said
                        with aria-current and drawn with the accent — the pair reads as a toggle
                        because it is one, and there is no keystroke that lands on a control whose
                        only effect is to re-fetch the page you are reading.
                    *@
                    <nav class="spans" aria-label="Trend range">
                        @foreach (var days in RangePresets)
                        {
                            @if (Range.Covers(days, Today))
                            {
                                <span class="span on" aria-current="true">@days days</span>
                            }
                            else
                            {
                                <a href="@RangeHref(TrendRange.Preset(days, Today))" class="span">@days days</a>
                            }
                        }
                        <a class="span" href="@RangeHref(Range.Previous())" rel="prev">← earlier</a>
                        @if (Range.Next(Today) is { } next)
                        {
                            <a class="span" href="@RangeHref(next)" rel="next">later →</a>
                        }
                    </nav>

                    @*
                        And the shape, for the same reason and in the same way. Neither drawing is
                        right for every game on the site — see TrendShape — so it is a link rather
                        than a preference, and a reader who found the one they wanted can send it.
                    *@
                    <nav class="spans shapes" aria-label="Trend shape">
                        @foreach (var shape in new[] { TrendShape.Line, TrendShape.Bar })
                        {
                            @if (Shape == shape)
                            {
                                <span class="span on" aria-current="true">@shape.Label()</span>
                            }
                            else
                            {
                                <a href="@ShapeHref(shape)" class="span">@shape.Label()</a>
                            }
                        }
                    </nav>
                }

                <h2>@L("game.reachable")</h2>
                <AvailabilityStrip Summary="Reach" />

                @*
                    §9's referral neighbours, off edges the crawler has been storing since migration
                    0006 and nothing has read. Split by direction on purpose: "we list them" is a
                    fact about what THIS game published, and "they list us" is a fact about what
                    somebody else published. One combined list would attribute each to the other,
                    and neither is a claim that the two games are related.
                *@
                @if (Page.Referrals.Count > 0)
                {
                    <h2>@L("game.referrals")</h2>

                    @foreach (var group in Page.Referrals.GroupBy(n => n.Direction))
                    {
                        <p class="faint">
                            @(group.Key is ReferralDirection.Lists
                                ? "This game's own referral list names:"
                                : "Named by the referral list of:")
                        </p>
                        <ul class="neighbours">
                            @foreach (var neighbour in group)
                            {
                                <li class="@(neighbour.Present ? null : "former")">
                                    <a href="/g/@neighbour.Slug">@neighbour.Name</a>
                                    @if (neighbour.Present)
                                    {
                                        <span class="faint">
                                            since @Dates.Absolute(neighbour.FirstSeenAt)
                                        </span>
                                    }
                                    else
                                    {
                                        @* Dropped from the list, not deleted — the edge is kept. *@
                                        <span class="faint">
                                            no longer listed, last seen
                                            <Moment At="neighbour.LastSeenAt" Now="Now" Ago="true" />
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }

                @if (Page.Changes.Count > 0)
                {
                    <h2 id="changed">@L("game.whatChanged")</h2>
                    <ol class="changes mono">
                        @foreach (var change in Page.Changes.OrderByDescending(c => c.At))
                        {
                            <li>
                                @* One date format, site-wide: this list said 2026-08-17 while the
                                   address line above it said Aug 2026 and the rankings said
                                   31 July 2026. *@
                                <span class="faint">@Dates.Absolute(change.At)</span> @change.Summary
                            </li>
                        }
                    </ol>
                }
            </section>

            <section aria-labelledby="capabilities" class="cap-section">
                <CapabilityMatrix Rows="Page.Capabilities" Now="Now" />

                <h2 id="declared">@L("game.declaredByGame")</h2>
                <dl class="declared">
                    @foreach (var (name, chip) in Page.Declared)
                    {
                        <dt class="kicker">@name</dt>
                        <dd><Chip Fact="chip" Now="Now" /></dd>
                    }
                </dl>
                @if (StaleCount > 0)
                {
                    <p class="note faint">
                        @StaleCount are past their refresh window. Old, not wrong.
                    </p>
                }
            </section>

        </div>

        <div class="card-footer">
            <a href="#declared">@L("footer.declaredByGame")</a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="#changed">@L("footer.whatChanged")</a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="?plain=1">@L("a11y.plainText")</a>
                    <LanguageSwitcher />
        </div>
    </article>
}

@code {
    /// <summary>
    /// Whether claiming is available at all — it needs a database, and the demo has none.
    /// </summary>
    /// <remarks>
    /// Asked of the container rather than re-derived from a connection string, so the page and the
    /// endpoints cannot disagree about whether accounts exist.
    /// </remarks>
    private bool Claimable => Services.GetService<MUI.Catalog.Persistence.ClaimService>() is not null;

    [Parameter] public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    /// <summary>The first and last day of the trend range, as <c>yyyy-MM-dd</c>.</summary>
    /// <remarks>
    /// Clamped rather than validated: see <see cref="TrendRange.Parse"/>. What the reader gets is
    /// always printed over the graphic, so a range that was adjusted says so rather than quietly
    /// drawing a different fortnight from the one asked for.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "from")] private string? RangeFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")] private string? RangeTo { get; set; }

    /// <summary>Which drawing of the trend: <c>line</c> or <c>bar</c>.</summary>
    /// <remarks>
    /// Anything else falls back to the line rather than erroring, and the selector under the graphic
    /// then shows which shape the reader actually got — the same choice the ranking window makes.
    /// </remarks>
    [SupplyParameterFromQuery(Name = TrendShapes.Query)] private string? ChartShape { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    /// <summary>The widths the presets offer, ending today.</summary>
    private static readonly int[] RangePresets = [30, 90, 365];

    private GamePage? Page;

    private TrendSeries? Trend;

    private DateOnly Today => DateOnly.FromDateTime(Now.UtcDateTime);

    private TrendRange Range => TrendRange.Parse(RangeFrom, RangeTo, Today);

    private TrendShape Shape => TrendShapes.Parse(ChartShape);

    /// <summary>
    /// The address of one range, keeping whatever else the reader is already looking at.
    /// </summary>
    /// <remarks>
    /// A query with no path in front of it, which means <em>this page, asked differently</em> — and
    /// meant it only once <c>&lt;base href="/"&gt;</c> was gone from <c>App.razor</c>, since a base
    /// resolves a query-only href against itself and sent all five of these to the home page.
    /// </remarks>
    private string RangeHref(TrendRange range) => Href(range, Shape);

    /// <summary>The address of one shape, over the range the reader is already looking at.</summary>
    private string ShapeHref(TrendShape shape) => Href(Range, shape);

    private string Href(TrendRange range, TrendShape shape)
    {
        var query = $"?{range.Query}";

        // The default is left out, so the address a reader copies says only what they chose.
        if (shape is not TrendShape.Line)
        {
            query += $"&{TrendShapes.Query}={shape.Slug()}";
        }

        return Plain ? $"{query}&plain=1" : query;
    }

    /// <summary>
    /// The icon we hold for this game, or null — which covers "the field names none", "we could not
    /// fetch it" and "no database behind this site" alike.
    /// </summary>
    /// <remarks>
    /// Service-located rather than injected, like <see cref="Claimable"/> above and for the same
    /// reason: the store is registered only when a connection string is, so the demo fixture renders
    /// the monogram exactly as a game with no icon does. Nothing here says which of the reasons it
    /// was — a failed fetch is our afternoon and not a fact about the game (rule 5), so it gets no
    /// sentence, no placeholder and no broken image.
    /// </remarks>
    private GameIcon? Icon;
    private ReachSummary Reach = default!;
    private ArchiveEntry Entry = default!;
    private AnsiScreen ConnectScreen = default!;

    private DateTimeOffset Now => Clock.GetUtcNow();

    /// <summary>
    /// The schema.org graph for this game, built once the origin is known.
    /// </summary>
    /// <remarks>
    /// Handed to <c>SitePreview</c> as a function rather than a string because only that component
    /// knows the two things this needs: the absolute origin the request came in on, and whether a
    /// catalogue exists at all. Over the demo fixture it is never called, which is the point —
    /// nothing that reads a graph would ever see the banner saying the games are invented.
    /// </remarks>
    private string GraphFor(Uri origin) => GameStructuredData.For(Page!, origin);

    private bool Archived => Page?.Summary.State is LifecycleState.Archived;

    private bool Excluded => Page?.Summary.State is LifecycleState.Excluded;

    private bool Unlisted => Page?.Summary.State is LifecycleState.Unlisted;

    /// <summary>
    /// When what is on this page was last true.
    /// </summary>
    /// <remarks>
    /// An unlisted game is frozen for the same reason an archived one is — nothing new arrives, and
    /// the opt-out under it means nothing will — so its connect screen is dated from the last probe
    /// that answered rather than presented as four minutes old. Saying "just now" over a capture from
    /// before somebody asked us to stop would be the freshest lie on the page.
    /// </remarks>
    private DateTimeOffset? Captured =>
        Archived || Unlisted ? Entry.LastReachableAt : Now.AddMinutes(-4);

    private int StaleCount => Page?.Declared.Count(d => d.Value.IsStale) ?? 0;

    /// <summary>The label on the live count, or null where there is no count to label.</summary>
    private ProvenanceChip? Counted => Page?.Summary.PlayersNowProvenance;

    protected override async Task OnParametersSetAsync()
    {
        Page = await Queries.FindAsync(Slug);

        Icon = Page is not null && Services.GetService<IIconStore>() is { } icons
            ? await icons.ForGameAsync(Page.Summary.Id)
            : null;

        // Service-located like the icon store above, and for the same reason: a deployment without
        // a trend source renders the page without the chart rather than failing to render at all.
        Trend = Page is not null && Services.GetService<IPresenceTrends>() is { } trends
            ? await trends.ForGameAsync(Page.Summary.Id, Range.From, Range.To)
            : null;

        if (Page is null)
        {
            // Said in the status line and not only in the sentence. A slug a game used to have is
            // redirected before this page is reached (§5.7), so arriving here means no game ever
            // answered to this URL — and a 200 tells a crawler to index a page about a game that
            // does not exist. Under a request this hands the reader the site's not-found page with
            // a 404; under the headless renderer the tests use it does nothing, which is what the
            // block at the top of this file is still for.
            Navigation.NotFound();
            return;
        }

        var intervals = await History.ForGameAsync(Page.Summary.Id);
        Reach = ReachSeries.Build(intervals, Now);
        Entry = ArchiveEntry.For(Page.Summary, intervals, Now);
        ConnectScreen = Ansi.Parse(Page.ConnectScreen, Page.ConnectScreenSuppressed);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string L(string id) => Messages.For(Http.LocaleOf().Tag, id);

    private string L(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Http.LocaleOf().Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));
}
