@page "/reference/{Slug}"
@page "/reference/codebases/{Slug}"
@page "/reference/clients/{Slug}"
@page "/reference/protocols/{Slug}"
@using MUI.Web.Localization
@using MUI.Web.Reference
@inject IGameQueries Queries
@inject NavigationManager Navigation

@*
    One reference page, whichever kind it is.

    The four routes resolve through the document's own Path rather than a kind parameter, so a
    page's URL has exactly one spelling — a kind passed separately could let a link and a route
    disagree, rendering the wrong measurement beside the right prose.

    The prose is ours and the figures are measured: nothing below reads a number out of a content
    file, every count is a query made on this request. The split runs through localization too —
    every sentence here is a message in the reader's language, while the article is a document
    resolved for this locale and rendered whole.
*@

@if (Document is null)
{
    <h1>@Messages.For(Tag, "reference.notFound.title")</h1>
    <p class="dim">
        @foreach (var run in NotFound)
        {
            @if (run.Slot is null)
            {
                @run.Text
            }
            else
            {
                <a href="@Http.Link("/reference")">@run.Text</a>
            }
        }
    </p>
}
else if (Plain)
{
    <pre class="mono plain">@ReferencePlainText.Render(Tag, Document, Codebase, Protocol, Related)</pre>
}
else
{
    <SitePreview Title="@Document.Title" Description="@Document.Summary"
                 Card="PreviewCard.Reference" />

    <article class="reference">
        <header>
            <p class="kicker">@ReferencePlainText.Kind(Tag, Document.Kind)</p>
            <h1>@Document.Title</h1>
            <p class="lede dim">@Document.Summary</p>
            <p class="mono faint">
                @if (Document.Home is { } home)
                {
                    <a href="@home" rel="nofollow noopener">@home</a>
                }
                @if (Document.Platforms.Count > 0)
                {
                    <span> · @string.Join(", ", Document.Platforms)</span>
                }
            </p>
        </header>

        @if (Codebase is { } codebase)
        {
            <section class="measured-panel" aria-labelledby="running">
                <h2 id="running">@Messages.For(Tag, "reference.codebase.heading")</h2>
                @if (codebase.Known == 0)
                {
                    @* Never a zero standing on its own. Zero here is a statement about our coverage
                       and reads as a statement about the codebase unless it is spelled out. *@
                    <p class="dim">@Messages.For(Tag, "reference.codebase.none")</p>
                }
                else
                {
                    <p class="figure mono">
                        <a class="state-present" href="@Http.Link(Document.GamesPath)">@Messages.Say(Tag, "reference.codebase.listed", ("count", codebase.Listed))</a>
                        <span class="faint"> · @Messages.Say(Tag, "reference.codebase.archived", ("count", codebase.Archived)) · @Messages.For(Tag, "reference.measuredNeverAsserted")</span>
                    </p>
                    <p class="dim">@Messages.For(Tag, "reference.codebase.note")</p>
                    @if (codebase.MeasuredProtocols.Count > 0)
                    {
                        <p class="mono faint">
                            @Messages.Say(Tag, "reference.codebase.offered",
                                ("protocols", string.Join(", ", codebase.MeasuredProtocols)))
                        </p>
                    }
                }
            </section>
        }

        @if (Protocol is { } protocol)
        {
            <section class="measured-panel" aria-labelledby="adoption">
                <h2 id="adoption">@Messages.For(Tag, "reference.protocol.heading")</h2>
                @if (protocol.Listed == 0)
                {
                    <p class="dim">@Messages.For(Tag, "reference.protocol.none")</p>
                }
                else
                {
                    <p class="figure mono">
                        <a class="state-present" href="@Http.Link(Document.GamesPath)">@protocol.Offering</a>
                        <span class="faint">
                            @Messages.Say(Tag, "reference.protocol.share",
                                ("listed", protocol.Listed),
                                ("percent", Wording.Percent(protocol.Share ?? 0)))
                        </span>
                    </p>
                    <p class="dim">@ReferencePlainText.ProtocolRemainderCaveat(Tag)</p>

                    @if (MeasuredRows.Count > 0)
                    {
                        <table class="matrix">
                            <caption class="sr-only">
                                @Messages.Say(Tag, "reference.protocol.caption", ("protocol", Document.Title))
                            </caption>
                            <thead>
                                <tr>
                                    @* A column header naming a codebase family — not the kicker's job. S7. *@
                                    <th scope="col">@Messages.For(Tag, "reference.protocol.column.codebase")</th>
                                    <th scope="col">@Messages.For(Tag, "reference.protocol.column.offered")</th>
                                    <th scope="col">@Messages.For(Tag, "reference.protocol.column.identified")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in MeasuredRows)
                                {
                                    <tr>
                                        <th scope="row"><a href="@Http.Link(row.Path)">@row.Codebase</a></th>
                                        <td class="mono">
                                            <span class="@(row.Offering > 0 ? "state-present" : "state-unknown")">@row.Offering</span>
                                        </td>
                                        <td class="mono faint">@row.Identified</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </section>
        }

        @if (Document.Kind is ReferenceKind.Client)
        {
            <ClientCapabilityMatrix Claims="Claims" />
        }

        <div class="prose">@((MarkupString)Html)</div>

        @if (Related.Count > 0)
        {
            <h2>@Messages.For(Tag, "reference.seeAlso")</h2>
            <ul class="reference-index">
                @foreach (var other in Related)
                {
                    <li>
                        <a class="name" href="@Http.Link(other.Path)">@other.Title</a>
                        <span class="dim">@other.Summary</span>
                    </li>
                }
            </ul>
        }
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private ReferenceDocument? Document;
    private CodebaseFigures? Codebase;
    private ProtocolFigures? Protocol;
    private IReadOnlyList<ReferenceDocument> Related = [];
    private IReadOnlyList<CapabilityClaim> Claims = [];
    private string Html = string.Empty;

    private IReadOnlyList<ProtocolByCodebase> MeasuredRows =>
        [.. (Protocol?.ByCodebase ?? []).Where(r => r.IsMeasured)];

    /// <summary>The request, for the path that names this document and the locale it is read in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// The empty state's sentence, with the link to the index placed by the message rather than
    /// glued round it — a gap here is work nobody has done, and this is the one 404 on the site a
    /// reader could reasonably read a deletion into.
    /// </summary>
    private IReadOnlyList<Sentences.Run> NotFound => Sentences.Place(
        Tag, "reference.notFound.body", ("index", Messages.For(Tag, "reference.notFound.index")));

    protected override async Task OnParametersSetAsync()
    {
        // The one place this page decides which set of articles it is rendering, scoped to the
        // request's locale. Related, Find and the figures below all come off whatever it returns.
        var library = ReferenceLibrary.For(Tag);

        Document = library.Find(Here());

        if (Document is null)
        {
            return;
        }

        Related = library.Related(Document);
        Claims = ClientCapabilities.For(Document);
        Html = ReferenceMarkdown.ToHtml(Document.Body, Tag);

        Codebase = Document.Codebase is { } family
            ? await CodebaseFigures.ReadAsync(Queries, family)
            : null;

        Protocol = Document.Protocol is { } protocol
            ? await ProtocolFigures.ReadAsync(Queries, protocol, library.OfKind(ReferenceKind.Codebase))
            : null;
    }

    /// <summary>
    /// Which document was asked for: the path within this locale, and not the URL that was typed.
    /// </summary>
    /// <remarks>
    /// <c>NavigationManager.Uri</c> still carries the locale prefix the middleware moved into
    /// <c>PathBase</c>, and the library is keyed on the one spelling a document has — so
    /// <c>/de/reference/codebases/pennmush</c> would 404 every non-English reader. <c>Request.Path</c>
    /// has the prefix off already.
    /// </remarks>
    private string Here() =>
        Http?.Request.Path.Value is { Length: > 0 } path
            ? path.TrimEnd('/')
            : new Uri(Navigation.Uri).LocalPath.TrimEnd('/');
}
