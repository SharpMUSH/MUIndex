@page "/submit"
@using Microsoft.AspNetCore.WebUtilities
@using MUI.Catalog
@using MUI.Catalog.Persistence
@using MUI.Discovery
@using MUI.Web.Data
@using MUI.Web.Localization
@inject IServiceProvider Services
@inject CatalogueSource Catalogue
@inject NavigationManager Nav

@*
    Submit a game: a host, a port, and nothing else (spec §7.6, §9).

    A submitter asserts nothing. There is no name box, no description box, no codebase dropdown and
    no player count, because every fact on this site is measured by our own crawler and a field here
    would be a field somebody could fill in with anything. What we take from a stranger is the same
    thing the backfill takes from a directory: an address to dial.

    The form is a real POST with an antiforgery token and no script, so it works in a text browser
    exactly as it works anywhere else — which is why plain mode renders the prose as text and then
    keeps the same form beneath it rather than describing one. The answer arrives back as a
    querystring — post, redirect, get — so a reload does not resubmit and this page never has to set
    a cookie to remember what it just did.
*@

<SitePreview Title="@SubmitCopy.Title(Tag)" Description="@SubmitCopy.Lede(Tag)" Data="false" />

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderSubmit(Answer, Catalogue.IsMeasured, Tag)</pre>
}
else
{
    <section class="prose">
        <h1>@SubmitCopy.Title(Tag)</h1>
        <p>@SubmitCopy.Lede(Tag)</p>
    </section>

    @if (Answer is { } answer)
    {
        <section class="prose submission-answer" role="status">
            <h2>@answer.Heading</h2>
            <p>@answer.Sentence</p>
            @if (answer.Link is { } link)
            {
                <p><a href="@Http.Link(link.Href)">@link.Label</a></p>
            }
        </section>
    }

    @if (!Catalogue.IsMeasured)
    {
        <section class="prose"><p>@SubmitCopy.NoCatalogue(Tag)</p></section>
    }
}

@if (Catalogue.IsMeasured)
{
    <section class="prose">
        <form method="post" action="@Http.Link(SubmitLinks.Path)" class="submit-address">
            <AntiforgeryToken />

            <label for="submit-host">@SubmitCopy.HostLabel(Tag)</label>
            <input id="submit-host" name="host" type="text" inputmode="url" autocomplete="off"
                   maxlength="@SubmittedAddressReader.MaxHostLength" value="@Host" required />
            <span class="faint">@SubmitCopy.HostHint(Tag)</span>

            <label for="submit-port">@SubmitCopy.PortLabel(Tag)</label>
            <input id="submit-port" name="port" type="text" inputmode="numeric" autocomplete="off"
                   maxlength="5" value="@Port" />

            <button type="submit">@SubmitCopy.SubmitLabel(Tag)</button>
        </form>
    </section>

    @if (!Plain)
    {
        <section class="prose">
            <h2>@L("submit.what.heading")</h2>
            <ol>
                @foreach (var point in SubmitCopy.Points(Tag))
                {
                    <li>@point</li>
                }
            </ol>        </section>
    }
}

@code {
    // Read off the URL rather than bound parameter by parameter, for the reason Games.razor is: the
    // answer arrives as a redirect this page did not model, and one parser over the whole querystring
    // is what lets it be rendered and asserted without a request pipeline underneath it.
    private Dictionary<string, Microsoft.Extensions.Primitives.StringValues> Query { get; set; } = [];

    private string? Value(string key) =>
        Query.TryGetValue(key, out var values) ? values.ToString() : null;

    private bool Plain => Truthy.Is(Value("plain"));

    private string? Host => Value(SubmitLinks.HostKey);

    private string? Port => Value(SubmitLinks.PortKey);

    private SubmitAnswer? Answer { get; set; }

    /// <summary>
    /// Reads the answer back out of the URL, trusting none of it.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The outcome has to be one of a fixed set of words, and the slug is looked up again here — so a
    /// hand-made link cannot make this page point at a game that does not exist, and the row decides
    /// whether the link is the game's page or its claim page rather than the URL doing so.
    /// </para>
    /// <para>
    /// <b>One row, through <see cref="IGameStore"/>, not <c>IGameQueries.FindAsync</c>.</b> That call
    /// assembles a whole game page — fields, presence digest, availability intervals, endpoints, the
    /// change feed and a 7×24 activity grid — which is six extra round trips to decide whether a
    /// string names a game. On an unauthenticated GET with an attacker-supplied slug that is a
    /// request amplifier, and it is the wrong question besides.
    /// </para>
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        Query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);

        var outcome = SubmitLinks.Outcome(Value(SubmitLinks.ResultKey));
        var slug = Value(SubmitLinks.GameKey);

        SubmitLink? link = null;

        if (outcome is SubmissionOutcome.AlreadyListed
            && slug is { Length: > 0 }
            && Services.GetService<IGameStore>() is { } games
            && await games.BySlugAsync(slug) is { } game)
        {
            // Hidden means submitted and unclaimed — the state whose only exit is a claim, so that
            // is what the link offers. Everything else gets its public page.
            link = game.SubmittedAt is not null && !game.IsClaimed
                ? SubmitLink.Claim(game.Slug, Tag)
                : SubmitLink.Game(game.Slug);
        }

        Answer = SubmitCopy.Answer(outcome, SubmitLinks.Address(Host, Port), link, Tag);
    }

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);
}
