@page "/submit"
@using Microsoft.AspNetCore.WebUtilities
@using MUI.Catalog
@using MUI.Discovery
@using MUI.Web.Data
@inject IGameQueries Queries
@inject CatalogueSource Catalogue
@inject NavigationManager Nav

@*
    Submit a game: a host, a port, and nothing else (spec §7.6, §9).

    A submitter asserts nothing. There is no name box, no description box, no codebase dropdown and
    no player count, because every fact on this site is measured by our own crawler and a field here
    would be a field somebody could fill in with anything. What we take from a stranger is the same
    thing the backfill takes from a directory: an address to dial.

    The form is a real POST with an antiforgery token and no script, so it works in a text browser
    exactly as it works anywhere else — which is why plain mode renders the prose as text and then
    keeps the same form beneath it rather than describing one. The answer arrives back as a
    querystring — post, redirect, get — so a reload does not resubmit and this page never has to set
    a cookie to remember what it just did.
*@

<PageTitle>@SubmitCopy.Title — mu*index</PageTitle>

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderSubmit(Answer, Catalogue.IsMeasured)</pre>
}
else
{
    <section class="prose">
        <h1>@SubmitCopy.Title</h1>
        <p>@SubmitCopy.Lede</p>
    </section>

    @if (Answer is { } answer)
    {
        <section class="prose submission-answer" role="status">
            <h2>@answer.Heading</h2>
            <p>@answer.Sentence</p>
            @if (answer.GameSlug is { } slug)
            {
                <p><a href="/g/@slug">/g/@slug</a></p>
            }
        </section>
    }

    @if (!Catalogue.IsMeasured)
    {
        <section class="prose"><p>@SubmitCopy.NoCatalogue</p></section>
    }
}

@if (Catalogue.IsMeasured)
{
    <section class="prose">
        <form method="post" action="@SubmitLinks.Path" class="submit-address">
            <AntiforgeryToken />

            <label for="submit-host">@SubmitCopy.HostLabel</label>
            <input id="submit-host" name="host" type="text" inputmode="url" autocomplete="off"
                   maxlength="@SubmittedAddressReader.MaxHostLength" value="@Host" required />
            <span class="faint">@SubmitCopy.HostHint</span>

            <label for="submit-port">@SubmitCopy.PortLabel</label>
            <input id="submit-port" name="port" type="text" inputmode="numeric" autocomplete="off"
                   maxlength="5" value="@Port" />

            <button type="submit">@SubmitCopy.SubmitLabel</button>
        </form>
    </section>

    @if (!Plain)
    {
        <section class="prose">
            <h2>What happens to an address</h2>
            <ol>
                @foreach (var point in SubmitCopy.Points)
                {
                    <li>@point</li>
                }
            </ol>
            <p class="faint"><a href="?plain=1">read this page as plain text</a></p>
        </section>
    }
}

@code {
    // Read off the URL rather than bound parameter by parameter, for the reason Games.razor is: the
    // answer arrives as a redirect this page did not model, and one parser over the whole querystring
    // is what lets it be rendered and asserted without a request pipeline underneath it.
    private Dictionary<string, Microsoft.Extensions.Primitives.StringValues> Query { get; set; } = [];

    private string? Value(string key) =>
        Query.TryGetValue(key, out var values) ? values.ToString() : null;

    private bool Plain => Truthy.Is(Value("plain"));

    private string? Host => Value(SubmitLinks.HostKey);

    private string? Port => Value(SubmitLinks.PortKey);

    private SubmitAnswer? Answer { get; set; }

    /// <summary>
    /// Reads the answer back out of the URL, trusting none of it.
    /// </summary>
    /// <remarks>
    /// The outcome has to be one of a fixed set of words, and the slug is looked up again here — so a
    /// hand-made link cannot make this page link to a game that is not public, which would be the
    /// hidden-until-claimed filter leaking through the one page that talks about it.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        Query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);

        var outcome = SubmitLinks.Outcome(Value(SubmitLinks.ResultKey));
        var game = Value(SubmitLinks.GameKey);

        var slug = outcome is SubmissionOutcome.AlreadyListed && game is { Length: > 0 }
            && await Queries.FindAsync(game) is not null
                ? game
                : null;

        Answer = SubmitCopy.Answer(outcome, SubmitLinks.Address(Host, Port), slug);
    }
}
