@page "/reference"
@using MUI.Web.Localization
@using MUI.Web.Reference

@*
    The reference section's front door.

    Spec §9's argument for this whole section is that it obtains wiki value without wiki governance:
    the content is curated, single-author and versioned in git. That has to be said on the page —
    a reader who assumes they are looking at a wiki will read a gap as vandalism rather than as work
    nobody has done yet, and will look for an edit button that will never exist.

    Every word this page writes is a message; every word it lists is not. A document's title and
    summary come out of the article's own front matter, which the library resolves for this locale —
    so this page asks for the words and never decides what language they are in.
*@

@if (Plain)
{
    <pre class="mono plain">@ReferencePlainText.RenderIndex(Tag, Library)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.Reference(Tag)" Description="@PreviewCopy.Pages.Reference(Tag)"
                 Card="PreviewCard.Reference" />

    <h1>@Messages.For(Tag, "reference.title")</h1>
    <p class="dim">
        @* The emphasis is placed by the message rather than wrapped round a word of it, so the
           bundle holds text and a language that stresses a different word can move it. *@
        @foreach (var run in Lede)
        {
            @if (run.Slot is null)
            {
                @run.Text
            }
            else
            {
                <em>@run.Text</em>
            }
        }
    </p>

    @foreach (var kind in Kinds)
    {
        var documents = Library.OfKind(kind);

        if (documents.Count == 0)
        {
            continue;
        }

        <section aria-labelledby="ref-@kind">
            <h2 id="ref-@kind">@ReferencePlainText.Heading(Tag, kind)</h2>
            <ul class="reference-index">
                @foreach (var document in documents)
                {
                    <li>
                        <a class="name" href="@Http.Link(document.Path)">@document.Title</a>
                        <span class="dim">@document.Summary</span>
                    </li>
                }
            </ul>
        </section>
    }

    <p class="faint"><a href="?plain=1">@Messages.For(Tag, "a11y.plainText")</a></p>
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private IReadOnlyList<Sentences.Run> Lede => Sentences.Place(
        Tag, "reference.lede", ("number", Messages.For(Tag, "reference.lede.number")));

    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    private static readonly ReferenceKind[] Kinds =
    [
        ReferenceKind.Orientation, ReferenceKind.Codebase, ReferenceKind.Client, ReferenceKind.Protocol,
    ];

    /// <summary>
    /// The section as this reader gets it — one call site, scoped to the request's locale.
    /// </summary>
    /// <remarks>
    /// Instance rather than static because it is a per-request question: the loader answers it with
    /// this locale's articles and the English ones where a translation does not exist yet.
    /// </remarks>
    private ReferenceLibrary Library => ReferenceLibrary.For(Tag);
}
