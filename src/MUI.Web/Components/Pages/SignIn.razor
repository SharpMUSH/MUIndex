@page "/account/sign-in"
@using Microsoft.AspNetCore.Identity
@using MUI.Web.Accounts
@using MUI.Web.Localization
@inject IServiceProvider Services

@*
    Sign-in, and the only page on this site that needs JavaScript (spec §8.2).

    Passkeys and nothing else: no password to store, no address to recover to, no third party. The
    part of passwordless that usually forces one of those back in is account recovery, and it does
    not apply — lose every device and the way back is to publish a fresh token on the game you
    control, because the root of trust is the server rather than the credential.

    That also means an account here is worth almost nothing to steal, which is the design working
    rather than a shortcut: taking one gets you the ability to answer some hand-typed descriptions on
    games whose real owner takes them back in a single probe — and no measurement at all, because no
    form on this site reaches one.
*@

<SitePreview Title="@L("account.signIn.title")" Data="false"
             Description="@L("account.signIn.preview")" />

@if (!Available)
{
    <section class="prose">
        <h1>@L("account.signIn.title")</h1>
        <p>@L("account.signIn.noDatabase")</p>
    </section>
}
else
{
    <section class="prose auth">
        <h1>@L("account.signIn.title")</h1>

        @*
            The lead is bold and is its own sentence, rather than one word emphasised inside a
            longer one. A <strong> in the middle of a sentence is a sentence a translator cannot
            move: the emphasised word lands in a different place in most languages and in no place
            at all in some. This is the same split AboutPoint makes, for the same reason.
        *@
        <p>
            <strong>@L("account.signIn.passkey.lead")</strong> @L("account.signIn.passkey.body")
        </p>

        <form data-passkey="sign-in" method="post" action="/account/sign-in">
            <button type="submit" disabled>@L("account.signIn.button")</button>
            <p class="faint" data-passkey-status>@L("account.signIn.script")</p>
        </form>

        <h2>@L("account.register.heading")</h2>

        <p>@L("account.register.lede")</p>

        <form data-passkey="register" method="post" action="/account/register">
            <label for="name">@L("account.register.name.label")</label>
            <input id="name" name="name" type="text" maxlength="40" autocomplete="username"
                   placeholder="@L("account.register.name.placeholder")" />
            <button type="submit" disabled>@L("account.register.button")</button>
            <p class="faint" data-passkey-status></p>
        </form>

        <h2>@L("account.store.heading")</h2>

        <ul>
            <li>@L("account.store.name")</li>
            <li>@L("account.store.keys")</li>
            <li>@L("account.store.claims")</li>
        </ul>

        <p class="faint">@L("account.store.note")</p>
    </section>

    <script src="/passkey.js" defer></script>
}

@code {
    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string L(string id) => Messages.For(Http.LocaleOf().Tag, id);

    /// <summary>
    /// Whether there is a database to sign in against.
    /// </summary>
    /// <remarks>
    /// Identity is only registered when a connection string is configured, so this asks the
    /// container rather than re-deriving the condition — two places deciding whether accounts exist
    /// is how a page ends up offering a button that throws.
    /// </remarks>
    private bool Available => Services.GetService<SignInManager<MuiUser>>() is not null;
}
