@page "/about"
@using Microsoft.Extensions.Options
@using MUI.Crawl
@using MUI.Web.Api
@using MUI.Web.Localization
@inject IOptions<DatasetLicenceOptions> Dataset
@inject IServiceProvider Services

@*
    The page this project owes the sites it read and the servers it dials (spec §7.6, §11):
    crediting backfill sources, publishing who is knocking and how to stop it, and stating the
    limits of what a measurement here proves. Deliberately the plainest page on the site — a poor
    place to contradict the argument that provenance beats presentation.
*@

@if (Plain)
{
    <pre class="mono plain">@PlainText.RenderAbout(Page, Tag)</pre>
}
else
{
    <SitePreview Title="@PreviewCopy.Titles.About(Tag)" Description="@PreviewCopy.Pages.About(Tag)" />

    <h1>@L("about.title")</h1>
    <p class="summary">@Page.Lede</p>

    @foreach (var section in Page.Sections)
    {
        <section class="about" aria-labelledby="about-@section.Id">
            <h2 id="about-@section.Id">@section.Heading</h2>

            @foreach (var point in section.Points)
            {
                <p class="note"><strong>@point.Lead</strong> @point.Body</p>
            }

            @if (section.Identity is { } identity)
            {
                <p class="note">@identity.Wording(Tag)</p>

                @* The list is `mono` because its values are a terminal type and a URL — machine
                   voice, and skipped by the translation sweep for that reason. The two labels are
                   ours and are not, so they carry `translate="yes"` against the class around them. *@
                <dl class="identity mono">
                    <dt class="kicker" translate="yes">@L("about.identity.crawler")</dt>
                    <dd>@identity.Name</dd>
                    <dt class="kicker" translate="yes">@L("about.identity.contact")</dt>
                    <dd>
                        <a href="@identity.InfoUrl">@identity.InfoUrl</a>
                        @if (!identity.ContactConfigured)
                        {
                            @* Amber is the site's word for declared-but-unverified, and an address
                               nobody configured is exactly that: a value with nothing behind it. *@
                            <span class="warn" translate="yes"> @L("about.identity.placeholder")</span>
                        }
                    </dd>
                </dl>
            }

            @if (section.Sources.Count > 0)
            {
                <ul class="sources">
                    @foreach (var source in section.Sources)
                    {
                        @* Name and state on one line, the note under both — a note is a paragraph
                           rather than a facts column, so the listing's two-column row is wrong here. *@
                        <li>
                            <p class="source-head">
                                <a class="name" href="@source.Url" rel="external">@source.Name</a>
                                <span class="badge">@source.StatusWording(Tag)</span>
                            </p>
                            <p class="dim">@source.Note</p>
                        </li>
                    }
                </ul>
            }

            @if (section.Licence is { } licence)
            {
                <dl class="identity mono">
                    <dt class="kicker" translate="yes">@L("about.licence.codeLabel")</dt>
                    <dd>@licence.CodeLicence</dd>
                    <dt class="kicker" translate="yes">@L("about.licence.dataLabel")</dt>
                    <dd>
                        @if (licence.DataLicenceUrl is { } url)
                        {
                            <a href="@url">@licence.DataLicenceName</a>
                        }
                        else
                        {
                            @licence.DataLicenceName
                        }
                    </dd>
                    <dt class="kicker" translate="yes">@L("about.licence.creditLabel")</dt>
                    <dd>@licence.Attribution</dd>
                </dl>

                @* Configuration, not chrome, and so not a message: the read API serves the same
                   notice to the bulk dump, so a translated copy here would be a second, differing
                   statement of one deployment's terms. `translate="no"` for the same reason. *@
                <p class="note dim" translate="no">@licence.Notice</p>
            }
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "plain")] private string? PlainFlag { get; set; }

    private bool Plain => Truthy.Is(PlainFlag);

    /// <summary>The locale this page is being answered in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string L(string id) => Messages.For(Tag, id);

    // Read from the container rather than constructed, so the identity this page publishes is the
    // identity the probe was actually built from, not a default that drifted from configuration.
    private AboutPage Page => AboutPage.Build(
        Services.GetService(typeof(ProbeOptions)) as ProbeOptions ?? new ProbeOptions(),
        Dataset.Value,
        Tag);
}
