@using MUI.Web.Localization

@*
    The availability strip: ninety bars, oldest at the left.

    Status-page convention, because readers already know how to read one. Two deliberate divergences,
    both from the design handoff: degraded is a *short* bar rather than only a different colour, and
    unreachable is hatched and outlined so it reads as "absent" rather than as an alarm.

    The word is "reachable", never "uptime". We measured a socket from one vantage point and did not
    measure whether the game was up. The wording matters more than the graphic.
*@

<div class="kicker">@L("reach.kicker", ("days", Summary.Window))</div>
<p class="summary">@Sentence</p>

@if (Summary.HasAnyMeasurement)
{
    @* One image with one label, rather than ninety announced bars. The spells are underneath in
       words, so nothing here is only available to a reader who can see it. *@
    <div class="strip" role="img" aria-label="@Sentence">
        @foreach (var day in Summary.Days)
        {
            <span class="bar @Class(day.State)" title="@day.Label(Tag)"></span>
        }
    </div>
    <div class="strip-scale mono faint">
        <span>@L("reach.scale.ago", ("days", Summary.Window))</span>
        <span>@L("reach.scale.today")</span>
    </div>

    <dl class="stats">
        <div>
            <dt class="kicker">@L("reach.stat.reachable")</dt>
            <dd class="mono state-present">
                @(Summary.ReachableFraction is { } f ? Wording.Percent(f) : L("state.notMeasured"))
            </dd>
        </div>
        <div>
            <dt class="kicker">@L("reach.stat.longestOutage")</dt>
            <dd class="mono">
                @(Summary.LongestOutage is { } o ? Wording.Duration(o) : L("reach.noOutage"))
            </dd>
        </div>
        <div>
            <dt class="kicker">@L("reach.stat.lastCause")</dt>
            <dd class="mono @(Summary.LastCause is FailureCause.None ? "faint" : "warn")">
                @(Summary.LastCause is FailureCause.None ? L("reach.noCause") : Wording.Cause(Tag, Summary.LastCause))
            </dd>
        </div>
    </dl>

    <ul class="legend">
        <li><span class="swatch bar-reachable" aria-hidden="true"></span>@L("reach.legend.reachable")</li>
        <li><span class="swatch bar-degraded" aria-hidden="true"></span>@L("reach.legend.degraded")</li>
        <li><span class="swatch bar-unreachable" aria-hidden="true"></span>@L("reach.legend.unreachable")</li>
        <li><span class="swatch bar-unmeasured" aria-hidden="true"></span>@L("reach.legend.notMeasured")</li>
    </ul>

    @if (Spells.Count > 0)
    {
        <details class="read-as-text">
            <summary>@L("a11y.readAsText")</summary>
            <ul class="spells">
                @foreach (var spell in Spells)
                {
                    <li>@spell</li>
                }
            </ul>
        </details>
    }
}

@code {
    [Parameter, EditorRequired] public ReachSummary Summary { get; set; } = default!;

    /// <summary>The request, for the locale its ninety bar titles are written in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// Rendered once and used twice, as the paragraph and as the graphic's own label.
    /// </summary>
    /// <remarks>
    /// Computed in <see cref="OnParametersSet"/> rather than on each read, which is what "once"
    /// means: both of these walk the ninety-day series and format a message per span, and the markup
    /// reads each of them twice.
    /// </remarks>
    private string Sentence = string.Empty;

    private IReadOnlyList<string> Spells = [];

    protected override void OnParametersSet()
    {
        Sentence = Summary.Sentence(Tag);
        Spells = Summary.Spells(Tag);
    }

    private string L(string id) => Messages.For(Tag, id);

    private string L(string id, params (string Key, object? Value)[] args) =>
        Messages.For(Tag, id, args.ToDictionary(a => a.Key, a => a.Value, StringComparer.Ordinal));

    private static string Class(ReachState state) => state switch
    {
        ReachState.Reachable => "bar-reachable",
        ReachState.Degraded => "bar-degraded",
        ReachState.Unreachable => "bar-unreachable",
        _ => "bar-unmeasured",
    };
}
