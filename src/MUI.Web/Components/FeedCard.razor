@using MUI.Web.Localization

@*
    A row in one of the three change lists: name left, age right, no boxed card.

    No explanatory suffix line under the row — the column heading already says which register this
    is, so a repeated "first seen"/"answered again" line was the same fact announced twice per row.
    Where a cause exists (why a game went dark) it's not a repeat of the heading, so it's kept,
    folded into the right-hand cell: "refused · 16h".
*@
<article class="feed-row @Register">
    @* Off when the enclosing column already names the register, to avoid "newly discovered newly
       discovered"; the column heading still labels the section for a screen reader. *@
    @if (ShowRegister)
    {
        <div class="kicker">@Heading</div>
    }
    <a class="feed-name" href="@Http.Link($"/g/{Entry.Slug}")"><GameName Name="@Entry.Name" /></a>
    <span class="feed-state mono">
        @if (Kind is FeedKind.CameBack)
        {
            <span class="state-present">@Messages.For(Tag, "feed.live")</span>
            <span class="sep" aria-hidden="true">·</span>
        }
        else if (Cause is { Length: > 0 } cause)
        {
            <span class="cause">@cause</span>
            <span class="sep" aria-hidden="true">·</span>
        }
        <Moment At="Entry.At" Now="Now" />
    </span>
</article>

@code {
    [Parameter, EditorRequired] public FeedEntry Entry { get; set; } = default!;

    [Parameter, EditorRequired] public FeedKind Kind { get; set; }

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    [Parameter] public bool ShowRegister { get; set; } = true;

    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// Why a game went dark (a measurement: refused, unresolved, timed out) — shown only on that
    /// register. The discovery feed's equivalent detail lives on the game's own page instead.
    /// </summary>
    private string? Cause => Kind is FeedKind.WentDark ? Entry.Detail : null;

    private string Register => Kind switch
    {
        FeedKind.WentDark => "unlit",
        FeedKind.CameBack => "returned",
        _ => "neutral",
    };

    private string Heading => Messages.For(Tag, Kind switch
    {
        FeedKind.WentDark => "feed.wentDark",
        FeedKind.CameBack => "feed.cameBack",
        _ => "feed.newlyDiscovered",
    });
}
