@inherits LayoutComponentBase
@using MUI.Web.Accounts
@using MUI.Web.Data
@using MUI.Web.Localization
@inject CatalogueSource Catalogue

@* A connect screen is a figure a reader may want past in one keystroke, so the page needs somewhere
   for that keystroke to land. *@
<a class="skip" href="#content">@L("a11y.skipToContent")</a>

@* Not dismissible, not subtle: a reader who cannot tell demo data from a measurement is being
   misled by exactly the mechanism this project exists to replace. *@
@if (!Catalogue.IsMeasured)
{
    <p class="demo-banner" role="status">
        <strong>@L("banner.demo.lead")</strong> @L("banner.demo")
    </p>
}

@* Two labelled groups — browse (games/find/random/archive) and learn (reference/ecosystem/
   rankings) — with submit and about moved to the far end beside sign in, where a reader looks
   for what to *do*. *@
<div class="shell">
<header class="site">
    <a class="mark" href="@HttpContext.Link("/")">mu<span class="star">*</span>index</a>
    @* The bar degrades through a defined order rather than whatever flexbox decides (i18n S2):
       group labels first, then submit's border, then both groups into one disclosure. Width
       triggers each step, never language. Every destination survives every step — a step that
       dropped a link would make the site's contents depend on window size. *@
    @* Every link exists exactly once: the disclosure wraps the same two groups rather than
       duplicating them, since two copies would put two `aria-current="page"` markers in one
       document. Above the collapse width the summary is hidden and the panel forced visible, so
       one markup is a bar on a laptop and a menu on a phone with no script. *@
    <nav class="site-nav" aria-label="@L("nav.catalogues")">
        <details class="nav-menu">
            <summary>@L("nav.menu") <span aria-hidden="true">▾</span></summary>
            <div class="menu-panel">
                <span class="nav-group" role="group" aria-label="@L("nav.browse")">
                    <span class="nav-label" aria-hidden="true">@L("nav.browse")</span>
                    @Item("/games", L("nav.games"))
                    @Item("/find", L("nav.find"))
                    @Item("/games/random", L("nav.random"))
                    @Item("/archive", L("nav.archive"))
                </span>
                <span class="nav-rule" aria-hidden="true"></span>
                <span class="nav-group" role="group" aria-label="@L("nav.learn")">
                    <span class="nav-label" aria-hidden="true">@L("nav.learn")</span>
                    @Item("/reference", L("nav.reference"))
                    @Item("/ecosystem", L("nav.ecosystem"))
                    @Item("/rankings", L("nav.rankings"))
                </span>

                @* Step 4: submit moves in here rather than being dropped — a step loses decoration,
                   never a destination. About and sign in stay in the bar. *@
                <span class="menu-tail">
                    <span class="nav-label" aria-hidden="true">@L("nav.thisSite")</span>
                    <a href="@HttpContext.Link("/submit")">@L("nav.submitGame")</a>
                </span>

                @* Step 5: the two reading controls, same move as `submit`. Theme stays in the bar
                   at every width. Rendered here *and* in the bar with CSS showing exactly one — the
                   panel and the trailing cluster are different flex containers, so nothing can move
                   a single box between them. *@
                <span class="menu-reading">
                    <span class="nav-label" aria-hidden="true">@L("nav.reading")</span>
                    @Mirror
                    <LanguageSwitcher />
                </span>
            </div>
        </details>
    </nav>
    @* The account, in its own slot rather than a tenth entry above — that list names places to
       browse, and an operator's own page is not one of them. *@
    <nav class="account" aria-label="@L("nav.account")">
        @* Reuses the same non-primary `.action` treatment and 40em/62.5em collapse as submit
           below, so this costs nothing new against the width ladder above — it degrades exactly
           where submit already does, rather than opening a fresh breakpoint to tune. *@
        <a class="action discord" href="https://discord.gg/KNRGZnQGpa" target="_blank" rel="noopener" title="@L("nav.discord")">
            <span class="reach-icon" aria-hidden="true">@((MarkupString)LinkIcons.Svg(LinkKind.Discord))</span>
            <span class="sr-only">@L("nav.discord")</span>
        </a>
        @Item("/about", L("nav.about"))
        <a class="action" href="@HttpContext.Link("/submit")">@L("nav.submit")</a>
        @if (HttpContext?.User is { Identity.IsAuthenticated: true })
        {
            <a class="action primary" href="@HttpContext.Link("/account")">@L("nav.yourGames")</a>
        }
        else
        {
            @* Carries the page being read, so signing in from the bar comes back to it. *@
            <a class="action primary" href="@ReturnPath.SignInFrom(HttpContext)">@L("nav.signIn")</a>
        }
    </nav>
    @* Last in the bar: everything to their left names a page, these three change the one you're
       on — as text, in another language, against another background. *@
    <div class="reading">
        @* Two of the three behind a caret: drawn in the bar they cost 406px, and a width sweep
           (340–1440px) found a second row forming under German/Dutch and Japanese at that size —
           see app.css. Theme stays outside the caret; it's the control a reader reaches for
           *because* they can't comfortably read the page, so it can't be one more click away. *@
        <details class="read-menu">
            @* The caret is the glyph; the word is for whoever isn't looking at it. A summary whose
               whole content is `▾` has no accessible name — a screen reader announces "disclosure
               triangle, collapsed" and nothing about what it holds. *@
            <summary>
                <span class="sr-only">@L("nav.reading")</span>
                <span aria-hidden="true">▾</span>
            </summary>
            <div class="read-panel">
                @Mirror
                <LanguageSwitcher />
            </div>
        </details>
        <ThemeToggle />
    </div>
</header>
<main id="content">@Body</main>
</div>

@code {
    /// <summary>
    /// One nav item, marked when it is the page being read.
    /// </summary>
    /// <remarks>
    /// The marker is an inset box-shadow rather than a border or padding change, since either would
    /// add a pixel to the box and shift every link beside it the moment it becomes current. A
    /// section matches its own root and everything under it, but "/" matches only itself, or every
    /// item would be current on the home page. Matching is done against <c>Request.Path</c> (the
    /// locale-invariant path — the locale routing middleware moves the locale into
    /// <c>PathBase</c>), never against the translated link text.
    /// </remarks>
    private RenderFragment Item(string href, string text) =>
        @<a href="@HttpContext.Link(href)" class="@(IsCurrent(href) ? "on" : null)"
            aria-current="@(IsCurrent(href) ? "page" : null)">@text</a>;

    /// <summary>
    /// The offer to read this page as text, where there is one.
    /// </summary>
    /// <remarks>
    /// Conditional: not every route has a text mirror (<see cref="TextMirror"/> holds which do), and
    /// offering one everywhere would link back to the page you're already on. The href carries the
    /// existing query string, or asking a filtered listing for text would answer with the whole
    /// catalogue instead.
    /// </remarks>
    private RenderFragment Mirror =>
        TextMirror.Offers(HttpContext)
            ? @<a class="mirror" href="@TextMirror.Href(HttpContext)">@L("a11y.plainText")</a>
            : @<text></text>;

    /// <summary>
    /// Every destination this bar offers, longest first, so the most specific match wins.
    /// </summary>
    /// <remarks>
    /// Ordered by length so a request under both <c>/games/random</c> and <c>/games</c> matches only
    /// the longer one — otherwise a screen reader gets two "current page" markers in one document.
    /// </remarks>
    private static readonly string[] Destinations =
    [
        .. new[] { "/games/random", "/games", "/find", "/archive", "/reference", "/ecosystem", "/rankings", "/about", "/" }
            .OrderByDescending(d => d.Length),
    ];

    private bool IsCurrent(string href)
    {
        var path = HttpContext?.Request.Path.Value?.TrimEnd('/');

        if (string.IsNullOrEmpty(path))
        {
            path = "/";
        }

        // Best match, not merely a match: only the first (longest) destination this path sits
        // under gets the marker.
        var best = Destinations.FirstOrDefault(d => Matches(d, path));

        return best is not null && best == href;

        static bool Matches(string destination, string path) => destination == "/"
            ? path == "/"
            : path == destination || path.StartsWith(destination + "/", StringComparison.Ordinal);
    }

    /// <summary>
    /// The request, for the one question this layout asks it: is anybody signed in.
    /// </summary>
    /// <remarks>
    /// Every page renders this header, so a display name here would cost a user-store query on
    /// every page view just to render four words — the link says where it goes, not who's signed in.
    /// </remarks>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>One message, in the locale this request is being answered in.</summary>
    private string L(string id) => Messages.For(HttpContext.LocaleOf().Tag, id);
}
