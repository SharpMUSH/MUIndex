@using MUI.Web.Localization
@*
    Day-of-week × hour heatmap. Three layers: the summary sentence, a seven-row text-alternative
    table, and the grid itself — which is aria-hidden, since the table already carries every fact
    it draws and announcing it cell by cell is 168 utterances for one shape.

    Below the measured-days threshold, no grid is drawn: a near-empty grid announces "not measured"
    dozens of times before reaching the one real number, and reads as broken.

    Cell state (counted incl. zero / probed-but-uncountable / not-measured, spec §5.4) is carried by
    shape, not colour, so it survives greyscale.
*@

@if (Cells.Count == 0)
{
    <p class="summary">@ActivitySummary.Sentence(Tag, Cells)</p>
}
else if (!Enough)
{
    @* Replaces the summary rather than following it: with only a couple of measured hours, a
       "busiest day" sentence would claim a week's pattern from a morning's data. *@
    <div class="sparse">
        <p class="kicker">@L("activity.sparse.kicker")</p>
        <p>@ActivitySummary.Sparse(Tag, Cells)</p>
    </div>
}
else
{
    <p class="summary">@ActivitySummary.Sentence(Tag, Cells)</p>
    <p class="faint mono">@L("activity.times", ("window", Window))</p>

    <div class="heat-wrap" aria-hidden="true">
        <table class="heat">
            <thead>
                <tr>
                    <td></td>
                    @foreach (var hour in Hours)
                    {
                        @* Every third hour shows a visible label; the rest keep an sr-only header
                           so screen-reader navigation still announces the hour. *@
                        <th scope="col" class="@(hour % 3 == 0 ? null : "quiet")">
                            <span class="@(hour % 3 == 0 ? null : "sr-only")">@hour.ToString("00")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Days)
                {
                    <tr>
                        <th scope="row">@ActivitySummary.ShortDayName(Tag, day)</th>
                        @foreach (var hour in Hours)
                        {
                            var cell = Cell(day, hour);
                            @* Full label lives in the tooltip; the cell itself carries no announced
                               text since the grid is aria-hidden. *@
                            <td class="@CellClass(cell)" style="@CellStyle(cell)" title="@Label(cell)"></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Legend for a drawing that announces nothing, so it's hidden along with it. *@
    <ul class="legend" aria-hidden="true">
        <li><span class="swatch counted"></span>@L("activity.legend.counted")</li>
        <li><span class="swatch unmeasurable"></span>@L("activity.legend.notCounted")</li>
        <li><span class="swatch gap"></span>@L("activity.legend.notMeasured")</li>
    </ul>

    @* Text alternative to the grid, collapsed behind <details> rather than always-visible. *@
    <details class="read-as-text">
        <summary>@L("game.readAsTextRows", ("count", Rows.Count))</summary>
        <table class="perday">
            <caption>@L("activity.caption", ("window", Window))</caption>
            <thead>
                <tr>
                    <th scope="col">@L("activity.column.day")</th>
                    <th scope="col">@L("activity.column.quietest")</th>
                    <th scope="col">@L("activity.column.busiest")</th>
                    <th scope="col">@L("activity.column.at")</th>
                    @* Same string id the cells use, so the panel never uses two words for one state. *@
                    <th scope="col">@L("state.notMeasured")</th>
                    <th scope="col">@L("activity.column.noCount")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Rows)
                {
                    <tr>
                        <th scope="row">@day.Name(Tag)</th>
                        @if (day.Busiest is { } busiest)
                        {
                            <td class="num">@day.Quietest</td>
                            <td class="num">@busiest</td>
                            <td class="num">@($"{day.PeakHour:00}:00")</td>
                        }
                        else
                        {
                            @* Never a zero here: no count was read, which is not a count of none. *@
                            <td class="faint" colspan="3">@L("activity.day.noCount")</td>
                        }
                        <td class="num">@Hourly(day.NotMeasured)</td>
                        <td class="num">@Hourly(day.NotCounted)</td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActivityCell> Cells { get; set; } = [];

    /// <summary>How many weeks the rolling average covers.</summary>
    /// <remarks>A number, not a pre-built sentence, so it stays translatable.</remarks>
    [Parameter] public int Weeks { get; set; } = 8;

    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string Window => L("activity.rollingAverage", ("weeks", Weeks));

    /// <summary>This component's tag, supplied once — the rendering is <see cref="Messages.Say"/>.</summary>
    private string L(string id, params (string Key, object? Value)[] args) =>
        Messages.Say(Tag, id, args);

    private static readonly int[] Hours = [.. Enumerable.Range(0, 24)];

    private IEnumerable<int> Days => Cells.Select(c => c.DayOfWeek).Distinct().Order();

    /// <summary>The seven rows, computed once per render and read by the table under the drawing.</summary>
    private IReadOnlyList<ActivitySummary.DayLine> Rows => ActivitySummary.Days(Cells);

    /// <summary>Whether there is a week here to draw. See <see cref="ActivitySummary.MeasuredDaysForGrid"/>.</summary>
    private bool Enough => ActivitySummary.MeasuredDays(Cells) >= ActivitySummary.MeasuredDaysForGrid;

    /// <summary>Zero hours is printed as a dash, not "0" — a count of zero would misread as a measured zero.</summary>
    private static string Hourly(int hours) => hours == 0 ? "–" : hours.ToString();

    private ActivityCell Cell(int day, int hour) =>
        Cells.FirstOrDefault(c => c.DayOfWeek == day && c.Hour == hour)
        // A cell the store never mentioned was never measured — not "not reachable".
        ?? new ActivityCell(day, hour, null, Probed: false);

    private string Label(ActivityCell cell) => ActivitySummary.CellLabel(Tag, cell);

    private static string CellClass(ActivityCell cell) => cell switch
    {
        { IsGap: true } => "gap",
        { IsUnmeasurable: true } => "unmeasurable",
        { Count: 0 } => "counted zero",
        _ => "counted",
    };

    /// <summary>Only counted cells get a fill intensity — the other two states have no number to shade.</summary>
    private string? CellStyle(ActivityCell cell)
    {
        if (!cell.IsCounted || cell.Count is not { } n || n == 0)
        {
            return null;
        }

        var peak = Cells.Where(c => c.IsCounted).Max(c => c.Count) ?? 1;
        var share = peak <= 0 ? 1 : Math.Max(0.14, (double)n / peak);

        return $"--fill:{share.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}";
    }
}
