@*
    The activity heatmap: day-of-week × hour, in three states.

    Three layers, in the order a listener meets them. **The sentence** is the answer — when is
    anyone actually on — and most readers need nothing after it. **The table** under "read as text"
    is seven rows, one per day, and is the drawing's text alternative: every fact the grid carries
    is in it. **The drawing itself** is hidden from assistive tech, because it now says nothing the
    first two do not, and announced cell by cell it is 168 utterances to deliver one shape.

    Below seven measured days there is no drawing at all. A grid with one probe in it announced
    "not measured" 167 times before reaching the single number that existed, and looked like a fault
    to everybody else.

    Flat fill for counted (including a measured zero), hatched outline for probed-but-uncountable,
    empty for not-reachable. That distinction is the whole of spec §5.4, it is carried by cell shape
    and not by colour, and it survives greyscale printing.
*@

@if (Cells.Count == 0)
{
    <p class="summary">@ActivitySummary.Sentence(Cells)</p>
}
else if (!Enough)
{
    @*
        The panel replaces the summary rather than following it. On two measured hours the summary
        reads "busiest Monday, small hours" — a claim about a week, drawn from a Monday morning, and
        the one kind of sentence this site may not write. What there is, and what has to arrive
        before there is a shape to describe.
    *@
    <div class="sparse">
        <p class="kicker">not enough measurements yet</p>
        <p>@ActivitySummary.Sparse(Cells)</p>
    </div>
}
else
{
    <p class="summary">@ActivitySummary.Sentence(Cells)</p>
    <p class="faint mono">times in UTC · @Window</p>

    <div class="heat-wrap" aria-hidden="true">
        <table class="heat">
            <thead>
                <tr>
                    <td></td>
                    @foreach (var hour in Hours)
                    {
                        @* Every third hour is labelled; the rest keep the column header for the
                           table's own semantics and hide the text, so navigation still announces
                           which hour a cell is in. *@
                        <th scope="col" class="@(hour % 3 == 0 ? null : "quiet")">
                            <span class="@(hour % 3 == 0 ? null : "sr-only")">@hour.ToString("00")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Days)
                {
                    <tr>
                        <th scope="row">@ActivitySummary.ShortDayName(day)</th>
                        @foreach (var hour in Hours)
                        {
                            var cell = Cell(day, hour);
                            @* The whole sentence is the mouse tooltip. The cell carries no announced
                               text: this grid is hidden from assistive tech and the seven rows under
                               it hold the same facts in seven utterances rather than 168. *@
                            <td class="@CellClass(cell)" style="@CellStyle(cell)" title="@Label(cell)"></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* The key to a drawing nothing announces, so it is hidden with the drawing it explains. *@
    <ul class="legend" aria-hidden="true">
        <li><span class="swatch counted"></span>counted, including a measured zero</li>
        <li><span class="swatch unmeasurable"></span>probed, no count could be read</li>
        <li><span class="swatch gap"></span>no measurement in that hour</li>
    </ul>

    @*
        The text alternative, and one keystroke away rather than a wall to scroll past. A real table
        with a caption and headers, so a screen reader can read one cell in the context of its day
        and its column — which is the thing the 7×24 grid was providing at 168 times the cost.
    *@
    <details class="read-as-text">
        <summary>read as text — @Rows.Count rows</summary>
        <table class="perday">
            <caption>Players on by day, in UTC. @Window.</caption>
            <thead>
                <tr>
                    <th scope="col">day</th>
                    <th scope="col">quietest</th>
                    <th scope="col">busiest</th>
                    <th scope="col">at</th>
                    <th scope="col">not measured</th>
                    <th scope="col">no count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Rows)
                {
                    <tr>
                        <th scope="row">@day.Day</th>
                        @if (day.Busiest is { } busiest)
                        {
                            <td class="num">@day.Quietest</td>
                            <td class="num">@busiest</td>
                            <td class="num">@($"{day.PeakHour:00}:00")</td>
                        }
                        else
                        {
                            @* Never a zero here: no count was read, which is not a count of none. *@
                            <td class="faint" colspan="3">no count in any hour</td>
                        }
                        <td class="num">@Hourly(day.NotMeasured)</td>
                        <td class="num">@Hourly(day.NotCounted)</td>
                    </tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActivityCell> Cells { get; set; } = [];

    /// <summary>Stated in words, because a heatmap without its window is an unlabelled average.</summary>
    [Parameter] public string Window { get; set; } = "8-week rolling average";

    private static readonly int[] Hours = [.. Enumerable.Range(0, 24)];

    private IEnumerable<int> Days => Cells.Select(c => c.DayOfWeek).Distinct().Order();

    /// <summary>The seven rows, computed once per render and read by the table under the drawing.</summary>
    private IReadOnlyList<ActivitySummary.DayLine> Rows => ActivitySummary.Days(Cells);

    /// <summary>Whether there is a week here to draw. See <see cref="ActivitySummary.MeasuredDaysForGrid"/>.</summary>
    private bool Enough => ActivitySummary.MeasuredDays(Cells) >= ActivitySummary.MeasuredDaysForGrid;

    /// <summary>A tally of hours, where none of them is a dash rather than a nought.</summary>
    /// <remarks>
    /// Zero hours unmeasured and zero players on are different noughts, and this column sits beside
    /// the one holding the other. The dash is what the rest of the site prints where a number would
    /// be read as a measurement.
    /// </remarks>
    private static string Hourly(int hours) => hours == 0 ? "–" : hours.ToString();

    private ActivityCell Cell(int day, int hour) =>
        Cells.FirstOrDefault(c => c.DayOfWeek == day && c.Hour == hour)
        // A cell the store never mentioned has no measurement — which is all silence can honestly
        // be read as here. Whether the game was reachable in that hour is the strip's question.
        ?? new ActivityCell(day, hour, null, Probed: false);

    private static string Label(ActivityCell cell) => ActivitySummary.CellLabel(cell);

    private static string CellClass(ActivityCell cell) => cell switch
    {
        { IsGap: true } => "gap",
        { IsUnmeasurable: true } => "unmeasurable",
        { Count: 0 } => "counted zero",
        _ => "counted",
    };

    /// <summary>
    /// Only the counted cells carry an intensity, and it is the one place a colour ramp appears on
    /// this site. The other two states have no number to be a shade of.
    /// </summary>
    private string? CellStyle(ActivityCell cell)
    {
        if (!cell.IsCounted || cell.Count is not { } n || n == 0)
        {
            return null;
        }

        var peak = Cells.Where(c => c.IsCounted).Max(c => c.Count) ?? 1;
        var share = peak <= 0 ? 1 : Math.Max(0.14, (double)n / peak);

        return $"--fill:{share.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}";
    }
}
