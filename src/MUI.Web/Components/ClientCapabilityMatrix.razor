@using MUI.Web.Localization
@using MUI.Web.Reference

@*
    Unlike the game pages' CapabilityMatrix (two columns: measured vs declared), this table has only
    one kind of claim — documentation somebody read — so the citation is the load-bearing part: an
    uncited cell isn't a weaker claim, it's not a claim at all, and renders as unknown.

    Capability names (TLS, MCCP, GMCP) stay untranslated machine voice so a client's row still reads
    against a game's regardless of locale.
*@

<div class="section-head">
    <h2 id="@Id">@Messages.For(Tag, "reference.capabilities.heading")</h2>
    <p class="count faint">
        @Messages.Say(Tag, "reference.capabilities.established",
            ("count", Established), ("total", Claims.Count))
    </p>
</div>

<p class="dim">@ReferencePlainText.ClientMatrixCaveat(Tag)</p>

<table class="matrix client-matrix">
    <caption class="sr-only">@Messages.For(Tag, "reference.capabilities.caption")</caption>
    <thead>
        <tr>
            <th scope="col">@Messages.For(Tag, "capability.column")</th>
            <th scope="col">@Messages.For(Tag, "reference.capabilities.column.documented")</th>
            <th scope="col">@Messages.For(Tag, "reference.capabilities.column.source")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in Claims)
        {
            <tr class="@(claim.Name == ClientCapabilities.ScreenReader ? "accessibility" : null)">
                <th scope="row"><span class="mono">@claim.Name</span></th>

                @* The word carries the state; colour only reinforces it, so greyscale/screen-reader/
                   print still distinguish unknown from no. *@
                <td class="mono">
                    <span class="@Tone(claim.State)">@ClientCapabilities.Word(Tag, claim.State)</span>
                </td>
                <td class="mono faint">
                    @if (claim.Source is { } source)
                    {
                        <a href="@source" rel="nofollow noopener">@Host(source)</a>
                    }
                    else
                    {
                        <text>@Messages.For(Tag, "reference.capabilities.noSource")</text>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CapabilityClaim> Claims { get; set; } = [];

    [Parameter] public string Id { get; set; } = "capabilities";

    /// <summary>The request, for the language every word round this table is written in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private int Established => Claims.Count(c => c.IsClaimed);

    /// <summary>Accent for a documented yes, amber for a documented no, unknown tone otherwise.</summary>
    private static string Tone(CapabilityState state) => state switch
    {
        CapabilityState.Present => "state-present",
        CapabilityState.Absent => "state-absent",
        _ => "state-unknown",
    };

    /// <summary>
    /// The host, not the whole URL. A citation column of eighty-character links is unreadable, and
    /// the link itself still goes where it says.
    /// </summary>
    private static string Host(string source) =>
        Uri.TryCreate(source, UriKind.Absolute, out var uri) ? uri.Host : source;
}
