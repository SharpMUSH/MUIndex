@using MUI.Web.Localization

@*
    The capability matrix: measured and declared as two columns, never merged into one badge —
    merging what the handshake showed with what the game claims would throw away the only
    interesting case, a disagreement. Disagreements sort to the top and are marked in the row itself
    rather than by tint alone.
*@

<div class="section-head">
    <h2 id="@Id">@Messages.For(Tag, "game.capabilities")</h2>
</div>

@* Six columns of nowrap cells don't fit a phone, and the page body may never scroll sideways —
   so the table scrolls inside its own box, the same rule the ANSI frame follows. *@
<div class="table-wrap">
<table class="matrix">
    @* The tally, once, as the caption — it used to duplicate the section heading verbatim, so a
       screen reader heard the same sentence twice before reaching a row. *@
    <caption class="count @(Disagreements.Count > 0 ? "warn" : "faint")">
        @Messages.For(Tag, "capabilities.agree", new Dictionary<string, object?>
        {
            ["disagreeing"] = Disagreements.Count,
            ["total"] = Rows.Count,
        })
    </caption>
    <thead>
        <tr>
            <th scope="col">@Messages.For(Tag, "capability.column")</th>
            <th scope="col">@Messages.For(Tag, "kicker.measured")</th>
            <th scope="col">@Messages.For(Tag, "kicker.declared")</th>
            <th scope="col">@Messages.For(Tag, "capability.age")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Sorted)
        {
            <tr class="@(row.Disagrees ? "disagrees" : null)">
                <th scope="row">
                    <span class="mono">@row.Protocol</span>
                    @if (row.Disagrees)
                    {
                        @* A word in the row, not a background tint — a tint is invisible in
                           greyscale, to a screen reader, and when printed. *@
                        <span class="mark warn">@Messages.For(Tag, "capability.disagrees")</span>
                    }
                </th>
                <td class="mono">@((MarkupString)Cell(Tag, row.Measured, measured: true))</td>
                <td class="mono">@((MarkupString)Cell(Tag, row.Declared, measured: false))</td>
                <td class="mono faint">
                    @if (row.LastConfirmedAt is { } at)
                    {
                        <Moment At="at" Now="Now" Spoken="true" />
                    }
                    else
                    {
                        <text>@Messages.For(Tag, "listing.never")</text>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Disagreements.Count > 0)
{
    <details class="disagreement">
        <summary>@Messages.For(Tag, "capability.whereTheyDisagree", new Dictionary<string, object?> { ["count"] = Disagreements.Count })</summary>
        @foreach (var row in Disagreements)
        {
            <p>
                <strong class="mono">@row.Protocol</strong> —
                @Messages.For(Tag, row.Measured is CapabilityState.Absent
                    ? "capability.disagree.declaredNotOffered"
                    : "capability.disagree.offeredNotDeclared")
            </p>
        }
        @* Said once, under the whole list. Inside the loop it repeated verbatim per protocol. *@
        <p class="dim">@Messages.For(Tag, "capability.disagree.note")</p>
    </details>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CapabilityRow> Rows { get; set; } = [];

    [Parameter] public string Id { get; set; } = "capabilities";

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    /// <summary>The request, for the locale its caption is written in.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Tag => HttpContext.LocaleOf().Tag;

    /// <summary>Disagreements first, then measured-present, then absent, then unknown.</summary>
    private IEnumerable<CapabilityRow> Sorted => Rows
        .OrderByDescending(r => r.Disagrees)
        .ThenBy(r => r.Measured switch
        {
            CapabilityState.Present => 0,
            CapabilityState.Absent => 1,
            _ => 2,
        })
        .ThenBy(r => r.Protocol, StringComparer.Ordinal);

    private IReadOnlyList<CapabilityRow> Disagreements => [.. Rows.Where(r => r.Disagrees).OrderBy(r => r.Protocol, StringComparer.Ordinal)];

    /// <summary>
    /// Glyph and word together — the glyph is the state, and the cell still says which of the four
    /// things it is with no colour at all.
    /// </summary>
    private static string Cell(string tag, CapabilityState state, bool measured)
    {
        var (css, glyph, id) = (state, measured) switch
        {
            (CapabilityState.Present, true) => ("state-present", "●", "capability.offered"),
            (CapabilityState.Present, false) => ("state-declared", "◇", "capability.claimed"),
            (CapabilityState.Absent, true) => ("state-absent", "✕", "capability.absent"),
            (CapabilityState.Absent, false) => ("state-absent", "✕", "capability.denied"),
            _ => ("state-unknown", "–", "capability.silent"),
        };

        // Escaped: the word comes out of a translator-writable bundle, and a message must not be
        // able to become markup.
        var word = System.Net.WebUtility.HtmlEncode(Messages.For(tag, id));

        return $"<span class=\"{css}\">{glyph} {word}</span>";
    }
}
