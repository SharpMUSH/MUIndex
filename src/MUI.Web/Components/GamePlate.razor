@using MUI.Web.Icons

@*
    A game's face: the icon it published, where we hold one, and its monogram otherwise.

    Served from this origin, never hot-linked — that would hand every reader's address to a
    third-party server for a decoration (§11). A game with no icon gets no placeholder or broken
    image: a fetch failure is our afternoon, not a fact about their game (rule 5).

    aria-hidden on the monogram and alt="" on the image: the game's name is the link right beside
    this, so a screen reader announcing the picture too would read the name twice.
*@

@if (HasIcon)
{
    <img class="plate icon" alt="" src="@IconEndpoint.For(Slug)"
         width="@Size" height="@Size" loading="lazy" decoding="async" />
}
else if (Fallback)
{
    <div class="plate mono" aria-hidden="true">@Monogram.Of(Name)</div>
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Whether we hold bytes for this game — never whether it declared an icon.</summary>
    [Parameter] public bool HasIcon { get; set; }

    /// <summary>
    /// Whether a game with no icon gets a monogram, or gets no element at all.
    /// </summary>
    /// <remarks>
    /// Off on the game page, per the handoff: one 96px monogram at the top of a page is a brand the
    /// game never supplied, which is the one kind of decoration this site's measured-only claim can't
    /// afford. On the listing it is the opposite — the plate's whole job there is a fixed left edge
    /// down five hundred rows, and an edge that appears on one row in twenty is furniture instead.
    /// </remarks>
    [Parameter] public bool Fallback { get; set; }

    /// <summary>
    /// The box the plate occupies, which the stylesheet fixes and this repeats on the element.
    /// </summary>
    /// <remarks>
    /// Reserves layout space before the bytes arrive, so a listing of lazily-loaded images doesn't
    /// reflow as the reader scrolls.
    /// </remarks>
    [Parameter] public int Size { get; set; } = 36;
}
