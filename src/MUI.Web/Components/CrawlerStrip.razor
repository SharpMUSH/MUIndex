@using MUI.Catalog
@using MUI.Web.Localization

@*
    The instrument, shown running. Every number on this site is downstream of one crawl loop; this is
    what lets a reader see it stalled instead of the site quietly rendering stale measurements as
    fresh. Says nothing when there is nothing measured to say (CrawlerPulse.Unknown, also the demo
    path) — an empty strip is honest, an invented one is not.
*@

@if (Pulse.State(Now) is not CrawlState.NotYet)
{
    <p class="crawler mono faint">
        <span class="@StateClass" aria-hidden="true">●</span>
        @CrawlerCopy.State(Tag, Pulse, Now)@(LastCycle is null ? "" : " · ") @LastCycle
    </p>
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    [Parameter, EditorRequired] public CrawlerPulse Pulse { get; set; } = CrawlerPulse.Unknown;

    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }

    private string? LastCycle => CrawlerCopy.LastCycle(Tag, Pulse);

    // Working is the only state that gets the "present" colour the counts above use. Quiet is
    // deliberately the faint one and not a red: we do not know that anything is wrong, and a strip
    // that alarms on a lease held by another replica is a strip that trains its reader to ignore it.
    private string StateClass => Pulse.State(Now) is CrawlState.Working ? "state-present" : "state-unknown";
}
