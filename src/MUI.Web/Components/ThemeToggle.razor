@using MUI.Web.Localization
@using MUI.Web.Theme

@*
    Three buttons rather than one flip. A flip needs a label like "switch to light", but the server
    doesn't know what to write for a reader who's never chosen — prefers-color-scheme never reaches
    us — and it has no way back: once flipped off "follow my system", a reader is pinned for good.

    Each button is its own submit with its own value, so choosing is one press from anywhere.
*@
@*
    Posted to this locale's copy of the endpoint: a reader who followed a shared /de/… link carries
    no cookie, so the locale is in the path or nowhere.
*@
<form class="theme" method="post" action="@HttpContext.Link(ReaderTheme.Path)" aria-labelledby="theme-label">
    <span id="theme-label" class="kick">@Messages.For(Tag, "theme.label")</span>
    <input type="hidden" name="@ReaderTheme.ReturnField" value="@Here" />
    @foreach (var choice in ReaderTheme.Choices)
    {
        <button type="submit" name="@ReaderTheme.Field" value="@ReaderTheme.Word(choice)" aria-pressed="@Pressed(choice)">@Messages.For(Tag, "theme." + ReaderTheme.Word(choice))</button>
    }
</form>

@code {
    /// <summary>The request, for the cookie it carries and the URL it arrived at.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ThemeChoice InForce => ReaderTheme.Of(HttpContext);

    private string Tag => HttpContext.LocaleOf().Tag;

    /// <summary>
    /// The page this control was rendered on, so choosing does not lose the reader's place.
    /// </summary>
    /// <remarks>
    /// The query string travels with it: changing the theme shouldn't reset a narrowed listing.
    /// <para>
    /// <c>ToUriComponent</c>, not the decoded values — a raw character here is refused by
    /// <see cref="ReaderTheme.Back"/> and lands the reader on the front page instead.
    /// </para>
    /// </remarks>
    private string Here =>
        HttpContext is { } context
            ? context.Request.Path.ToUriComponent() + context.Request.QueryString.ToUriComponent()
            : "/";

    /// <summary>
    /// Which one is in force, written out rather than left to colour.
    /// </summary>
    /// <remarks>
    /// A literal string, not a bool: Razor renders a bool-valued attribute by presence, so
    /// <c>aria-pressed</c> would vanish for the two buttons that aren't pressed.
    /// </remarks>
    private string Pressed(ThemeChoice choice) => choice == InForce ? "true" : "false";
}
