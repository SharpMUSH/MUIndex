@using MUI.Web.Theme
@using MUI.Web.Localization

@* data-theme is written only when the reader has explicitly chosen one — leaving it absent hands
   the decision to prefers-color-scheme in app.css, so a system-light reader gets light rather than
   the dark default being force-pinned. *@
@* lang must be the actual locale, not a constant: Unicode unifies Han characters across CJK
   locales, so the wrong `lang` renders Japanese text with Chinese glyph forms — and it's also what
   a screen reader uses to choose voice. *@
<!DOCTYPE html>
<html lang="@Locale.Tag" data-theme="@ReaderTheme.Attribute(Theme)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@ReaderTheme.ColorScheme(Theme)" />
    @* No <base href="/">: it's inert under static server rendering, and it silently broke every
       bare-query-string link (e.g. "?plain=1") by resolving it against the base instead of the
       current page. Everything in this head is written absolute for the same reason. *@
    @* Fingerprinted rather than a bare "app.css": the front proxy caches wwwroot for hours, so an
       unfingerprinted name would serve new markup against a stale cached stylesheet after a deploy. *@
    <link rel="stylesheet" href="@Stylesheet" />

    @* SVG is the real icon (stays sharp at any size); .ico is the fallback for browsers that need one. *@
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    @* Manifest declares display: browser — no install prompt. Deliberate: these pages are static
       documents with no offline story, so an installable shell would just go blank without a network. *@
    <link rel="manifest" href="/site.webmanifest" />

    @* Both meta tags when we don't know the reader's theme (a single theme-color would put a dark
       chrome bar above a light page for half of them); one tag when the reader has pinned a choice. *@
    @if (Theme is ThemeChoice.System)
    {
        <meta name="theme-color" content="@ReaderTheme.Plate(ThemeChoice.Dark)" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="@ReaderTheme.Plate(ThemeChoice.Light)" media="(prefers-color-scheme: light)" />
    }
    else
    {
        <meta name="theme-color" content="@ReaderTheme.Plate(Theme)" />
    }

    <HeadOutlet />
</head>
<body>
    <Routes />
    @* No blazor.web.js: static server rendering only. Adding it would opt the site into enhanced
       navigation and break the no-script guarantee the facet panel and plain mode depend on. *@
</body>
</html>

@code {
    /// <summary>The request, for the one thing this document asks it: which theme was chosen.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The reader's chosen theme, read once and applied consistently across data-theme, color-scheme, and theme-color.</summary>
    private ThemeChoice Theme => ReaderTheme.Of(HttpContext);

    /// <summary>The locale this document is being answered in, which is what <c>lang</c> states.</summary>
    private Locale Locale => HttpContext.LocaleOf().Locale;

    /// <summary>The stylesheet's absolute, fingerprinted address.</summary>
    private string Stylesheet => "/" + Assets["app.css"];
}
