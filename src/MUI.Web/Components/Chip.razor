@*
    The provenance chip. One glyph, one relative age, no border.

    The glyph carries the state and the colour only reinforces it, so greyscale printing and
    colour-blind rendering both survive — that is a design constraint, not a nicety.
*@
<span class="chip @Class" title="@Title">
    @if (ValueShown)
    {
        <span class="value">@Fact.Value</span>
    }
    else
    {
        @* Without the value there is nothing left but a glyph, a colour and an age, and neither of
           the first two is a fact anybody can hear. The word goes in for a reader who is listening
           rather than looking — where the value is shown, the title carries it as it always has. *@
        <span class="sr-only">@Word</span>
    }
    <span class="glyph" aria-hidden="true">@Glyph</span>
    <span class="age">@Age</span>
</span>

@code {
    [Parameter, EditorRequired] public ProvenanceChip Fact { get; set; } = default!;
    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    /// <summary>
    /// Whether the chip prints the value it labels.
    /// </summary>
    /// <remarks>
    /// Off where the surrounding sentence already says it — "9 players on now" does not want a
    /// second 9 beside it — so a count and a field wear one chip rather than two that resemble each
    /// other. Everything else about the chip is identical, which is the point of the parameter.
    /// </remarks>
    [Parameter] public bool ValueShown { get; set; } = true;

    private string Word => Fact.IsMeasured ? "measured" : "declared";

    private string Glyph => Fact.IsMeasured ? "●" : "◇";

    private string Class => Word + (Fact.IsStale ? " stale" : string.Empty);

    private string Age => Relative.Format(Now - Fact.LastConfirmedAt);

    // The full record belongs in the title as well as the expanded view: a reader hovering wants
    // the absolute time, and a screen reader gets the source named rather than inferred from colour.
    private string Title =>
        $"{Fact.Value} — {Word} via {Fact.Source}, "
        + $"last confirmed {Fact.LastConfirmedAt:u}{(Fact.IsStale ? " (past its expected refresh)" : string.Empty)}";
}
