@using MUI.Web.Localization
@*
    The provenance chip. One glyph, one relative age, no border.

    The glyph carries the state and colour only reinforces it, so greyscale printing and
    colour-blind rendering both survive.
*@
<span class="chip @Class" title="@Title">
    @if (ValueShown)
    {
        <span class="value">@Fact.Value</span>
    }
    else
    {
        @* Without the value there's only a glyph and a colour, neither of which a screen reader can
           hear — so the word goes in for a reader who is listening rather than looking. *@
        <span class="sr-only">@Word</span>
    }
    @if (GlyphShown)
    {
        <span class="glyph" aria-hidden="true">@Glyph</span>
    }
    @* The age, as a resolvable <time>. Spoken where the chip carries its own value (the game page's
       fields), short where it rides a listing row. *@
    @if (AgeShown)
    {
        <Moment At="Fact.LastConfirmedAt" Now="Now" Spoken="ValueShown" Class="age" />
    }
</span>

@code {
    [Parameter, EditorRequired] public ProvenanceChip Fact { get; set; } = default!;
    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    /// <summary>
    /// Whether the chip prints the value it labels.
    /// </summary>
    /// <remarks>
    /// Off where the surrounding sentence already says it — "9 players on now" doesn't want a
    /// second 9 beside it.
    /// </remarks>
    [Parameter] public bool ValueShown { get; set; } = true;

    /// <summary>
    /// Whether the chip draws the state glyph, or leaves it to the sentence it sits in.
    /// </summary>
    /// <remarks>
    /// Off in exactly one place: a listing row's player count, which draws the glyph itself at the
    /// head of the figure. The row used to ship both, so one fact wore two identical diamonds four
    /// characters apart. Colour, title and the screen-reader word are unchanged — only the duplicate
    /// is dropped.
    /// </remarks>
    [Parameter] public bool GlyphShown { get; set; } = true;

    /// <summary>Whether the chip prints the age of the thing it labels.</summary>
    /// <remarks>
    /// Off on a listing row, which already has its own freshness column dating the same probe — the
    /// chip's age was a second copy read out four characters apart. The title still carries the
    /// absolute time.
    /// </remarks>
    [Parameter] public bool AgeShown { get; set; } = true;

    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string Word => Messages.For(
        Tag, Fact.IsMeasured ? "provenance.game.measured" : "provenance.game.declared");

    private string Glyph => Fact.IsMeasured ? "●" : "◇";

    // The class name is a stylesheet selector, not a translated word — it stays English.
    private string Class => (Fact.IsMeasured ? "measured" : "declared")
        + (Fact.IsStale ? " stale" : string.Empty);

    // "Last confirmed" says when *we* last saw the value, never when the game did anything — the
    // difference between recording our measurement and recording a decision of ours.
    private string Title => Messages.For(
        Tag,
        Fact.IsStale ? "chip.title.stale" : "chip.title",
        new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["value"] = Fact.Value,
            ["how"] = Word,
            ["source"] = Provenance.Via(Tag, Fact.Source),
            ["date"] = Dates.Stamp(Tag, Fact.LastConfirmedAt),
        });
}
