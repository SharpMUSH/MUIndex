@* NotFoundPage rather than the <NotFound> fragment: the fragment never renders under static server
   rendering, so a mistyped URL got an empty 404 body instead. Same page whether the route failed
   to match or a page decided there was nothing at it. *@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(MUI.Web.Components.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
    </Found>
</Router>
