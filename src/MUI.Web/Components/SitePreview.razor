@using MUI.Catalog
@using MUI.Web.Data
@using MUI.Web.Localization
@inject CatalogueSource Catalogue

@*
    Everything a program reads about this page, and nothing a reader sees.

    One component rather than tags per page, because these rules are the site's and not each page's:
    the query string comes off the canonical URL, the fixture confesses in the metadata (the demo
    banner can't follow a link into a chat client), and the title carries the wordmark once.
*@

<PageTitle>@Heading</PageTitle>

<HeadContent>
    <meta name="description" content="@Text" />
    <link rel="canonical" href="@Canonical" />

    @*
        The same document in every language it exists in.

        A locale that lives only in a cookie or Accept-Language gives one URL two bodies, and a
        search engine indexes whichever it happened to be served. x-default points at the unprefixed
        URL, telling a crawler that's the fallback for an unmatched language.

        Emitted only where there is more than one locale to name.
    *@
    @if (Http is { } request && Locales.Offered.Count > 1)
    {
        @foreach (var (hreflang, path) in LocaleRouting.Alternates(request.PathWithinLocale()))
        {
            <link rel="alternate" hreflang="@hreflang" href="@request.Absolute(path)" />
        }
    }

    <meta property="og:site_name" content="@PreviewCopy.SiteName" />
    <meta property="og:type" content="@(Card is PreviewCard.Reference ? "article" : "website")" />
    <meta property="og:title" content="@Heading" />
    <meta property="og:description" content="@Text" />
    <meta property="og:url" content="@Canonical" />
    <meta property="og:image" content="@Image" />
    <meta property="og:image:alt" content="@PreviewCopy.CardAlt(Tag, Title)" />

    @* summary_large_image, not summary: the cards are 1200×630 and a small card would letterbox
       them into an unreadable strip. *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Heading" />
    <meta name="twitter:description" content="@Text" />
    <meta name="twitter:image" content="@Image" />

    @if (StructuredData is { } graph)
    {
        @* Raw, because it's JSON not markup. Safe only because GameStructuredData serialises with
           the default encoder, which escapes angle brackets — see that type's remarks. *@
        @((MarkupString)$"<script type=\"application/ld+json\">{graph}</script>")
    }
</HeadContent>

@code {
    /// <summary>
    /// The request being answered, for the absolute URLs an unfurler cannot resolve for itself.
    /// </summary>
    /// <remarks>
    /// Null under a headless render (how component tests invoke a page); the absolute forms fall
    /// back to the path, which an unfurler never reaches anyway.
    /// </remarks>
    [CascadingParameter]
    public HttpContext? Http { get; set; }

    /// <summary>This page's own part of the title. Null on the front page, which is just the wordmark.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The locale this request is being answered in, which the metadata is written in too.</summary>
    /// <remarks>
    /// A German page used to carry an English title, description and card — invisible on the page
    /// itself, but wrong on a search result, an unfurled link, or a bookmark.
    /// </remarks>
    private string Tag => Http.LocaleOf().Tag;

    /// <summary>What this page is, in a sentence or two. Required — a page without one is summarised
    /// by whoever links to it, from whatever text happens to come first in the body.</summary>
    /// <remarks>
    /// Defaulted to null and resolved against the request's locale, since a parameter initialiser
    /// has no locale to resolve the default sentence in.
    /// </remarks>
    [Parameter, EditorRequired]
    public string? Description { get; set; }

    [Parameter]
    public PreviewCard Card { get; set; } = PreviewCard.Site;

    /// <summary>
    /// Whether this page shows catalogue data, and so has to confess when the catalogue is a fixture.
    /// </summary>
    /// <remarks>
    /// False for prose/form pages — signing in, submitting a game, a 404. Those say the same true
    /// thing with or without a database behind them, so the demo disclaimer would be about nothing.
    /// </remarks>
    [Parameter]
    public bool Data { get; set; } = true;

    /// <summary>
    /// Builds the schema.org graph, given this site's origin. Only a game page has one.
    /// </summary>
    /// <remarks>
    /// A function rather than a string, so the builder never runs at all over the fixture, where
    /// its output would just be thrown away.
    /// </remarks>
    [Parameter]
    public Func<Uri, string>? Graph { get; set; }

    private string Heading => PreviewCopy.Title(Tag, Title);

    private string Said => Description ?? PreviewCopy.Site(Tag);

    private string Text => Data && !Catalogue.IsMeasured
        ? PreviewCopy.Demo(Tag, Said)
        : Said;

    private string Canonical => Http is null
        ? "/"
        : SiteUrls.CanonicalOf(Http);

    private string Image => Http is null
        ? CardPath
        : SiteUrls.Absolute(Http, CardPath);

    private string CardPath => $"/og/{Card.ToString().ToLowerInvariant()}.png";

    /// <summary>
    /// The graph, or nothing at all over the fixture.
    /// </summary>
    /// <remarks>
    /// <b>There is no honest way to ship invented structured data.</b> Its audience is programs,
    /// none of which render the demo banner, and the vocabulary has no field meaning "unmeasured" —
    /// so absent is the only correct answer over the fixture.
    /// </remarks>
    private string? StructuredData => Catalogue.IsMeasured && Graph is not null && Http is not null
        ? Graph(SiteUrls.OriginOf(Http))
        : null;
}
