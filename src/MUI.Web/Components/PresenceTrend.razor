@using MUI.Web.Localization

@*
    The presence trend: measured players per day, over a calendar range the reader can move. The
    heatmap beside it answers "when is anyone on" and destroys "is this game growing" — this is that
    second question.

    Two drawings of the same numbers, chosen in the address and defaulting to the line — see
    TrendShape for which fits which crawl cadence.

    One rule outlives the choice: nothing is drawn on a day nobody measured. The line breaks in its
    path data, the columns simply have no column, and neither shape interpolates across the gap — a
    continuous line over one would draw our crawl schedule as their quiet fortnight. A day probed
    without a readable count is a mark in its own gutter *below* the baseline, never a point or bar
    at zero, which would read as a measured empty game (§5.4's middle state collapsed into a filled
    one).

    Inert SVG, computed on the server, so the numbers reach a text browser through the same
    PerWeek() lines the disclosure below uses rather than a second implementation that could
    disagree.
*@

<p class="summary">@Sentence</p>
<p class="faint mono">@L("trend.range", ("from", Series.From), ("to", Series.To))</p>

@if (Series.HasAnyCount)
{
    <div class="trend-wrap">
        @* One image with one label; every day is announced through the disclosure below rather than
           as ninety focusable shapes, same choice as the availability strip. *@
        <svg class="trend" viewBox="0 0 @Box" preserveAspectRatio="none"
             role="img" aria-label="@Sentence">
            @* The plot is a surface rather than a hole in the page — without it, ninety unmeasured
               days are the page's own background and the graphic reads as a fault. *@
            <rect class="plot" x="0" y="0" width="@N(TrendGeometry.Width)" height="@N(TrendGeometry.Zero)"></rect>

            @foreach (var month in TrendGeometry.Months(Tag, Series))
            {
                <line class="monthline" x1="@N(month.X)" x2="@N(month.X)"
                      y1="0" y2="@N(TrendGeometry.Zero)"></line>
            }

            @foreach (var (value, y) in TrendGeometry.Gridlines(Series))
            {
                <line class="@(value == 0 ? "axis" : "grid")" x1="0" x2="@TrendGeometry.Width"
                      y1="@N(y)" y2="@N(y)"></line>
            }

            @if (Shape is TrendShape.Bar)
            {
                @foreach (var bar in TrendGeometry.Bars(Series))
                {
                    @* The spread first, so the mean is drawn over it and nothing hides the
                       measurement the bar is mostly about. *@
                    @if (bar.HasCap)
                    {
                        <path class="peak" d="@TrendGeometry.Column(bar.X, bar.Width, bar.PeakTop, bar.CapBottom)">
                            <title>@bar.Day.Label(Tag)</title>
                        </path>
                    }

                    <path class="mean" d="@TrendGeometry.Column(bar.X, bar.Width, bar.MeanTop, TrendGeometry.Zero)">
                        <title>@bar.Day.Label(Tag)</title>
                    </path>
                }
            }
            else
            {
                @foreach (var band in TrendGeometry.BandPaths(Series))
                {
                    <path class="band" d="@band"></path>
                }

                @foreach (var path in TrendGeometry.MeanPaths(Series))
                {
                    <path class="line" d="@path"></path>
                }

                @* A day with no measured neighbour, which no path can carry — bigger than the mark a
                   line would give it, since on a sparsely probed game these dots are the whole chart. *@
                @foreach (var dot in TrendGeometry.Dots(Tag, Series))
                {
                    <circle class="dot" cx="@N(dot.X)" cy="@N(dot.Y)" r="3.5">
                        <title>@dot.Label</title>
                    </circle>
                }
            }

            @* The hatched state, in its own gutter under the baseline. *@
            @foreach (var tick in TrendGeometry.Ticks(Tag, Series))
            {
                <rect class="uncounted" x="@N(tick.X)" y="@N(TrendGeometry.Zero + 4)"
                      width="@N(Math.Max(tick.Width - 0.5, 0.5))" height="6">
                    <title>@tick.Label</title>
                </rect>
            }

            @* A transparent strip per day, so a mouse reader gets a label on every column, including
               the ones with nothing drawn — where "not measured" is said, not merely left blank. *@
            @foreach (var column in TrendGeometry.Columns(Series))
            {
                <rect class="hit" x="@N(column.X)" y="0"
                      width="@N(column.Width)" height="@TrendGeometry.Height">
                    <title>@column.Day.Label(Tag)</title>
                </rect>
            }
        </svg>

        @* Outside the SVG because the canvas is stretched to the page width — text inside it would
           be stretched with it. *@
        <div class="trend-axis mono faint" aria-hidden="true">
            @foreach (var month in TrendGeometry.Months(Tag, Series))
            {
                <span style="left: @N(month.Fraction * 100)%">@month.Label</span>
            }
        </div>

        <div class="trend-scale mono faint">
            <span>@L("trend.ceiling", ("value", Series.Ceiling))</span>
            <span>@L("trend.counted", ("counted", Series.CountedDays), ("days", Series.Days.Count))</span>
        </div>
    </div>

    <ul class="legend">
        @if (Shape is TrendShape.Bar)
        {
            <li><span class="swatch mean" aria-hidden="true"></span>@L("trend.legend.mean")</li>
            <li><span class="swatch peak" aria-hidden="true"></span>@L("trend.legend.peak")</li>
        }
        else
        {
            <li><span class="swatch line" aria-hidden="true"></span>@L("trend.legend.mean")</li>
            <li><span class="swatch band" aria-hidden="true"></span>@L("trend.legend.band")</li>
        }
        <li><span class="swatch uncounted" aria-hidden="true"></span>@L("trend.legend.notCounted")</li>
        <li>
            @* The whole clause is the id, not "not measured" plus a dash and a fragment — what
               follows the dash moves inside the sentence for translation. *@
            <span class="swatch gap" aria-hidden="true"></span>
            @L(Shape is TrendShape.Bar ? "trend.legend.notMeasured.bar" : "trend.legend.notMeasured.line")
        </li>
    </ul>

    <details class="disclosure">
        <summary>@L("a11y.readAsText")</summary>
        <ul class="weeks mono">
            @foreach (var line in Series.PerWeek(Tag))
            {
                <li>@line</li>
            }
        </ul>
    </details>
}
else
{
    @* No cause given, and none available: a failed probe writes no presence row at all, so an empty
       range covers unreachable and never-probed days alike — naming one would record our own
       decision as a measurement of theirs. *@
    <p class="faint">@L("trend.empty")</p>
}

@code {
    [Parameter, EditorRequired] public TrendSeries Series { get; set; } = default!;

    /// <summary>Which drawing of the same numbers — see <see cref="TrendShape"/> for why there are two.</summary>
    [Parameter] public TrendShape Shape { get; set; } = TrendShape.Line;

    /// <summary>The request, for the locale its ninety tooltips are written in.</summary>
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// The chart said in words. Rendered once and used twice — as the paragraph above the drawing
    /// and as its own label — since a second call would be a second chance for them to differ.
    /// </summary>
    private string Sentence => Series.Sentence(Tag);

    private string L(string id) => Messages.For(Tag, id);

    /// <summary>This component's tag, supplied once — the rendering is <see cref="Messages.Say"/>.</summary>
    private string L(string id, params (string Key, object? Value)[] args) =>
        Messages.Say(Tag, id, args);

    private static string Box =>
        $"{N(TrendGeometry.Width)} {N(TrendGeometry.Height)}";

    /// <summary>
    /// A number as SVG wants it.
    /// </summary>
    /// <remarks>
    /// Invariant, always — Razor would otherwise render a coordinate under the request's culture,
    /// and <c>0,5</c> in path data reads as two numbers to every renderer.
    /// </remarks>
    private static string N(double value) => TrendGeometry.Round(value);
}
