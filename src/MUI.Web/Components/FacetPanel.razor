@using MUI.Web.Localization

@*
    The facet panel: one plain GET form, no script.

    The querystring *is* the state — no control here remembers anything else — so a filtered listing
    is linkable, the back button works, and a shared link renders the same page for its recipient.

    Every count beside a value came from the same pass that produced the listing below it (see
    FacetedSearch), so a choice cannot promise results it will not deliver, and a value nothing
    matches is never drawn at all.
*@

<form method="get" action="@Http.Link("/games")" role="search" class="facet-form">
    @*
        The only remaining form control. Sort is now a pressed-state switch in the listing's own
        toolbar and every facet below applies on click; a text field still needs a submit because it
        has nothing to click on its own.
    *@
    <div class="filter-bar">
        <label for="q" class="sr-only">@Messages.For(Tag, "filters.search.label")</label>
        <span class="search-field">
            <span class="search-glyph mono" aria-hidden="true">⌕</span>
            <input id="q" type="search" name="@FacetKeys.Text" value="@Filter.Text"
                   placeholder="@Messages.For(Tag, "filters.search.placeholder")" />
            @* Inside the field rather than beside it — the 268px column has no room for a second box. *@
            <button type="submit" class="search-go" aria-label="@Messages.For(Tag, "filters.search.label")">
                <span aria-hidden="true">→</span>
            </button>
        </span>
    </div>

    @*
        Below 900px the panel is a disclosure above the listing; above it, the same markup renders
        with no disclosure (CSS forces the content visible and hides the summary). Starts open
        whenever a filter is actually in force.
    *@
    <details class="facet-collapse" open="@AnyFiltered">
        <summary>
            <span class="summary-word">@Messages.For(Tag, "filters.summary")</span>
            @if (Chips.Count > 0)
            {
                <span class="summary-count">@Chips.Count</span>
            }
        </summary>
        <div class="facet-body">

    @if (Facets.Count > 0)
    {
        @*
            One row per value, three states: off · only · anything but. Two links per row — tick to
            include, − to exclude — each a link to this listing asked one facet differently, so they
            apply on click with no script. The exclusion is the same !value token the binding and read
            API already parse.
        *@
        <div class="facet-grid">
            @foreach (var group in Primary)
            {
                @Group(group)
            }
        </div>

        @*
            What we could measure: two independent tri-state switches (a game can be uncounted, or
            unreachable, or both) under one shared heading — they aren't an exclusive scale, so they
            can't be one facet group.

            The note is not decoration: hiding a game because we couldn't measure it is a decision
            about this listing, and it must not read as a claim that those games are empty (rule 5).
        *@
        @if (Measurable is { Count: > 0 } measurable)
        {
            <fieldset class="facet choice measure @(measurable.Any(g => g.IsFiltered) ? "chosen" : null)">
                <legend>
                    <span class="facet-head">
                        <span class="facet-name">@Messages.For(Tag, "facet.group.measure")</span>
                        @Evidence(measurable[0])
                    </span>
                    <span class="facet-note">@Messages.For(Tag, "facet.measure.note")</span>
                </legend>
                <div class="rows">
                    @foreach (var group in measurable)
                    {
                        @Row(group, group.Values[0])
                    }
                </div>
            </fieldset>
        }

        @* Everything else, behind one disclosure that opens itself when one of them is active. *@
        @if (Secondary is { Count: > 0 } more)
        {
            <details class="facet-more-groups" open="@more.Any(g => g.IsFiltered)">
                <summary>@Messages.For(Tag, "facet.more", new Dictionary<string, object?> { ["count"] = more.Count })</summary>
                <div class="facet-grid">
                    @foreach (var group in more)
                    {
                        @Group(group)
                    }
                </div>
            </details>
        }

        @foreach (var group in Facets.Where(g => g.Kind is FacetKind.Presence))
        {
            <fieldset class="facet presence">
                <legend>
                    <span class="facet-head">
                        <span class="facet-name">@FacetWords.Group(Tag, group.Key)</span>
                        @Evidence(group)
                    </span>
                </legend>
                <div class="checks">
                    @foreach (var value in group.Values)
                    {
                        <label class="check">
                            <input type="checkbox" name="@group.Key" value="@value.Token"
                                   checked="@value.IsSelected" />
                            <span class="check-name">@FacetWords.Value(Tag, group.Key, value)</span>
                            <span class="count">@value.Count</span>
                        </label>
                    }
                </div>
            </fieldset>
        }
    }

    @*
        The two exclusions this listing applies by default (archived, adult) — ours, not a
        measurement of the game — so they stay as visible as the listing they shape. Link rows like
        every other row here, applying on click.
    *@
    <fieldset class="facet also">
        <legend>
            <span class="facet-head">
                <span class="facet-name">@Messages.For(Tag, "facet.alsoShow")</span>
            </span>
            <span class="facet-note">@Messages.For(Tag, "facet.alsoShow.note")</span>
        </legend>
        <div class="rows">
            <div class="facet-row @(Filter.IncludeArchived ? "on" : null)">
                <a class="pick" href="@Toggled(FacetKeys.Archived, Filter.IncludeArchived)"
                   aria-current="@(Filter.IncludeArchived ? "true" : null)"
                   aria-label="@Messages.For(Tag, "facet.archived.state", new Dictionary<string, object?> { ["shown"] = Filter.IncludeArchived ? "true" : "false" })">
                    <span class="tick" aria-hidden="true">@(Filter.IncludeArchived ? "✓" : "☐")</span>
                    <span class="row-name">@Messages.For(Tag, "facet.archived")</span>
                </a>
            </div>
            <div class="facet-row @(Filter.IncludeAdult ? "on" : null)">
                <a class="pick" href="@Toggled(FacetKeys.Adult, Filter.IncludeAdult)"
                   aria-current="@(Filter.IncludeAdult ? "true" : null)"
                   aria-label="@Messages.For(Tag, "facet.adult.state", new Dictionary<string, object?> { ["shown"] = Filter.IncludeAdult ? "true" : "false" })">
                    <span class="tick" aria-hidden="true">@(Filter.IncludeAdult ? "✓" : "☐")</span>
                    <span class="row-name">@Messages.For(Tag, "facet.adult")</span>
                </a>
            </div>
        </div>
    </fieldset>

    @* One line at the foot, and the evidence-word readings behind one disclosure. *@
    <div class="facet-key">
        <p class="facet-note">@Messages.For(Tag, "facet.countsNote")</p>

        <details class="facet-more">
            <summary>@Messages.For(Tag, "facet.key.summary")</summary>
            <ul>
                <li>
                    <span class="evidence measured"><span aria-hidden="true">●</span> @FacetWords.Evidence(Tag, FacetEvidence.Measured)</span>
                    — @FacetWords.EvidenceMeaning(Tag, FacetEvidence.Measured).
                </li>
                <li>
                    <span class="evidence declared"><span aria-hidden="true">◇</span> @FacetWords.Evidence(Tag, FacetEvidence.Declared)</span>
                    — @FacetWords.EvidenceMeaning(Tag, FacetEvidence.Declared).
                </li>
                <li>
                    <span class="evidence derived"><span aria-hidden="true">◆</span> @FacetWords.Evidence(Tag, FacetEvidence.Derived)</span>
                    — @FacetWords.EvidenceMeaning(Tag, FacetEvidence.Derived).
                </li>
                <li>@Messages.For(Tag, "facet.key.blank")</li>
                <li>@Messages.For(Tag, "facet.key.zero")</li>
                <li>@Messages.For(Tag, "facet.key.openEnded", new Dictionary<string, object?> { ["count"] = FacetedSearch.MaxValues })</li>
            </ul>
        </details>
    </div>

        </div>
    </details>
</form>

@*
    What the query is asking for, repeated where the results are, one removable chip each. Outside
    the form on purpose: these are links, and each undoes exactly one selection while leaving every
    other in place.
*@
@if (Chips.Count > 0)
{
    <div class="active-filters">
        <span class="kicker">@Messages.For(Tag, "filters.showing")</span>
        @foreach (var chip in Chips)
        {
            <a class="filter-chip" href="@Http.Link(chip.RemoveHref)">
                <span class="chip-facet">@chip.Facet</span>
                <span class="chip-value">@chip.Value</span>
                <span class="chip-x" aria-hidden="true">✕</span>
                <span class="sr-only">@Messages.For(Tag, "filters.stopFiltering")</span>
            </a>
        }
        <a class="clear-all" href="@Http.Link("/games")">@Messages.For(Tag, "filters.clearAll")</a>
    </div>
}

@code {
    /// <summary>The facets drawn first; the rest go behind a disclosure.</summary>
    /// <remarks>
    /// <see cref="FacetKeys.Family"/> — MSSP's own <c>FAMILY</c> line — sits ahead of
    /// <see cref="FacetKeys.Codebase"/> rather than behind the "more filters" disclosure: it is the
    /// coarser, more legible question of the two, and a reader deciding what kind of game they want
    /// asks it before they ask which codebase implements it.
    /// <see cref="FacetKeys.Trending"/> sits beside <see cref="FacetKeys.Band"/> — both are "what is
    /// this game doing lately" questions — rather than behind the disclosure, since a facet a reader
    /// can't discover without opening "more filters" first is a facet they can't find at all.
    /// </remarks>
    private static readonly string[] Lead =
        [FacetKeys.Band, FacetKeys.Trending, FacetKeys.Family, FacetKeys.Codebase, FacetKeys.LastSeen];

    /// <summary>Two independent facet groups sharing one heading and note (see <c>FacetKeys.Unreachable</c>).</summary>
    private static readonly string[] Measured = [FacetKeys.Uncounted, FacetKeys.Unreachable];

    private IReadOnlyList<FacetGroup> Choices =>
        [.. Facets.Where(g => g.Kind is FacetKind.Choice)];

    private IReadOnlyList<FacetGroup> Primary =>
        [.. Choices.Where(g => Lead.Contains(g.Key, StringComparer.Ordinal))
            .OrderBy(g => Array.IndexOf(Lead, g.Key))];

    /// <summary>
    /// The measurement switches, in declared order and only where there is something to switch — a
    /// group nothing matches is never built (see <c>FacetedSearch</c>), so the heading never stands
    /// over an empty box.
    /// </summary>
    private IReadOnlyList<FacetGroup> Measurable =>
        [.. Choices.Where(g => Measured.Contains(g.Key, StringComparer.Ordinal) && g.Values.Count > 0)
            .OrderBy(g => Array.IndexOf(Measured, g.Key))];

    private IReadOnlyList<FacetGroup> Secondary =>
        [.. Choices.Where(g => !Lead.Contains(g.Key, StringComparer.Ordinal)
            && !Measured.Contains(g.Key, StringComparer.Ordinal))];

    /// <summary>One facet group, wherever it is drawn.</summary>
    private RenderFragment Group(FacetGroup group) =>
        @<text>
                <fieldset class="facet choice @(group.IsFiltered ? "chosen" : null)">
                        @* Name on one edge, evidence badge on the other, both at the rows' own left padding. *@
                        <legend>
                            <span class="facet-head">
                                <span class="facet-name">@FacetWords.Group(Tag, group.Key)</span>
                                @Evidence(group)
                            </span>
                        </legend>

                        <div class="rows">
                            @* Always first: a facet you cannot un-choose is a trap. Drawn as a row, not a "clear" button. *@
                            <div class="@AnyRowClass(group)">
                                <a class="pick" href="@Href(group, null)"
                                   aria-current="@(group.IsFiltered ? null : "true")"
                                   aria-label="@Name("facet.any", group.Total, ("facet", FacetWords.Group(Tag, group.Key)))">
                                    <span class="tick" aria-hidden="true">@AnyGlyph(group)</span>
                                    <span class="row-name">@Messages.For(Tag, "facet.anyValue")</span>
                                    <span class="count">@group.Total</span>
                                </a>
                            </div>
    
                            @foreach (var value in Shown(group))
                            {
                                @Row(group, value)
                            }
                        </div>
    
                        @if (Rest(group) is { Count: > 0 } rest)
                        {
                            @* The tail, behind a native disclosure — open when it holds the reader's own selection. *@
                            <details class="facet-tail" open="@rest.Any(v => v.IsSelected)">
                                <summary>@Messages.For(Tag, "facet.moreValues", new Dictionary<string, object?> { ["count"] = rest.Count })</summary>
                                <div class="rows">
                                    @foreach (var value in rest)
                                    {
                                        @Row(group, value)
                                    }
                                </div>
                            </details>
                        }
                    </fieldset>
    
        </text>;

    /// <summary>
    /// How many values a facet shows before the rest go behind a disclosure. A facet may hold up to
    /// <see cref="FacetedSearch.MaxValues"/> (twelve); five keeps the panel shorter than the listing
    /// it filters, since values arrive commonest-first.
    /// </summary>
    private const int RowsShown = 5;

    /// <summary>The values with a row of their own, and the ones behind the disclosure. A selected value stays visible regardless of its count.</summary>
    private static IReadOnlyList<FacetValue> Shown(FacetGroup group)
    {
        var head = group.Values.Take(RowsShown).ToList();

        // Appended rather than promoted, so picking a value from the tail doesn't reorder the rows
        // under the reader's pointer.
        head.AddRange(group.Values.Skip(RowsShown).Where(v => v.IsSelected));

        return head;
    }

    private static IReadOnlyList<FacetValue> Rest(FacetGroup group) =>
        [.. group.Values.Except(Shown(group))];

    /// <summary>
    /// One value, as the two states it can be asked for and the one it is in.
    /// </summary>
    /// <remarks>
    /// Each link carries an <c>aria-label</c> holding value, count and effect together, since a
    /// screen reader arrowing through the row hears the control, not the three separate visible
    /// elements. The exclusion's count is what excluding actually returns (everything but this
    /// value), not the value's own count.
    /// </remarks>
    private RenderFragment Row(FacetGroup group, FacetValue value) =>
        @<div class="@RowClass(group, value)">
            <a class="pick" href="@Href(group, value.State is FacetState.Included ? null : value.Token)"
               aria-current="@(value.State is FacetState.Included ? "true" : null)"
               aria-label="@Name(Single(group) ? "facet.value.choose" : "facet.value.include", value.Count, ("value", FacetWords.Value(Tag, group.Key, value)))">
                <span class="tick" aria-hidden="true">@PickGlyph(group, value)</span>
                <span class="row-name">@FacetWords.Value(Tag, group.Key, value)</span>
                <span class="count">@value.Count</span>
            </a>
            @* No exclusion where the values are one ordered scale — "everything but games with somebody connected" isn't a real question. *@
            @if (!Single(group))
            {
                <a class="drop"
                   href="@Href(group, value.State is FacetState.Excluded ? null : Excluded(value).Token)"
                   aria-current="@(value.State is FacetState.Excluded ? "true" : null)"
                   aria-label="@Name("facet.value.exclude", group.Total - value.Count, ("value", FacetWords.Value(Tag, group.Key, value)))">
                    <span aria-hidden="true">@(value.State is FacetState.Excluded ? "×" : "−")</span>
                </a>
            }
        </div>;

    /// <summary>Whether this group's values are one ordered scale rather than alternatives.</summary>
    private static bool Single(FacetGroup group) => FacetWords.IsSingleChoice(group.Key);

    /// <summary>
    /// A row's classes, joined here rather than interpolated in the attribute — Razor renders a null
    /// branch as an empty string, so inline interpolation would ship trailing whitespace like
    /// <c>class="facet-row excluded "</c>.
    /// </summary>
    private static string RowClass(FacetGroup group, FacetValue value) =>
        string.Join(' ', Classes(
            "facet-row",
            RowState(value),
            Single(group) ? "single" : null,
            value is { Count: 0, IsSelected: false } ? "empty" : null));

    private static string AnyRowClass(FacetGroup group) =>
        string.Join(' ', Classes("facet-row", "any", group.IsFiltered ? null : "on", Single(group) ? "single" : null));

    private static IEnumerable<string> Classes(params string?[] parts) =>
        parts.Where(p => !string.IsNullOrEmpty(p))!;

    /// <summary>
    /// The glyph on a value's own row: a radio where the group is one choice, a checkbox where it
    /// is a set — matching the control's actual click behaviour.
    /// </summary>
    private static string PickGlyph(FacetGroup group, FacetValue value) => (Single(group), value.State) switch
    {
        (true, FacetState.Included) => "◉",
        (true, _) => "○",
        (false, FacetState.Included) => "✓",
        _ => "☐",
    };

    private static string AnyGlyph(FacetGroup group) => (Single(group), group.IsFiltered) switch
    {
        (true, false) => "◉",
        (true, true) => "○",
        (false, false) => "✓",
        _ => "☐",
    };

    /// <summary>The request, for the locale these names are spoken in.</summary>
    [CascadingParameter]
    private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    /// <summary>
    /// One accessible name, as a message rather than a sentence glued together here — string
    /// concatenation fixes English word order and plural rules for every translator at once.
    /// </summary>
    private string Name(string id, int count, params (string Key, object? Value)[] rest)
    {
        var args = new Dictionary<string, object?>(StringComparer.Ordinal) { ["count"] = count };

        foreach (var (key, value) in rest)
        {
            args[key] = value;
        }

        return Messages.For(Tag, id, args);
    }

    /// <summary>
    /// This listing, asked one facet differently — and asked nothing at all where the token is null,
    /// which is what makes a ticked row untick itself.
    /// </summary>
    /// <remarks>
    /// Links, not form controls, so they apply immediately on click with no script. The whole
    /// querystring rides along except unsubmitted search text, which no scriptless page can read.
    /// </remarks>
    private string Href(FacetGroup group, string? token) =>
        Http.Link("/games" + ListingLinks.With(Query, group.Key, token));

    /// <summary>
    /// This listing with one of the two inclusion switches flipped. Off is the absence of the key
    /// rather than <c>=false</c>, so the copied URL says only what was asked for.
    /// </summary>
    private string Toggled(string key, bool on) =>
        Http.Link("/games" + ListingLinks.With(Query, key, on ? null : "true"));

    private static string RowState(FacetValue value) => value.State switch
    {
        FacetState.Included => "on",
        FacetState.Excluded => "excluded",
        _ => "off",
    };

    /// <summary>
    /// The same value, spelled as an exclusion — <c>Evennia</c> becomes <c>!Evennia</c>. Built
    /// through <see cref="FacetChoice"/> rather than string-prefixed here, so escaping stays in sync
    /// with the binding's parser.
    /// </summary>
    private static FacetChoice Excluded(FacetValue value) =>
        (value.IsUnknown ? FacetChoice.Unknown : FacetChoice.Of(value.Token)) with { Exclude = true };

    [Parameter, EditorRequired] public IReadOnlyList<FacetGroup> Facets { get; set; } = [];

    [Parameter, EditorRequired] public GameFilter Filter { get; set; } = new();

    /// <summary>
    /// The querystring this listing is answering, which is what a chip needs to remove itself from.
    /// Optional — with none, there's nothing selected and nothing to draw.
    /// </summary>
    [Parameter] public string Query { get; set; } = string.Empty;

    private IReadOnlyList<ActiveFilter> Chips => ActiveFilters.For(Tag, Facets, Filter, Query);

    /// <summary>
    /// Whether this listing is answering anything narrower than "all of them" — decides the panel
    /// disclosure's start state.
    /// </summary>
    private bool AnyFiltered =>
        Chips.Count > 0 || Filter.IncludeArchived || Filter.IncludeAdult
        || Filter.Text is { Length: > 0 };

    /// <summary>The evidence chip, from the one component that draws it — keeps this panel and the find-a-game page from disagreeing on what "derived" looks like.</summary>
    private static RenderFragment Evidence(FacetGroup group) =>
        @<EvidenceChip Evidence="group.Evidence" />;
}
