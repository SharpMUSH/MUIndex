@using MUI.Web.Localization
@*
    A relative age ("19m ago") rendered as <time>, with the absolute instant in the title for a
    hover or reading-mode extraction. The datetime attribute never localizes — it's what browsers
    and extractors resolve the visible age against, not something a person reads.
*@

<time datetime="@Dates.Machine(At)" title="@Title" class="@Class">@Text@if (Spoken)
    {<span class="sr-only">@Messages.For(Tag, "time.spoken", new Dictionary<string, object?>(StringComparer.Ordinal) { ["stamp"] = Dates.Stamp(Tag, At) })</span>}</time>

@code {
    /// <summary>The instant being dated.</summary>
    [Parameter, EditorRequired] public DateTimeOffset At { get; set; }

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    /// <summary>
    /// Whether the visible text reads as something that already happened — <c>19m ago</c> rather
    /// than <c>19m</c>.
    /// </summary>
    /// <remarks>
    /// <see cref="Relative.Ago"/> owns the wording (including the "now ago" edge case), not this file.
    /// </remarks>
    [Parameter] public bool Ago { get; set; }

    /// <summary>
    /// Which question this age answers.
    /// </summary>
    /// <remarks>
    /// "2w ago" means different things for a confirmed value vs. an unreached game — English spells
    /// them the same, but the title text must carry the distinction since the visible text can't.
    /// </remarks>
    [Parameter] public AgeSense Sense { get; set; } = AgeSense.Confirmed;

    /// <summary>Whether a screen reader is given the absolute time as well as the age.</summary>
    [Parameter] public bool Spoken { get; set; }

    [Parameter] public string? Class { get; set; }

    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Tag => Http.LocaleOf().Tag;

    private string Text => Ago ? Relative.Ago(Tag, Now - At, Sense) : Relative.Format(Tag, Now - At);

    /// <summary>The age and the instant, in one string, so a reader isn't left to do the subtraction.</summary>
    /// <remarks>Word order belongs to the <c>time.title</c> message, not this file.</remarks>
    private string Title => Messages.For(Tag, "time.title", new Dictionary<string, object?>(StringComparer.Ordinal)
    {
        ["age"] = Relative.Ago(Tag, Now - At, Sense),
        ["stamp"] = Dates.Stamp(Tag, At),
    });
}
