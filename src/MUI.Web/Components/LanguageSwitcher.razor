@using MUI.Web.Localization

@*
    The language switcher.

    No flags: a flag denotes a state, not a language, and this directory's games don't map one to
    one with countries. Each language is named in itself (Deutsch, Русский, 中文), never in English —
    a reader looking for their own language wants the word they call it by.

    A select and a submit, because this site runs no script: choosing posts, the server writes the
    cookie and redirects back to the page the reader was on (not a localized home page).

    Renders only where there is a choice to make — one option is not a control, and a locale with
    untranslated strings shouldn't be offered (see LocaleStatus). Draws nothing in production today;
    a development build also lists the two review locales so the control can be looked at at all.
*@

@if (Offered.Count > 1)
{
    @* This locale's copy of the endpoint: nothing else on the request says which language the
       reader is leaving. *@
    <form class="locale" method="post" action="@HttpContext.Link(Locales.Path)">
        <input type="hidden" name="@Locales.ReturnField" value="@Here" />
        @* The label wraps the control rather than pointing at it by id, so this component can be
           rendered twice in one document without a duplicate-id collision. *@
        <label>
            <span class="kick">@Messages.For(Tag, "locale.label")</span>
        @* One box holding the choice and the way to commit it, echoing the search field's shape
           rather than a native dropdown plus a wide button. *@
        <span class="locale-field">
            <select name="@Locales.Field">
                @foreach (var locale in Offered)
                {
                    @* lang on the option, so a screen reader says each name in its own voice rather
                       than attempting 中文 with the phonetics of the page it is currently on. *@
                    <option value="@locale.Tag" lang="@locale.Tag" selected="@(locale.Tag == Tag)">
                        @locale.Endonym
                    </option>
                }
            </select>
            @* Over the select's own padding and click-through, so the whole box opens it. *@
            <span class="locale-caret" aria-hidden="true">▾</span>
            <button type="submit" class="locale-go" title="@Messages.For(Tag, "locale.submit")">
                <span aria-hidden="true">→</span>
                <span class="sr-only">@Messages.For(Tag, "locale.submit")</span>
            </button>
        </span>
        </label>
    </form>
}

@code {
    /// <summary>The request, for the locale in force and the page to come back to.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// What this switcher lists: the shipped locales, plus the review ones in a development build.
    /// </summary>
    /// <remarks>
    /// Asked of the request rather than injected: a component requiring <c>IWebHostEnvironment</c>
    /// couldn't render without a web host, and headless page tests need to. See
    /// <see cref="LocaleRouting.IsReviewBuild"/>.
    /// </remarks>
    private IReadOnlyList<Locale> Offered => Locales.Switchable(HttpContext.IsReviewBuild());

    private string Tag => HttpContext.LocaleOf().Tag;

    /// <summary>
    /// The page this control was rendered on, without its locale prefix.
    /// </summary>
    /// <remarks>
    /// The querystring travels with it: changing language shouldn't reset a narrowed listing.
    /// <para>
    /// <c>ToUriComponent</c>, not the decoded values — <c>Request.Path</c> comes back with raw
    /// characters for anything escaped, and a raw character here is refused by
    /// <see cref="LocaleRouting.Back"/> and lands the reader on the front page instead. The locale
    /// prefix is already off, since the middleware moved it into <c>PathBase</c>.
    /// </para>
    /// </remarks>
    private string Here =>
        HttpContext is { } context
            ? context.Request.Path.ToUriComponent() + context.Request.QueryString.ToUriComponent()
            : "/";
}
