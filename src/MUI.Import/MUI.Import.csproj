<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MUI.Import</RootNamespace>
    <AssemblyName>MUI.Import</AssemblyName>
  </PropertyGroup>

  <!--
    An importer reads someone else's directory over HTTP. It never opens a telnet socket, so it does
    not reference MUI.Crawl and never will: the moment it could construct a probe, "an import may not
    mint a game" (spec §7.2) would be a convention rather than a fact about the assembly graph.

    MUI.Discovery is here for ICrawlTargetRepository alone — an import seeds targets; the crawler
    decides when they are visited (spec §7.1).
  -->
  <ItemGroup>
    <ProjectReference Include="..\MUI.Catalog\MUI.Catalog.csproj" />
    <ProjectReference Include="..\MUI.Discovery\MUI.Discovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
