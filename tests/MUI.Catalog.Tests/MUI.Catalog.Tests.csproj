<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MUI.Catalog.Tests</RootNamespace>
    <AssemblyName>MUI.Catalog.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />

    <!--
      The Persistence tests talk to a real PostgreSQL 17. Half the design lives in CHECK constraints,
      so a writer asserted only against an in-memory fake has not been tested against the thing that
      enforces it. Where no container runtime is available they skip out loud rather than pass.
    -->
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MUI.Catalog\MUI.Catalog.csproj" />
  </ItemGroup>

</Project>
