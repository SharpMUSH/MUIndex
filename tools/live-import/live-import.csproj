<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MUI.Import.LiveVerification</RootNamespace>
    <AssemblyName>live-import</AssemblyName>
    <IsPackable>false</IsPackable>

    <!--
      Built by CI and never run by it. This is the one thing in the repository that talks to somebody
      else's live web server, and it runs when a human decides to run it.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MUI.Import\MUI.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

</Project>
