<Project>

  <!-- Central package version management for the whole solution. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Telnet negotiation. The probe engine is this library pointed outward: the handshake it performs
      IS the capability measurement (spec §6.1), so what a server offers is observed rather than
      taken from a game's own MSSP claim.
    -->
    <PackageVersion Include="TelnetNegotiationCore" Version="2.8.0" />

    <!-- Logging abstractions (TelnetNegotiationCore takes an ILogger). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />

    <!--
      Hosting and DI *abstractions* only. The crawler is an in-process BackgroundService in the web
      deployable (spec §4.11, §12), so it needs BackgroundService and IServiceCollection and nothing
      that decides how a host is built; MUI.Import exposes AddMuiImporters for the same reason, so a
      class library that reads other people's web pages gains no hosting dependency.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />

    <!--
      The container itself, for the two places that have to BUILD one rather than contribute to one:
      tools/live-import, so the directories it reads are the directories AddMuiImporters registers,
      and the import suite, so the tiers it asserts are the tiers this build ships. That is the whole
      reason — a second hand-written list of sources is how one ends up read and uncredited, or
      credited and unread, and §7.6's attribution rule is the one part of the etiquette a reader can
      check.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />

    <!--
      A console sink, for mui-crawl and nothing else. The site's own logging is the host's business;
      a one-shot command that writes a crawl cycle to a terminal needs somewhere for it to go.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Persistence: PostgreSQL 17 with Npgsql and Dapper, and plain numbered .sql migrations applied
      by our own runner. No EF Core, ever — the schema is legible to anyone with psql, which is the
      property that matters when something has gone wrong in production at four in the morning.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack: TUnit (source-generated, runs on Microsoft.Testing.Platform). -->
    <PackageVersion Include="TUnit" Version="1.61.38" />

    <!--
      A real PostgreSQL 17 for the repository tests. A writer asserted against an in-memory fake and
      never against a database has not been tested against the CHECK constraints that carry half the
      design, so the storage suite talks to a container or honestly skips.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
  </ItemGroup>

</Project>
