<Project>

  <!-- Central package version management for the whole solution. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Telnet negotiation. The probe engine is this library pointed outward: the handshake it performs
      IS the capability measurement (spec §6.1), so what a server offers is observed rather than
      taken from a game's own MSSP claim.
    -->
    <PackageVersion Include="TelnetNegotiationCore" Version="2.9.0" />

    <!-- Logging abstractions (TelnetNegotiationCore takes an ILogger). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />

    <!--
      The legacy code pages, for CHARSET overrides. .NET ships UTF-*, ASCII and Latin-1 and nothing
      else: GBK, Big5, EUC-KR, Shift-JIS and the Windows code pages all raise ArgumentException from
      Encoding.GetEncoding until CodePagesEncodingProvider is registered. Measured on .NET 10 — the
      NU1510 this raises says the reference is likely unnecessary, and it is wrong.
    -->
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.2" />

    <!--
      Hosting and DI *abstractions* only. The crawler is an in-process BackgroundService in the web
      deployable (spec §4.11, §12), so it needs BackgroundService and IServiceCollection and nothing
      that decides how a host is built; MUI.Import exposes AddMuiImporters for the same reason, so a
      class library that reads other people's web pages gains no hosting dependency.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />

    <!--
      Retry, for the confirming dial and nothing else (see DiscoveryOptions.ConfirmationAttempts).
      Polly.Core rather than the Polly metapackage: this needs one resilience strategy, not the
      registry, the DI extensions or the rate limiter — the crawl loop already has its own limiter
      and its own concurrency bound, and neither is a policy decision worth outsourcing.
    -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />

    <!--
      A console sink, for mui-crawl and nothing else. The site's own logging is the host's business;
      a one-shot command that writes a crawl cycle to a terminal needs somewhere for it to go.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TXT lookups, for spec §11's opt-out and nothing else. The BCL resolves names to addresses and
      cannot ask a resolver anything else: System.Net.Dns has no TXT query, and the portable ways to
      get one are P/Invoking res_query or writing a DNS client, which is a wire format this project
      has no business owning. A record an operator publishes to make us stop is a thing we have to be
      able to read reliably on every host this runs on, so the dependency is the honest answer.
    -->
    <PackageVersion Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Persistence: PostgreSQL 17 with Npgsql and Dapper, and plain numbered .sql migrations applied
      by our own runner. No EF Core, ever — the schema is legible to anyone with psql, which is the
      property that matters when something has gone wrong in production at four in the morning.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Markdown, for the hand-written reference pages (spec §9) and nothing else. Pure managed, no
      transitive dependencies, and no runtime asset of its own — which matters because a rendered
      page here may fetch from no external host, and a renderer that emitted a CDN link or a remote
      font would break that on a surface nobody thinks to check. The pipeline is built with raw HTML
      disabled for the same reason: an author cannot put a remote script or image into a content file
      even by accident, so "no external hosts" is a property of the parser rather than of editorial
      care.
    -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack: TUnit (source-generated, runs on Microsoft.Testing.Platform). -->
    <PackageVersion Include="TUnit" Version="1.61.38" />

    <!--
      A real PostgreSQL 17 for the repository tests. A writer asserted against an in-memory fake and
      never against a database has not been tested against the CHECK constraints that carry half the
      design, so the storage suite talks to a container or honestly skips.

      4.14.0 rather than 4.13.0 because the older one drags in SSH.NET 2025.1.0, which carries
      GHSA-q939-rpr3-3284 — and NuGet's audit is a build error here, so main stopped restoring the
      day the advisory was published. Nothing in this repository opens an SSH connection; the
      dependency exists so Testcontainers can reach a remote Docker host.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

</Project>
