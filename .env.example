# Copy to .env beside compose.yaml — `docker compose` reads that file automatically — and edit.
# .env is gitignored because the password below belongs in it and nowhere else.
#
# The values here are the mu-index.com deployment's, spelled out rather than described, because the
# two settings most easily got wrong are the two nobody notices: a port published past the firewall
# looks fine from a browser, and a placeholder contact address looks fine from everywhere except
# somebody else's log.

# --- On the server only --------------------------------------------------------------------------
# Uncomment this block on the deployment. It makes plain `docker compose` commands read the
# production overlay as well — TLS in front, the updater behind, no published port — so nothing,
# including the systemd unit, has to remember a -f flag.
#
#COMPOSE_FILE=compose.yaml:deploy/compose.production.yaml
#SITE_DOMAIN=mu-index.com
#CRAWLER_DOMAIN=crawler.mu-index.com
#ACME_EMAIL=you@example.com

# --- The database ------------------------------------------------------------------------------
# Anything but the default. The compose file passes this to Postgres and to the site, so it is the
# one value both halves must agree on.
MUI_POSTGRES_PASSWORD=change-me

# --- The port ----------------------------------------------------------------------------------
# Loopback ONLY on a host with a reverse proxy in front. Docker publishes ports by writing iptables
# rules ahead of ufw, so "8080" here is 8080 open to the internet no matter what the host firewall
# was told — the site answering directly beside the Traefik that terminates its TLS.
#
# Leave it unset (or "8080") for a laptop with nothing in front of it. On the server the production
# overlay publishes NO port at all and this value stops mattering; it is here because the overlay is
# the thing most easily forgotten, and loopback is the right answer the moment it is.
MUI_PORT=127.0.0.1:8080

# --- Who we are when we dial (§11) --------------------------------------------------------------
# Announced over TTYPE/MNES to every server the crawler reaches, and typed by hand into a mail
# client by an admin who has just found an unfamiliar connection. /crawler redirects to the part of
# /about that answers them.
#
# Unset, the crawler announces a placeholder that answers nobody and /about says so on the page.
MUI_CRAWL_INFO_URL=https://mu-index.com/crawler

# --- Sign-in -----------------------------------------------------------------------------------
# The WebAuthn relying-party ID: the REGISTRABLE domain, not the host. mu-index.com covers both the
# apex and www; www.mu-index.com would not cover the apex. Every credential registered under one
# value has to be registered again if it changes, so it is set explicitly rather than inferred from
# the Host header.
MUI_PASSKEY_DOMAIN=mu-index.com

# --- Administration over MCP ---------------------------------------------------------------------
# The bearer secret that gates /mcp — the authenticated MCP endpoint an MCP client (e.g. Claude Code)
# calls to administer this deployment (seed the crawler, record an opt-out, hand-set a game field)
# instead of ssh'ing in and running mui-crawl through docker compose. Unset means every request to
# /mcp fails authentication; there is no value here on purpose. Generate one on the box —
# `openssl rand -hex 32` — and set it in .env, never in this file or in git.
MUI_MCP_TOKEN=

# --- How long presence is kept -------------------------------------------------------------------
# Whole days per grain. LEAVE THESE UNSET TO KEEP EVERYTHING, which is what the catalogue defaults to
# and what §15.4 leaves open: between an unsettled retention period and a deletion, the conservative
# answer is to delete nothing. A value that is not a positive whole number throws at startup rather
# than being read back as "unset" -- a deployment that believes it has bounded its storage and has not
# is the failure worth being loud about.
#
# Measured on the one deployment (931 games): the hourly rollup takes ~503 MB a year and raw presence
# ~450 MB, against the daily rollup's ~68 MB. The daily grain is both the smallest and the copy every
# other grain may be dropped in favour of, so it is the one to leave alone.
#
# mu-index.com runs 360 on both, which is a year of everything for about 940 MB. These stay EMPTY here
# because this file is the template a fork copies, and the shipped default has to remain "keep
# everything" -- a fork inheriting somebody else's deletion policy from an example file is the wrong
# way round. See docs/deploy.md for the arithmetic, including why hourly is the grain to cut first if
# storage is ever short: it compresses raw only 1.34:1 at this crawl cadence while costing more per
# row, so a year of it buys less than a year of raw does.
#
# Both grains below are dropped a whole month at a time -- raw has been partitioned since migration
# 0003, hourly since 0037 -- so a sweep is a DROP per month, not a DELETE per row. See docs/deploy.md,
# "How long presence is kept", including why 90 days of hourly is not stingy: the only reader of it is
# the game page's heatmap, over 56 days.
MUI_RETAIN_RAW_DAYS=
MUI_RETAIN_HOURLY_DAYS=

# §5.2 keeps the daily grain for ever. Setting this departs from the design; nothing outlives it.
MUI_RETAIN_DAILY_DAYS=

# --- Day-one seeds -----------------------------------------------------------------------------
# Addresses of real servers belonging to other people, dialled within a cycle. §7.1's effective seed
# set is every game ever found, so this matters on the first run and is a convenience afterwards.
# Whitespace or commas; an IPv6 literal is bracketed.
MUI_CRAWL_SEEDS=

# false makes this replica a pure web tier. The advisory lock already guarantees one crawler per
# database, so this is a choice about WHERE the crawl runs rather than a safety net.
#
# FALSE FOR A FIRST START, and true as a separate step once /about shows a real contact address.
# Starting the site is the moment it begins opening sockets to other people's machines, and it is
# also the moment every mistake in this file is still in it — a restored catalogue makes them all at
# once, because every target in it is already overdue.
MUI_CRAWL_ENABLED=false

# --- Intermud-3 --------------------------------------------------------------------------------
# I3 is a network of LP-family games that predates MSSP and never adopted it, and whose login
# prompts take a character name rather than commands — so the telnet probe has nothing on the
# connect screen to count. `who-req` returns an array of users instead, and the count is its length.
#
# TWO SWITCHES, ON PURPOSE, and they do different things:
#
#   COMPOSE_PROFILES=i3   starts the sidecar container, which CONNECTS TO A PUBLIC NETWORK and
#                         registers a mud name there PERMANENTLY. Mudlist entries are never removed,
#                         only marked down. Whatever MUI_I3_NAME says on the first connect is what
#                         the network remembers for good.
#   MUI_I3_ENABLED=true   makes the site talk to that sidecar.
#
# Neither is useful without the other, and neither is acquired by upgrading an image. Turning the
# first one on is the irreversible half.
#
# The first pass seeds roughly 130 addresses we do not have, all due immediately, which the ordinary
# crawler then dials at its usual batch size. That is a visible step up in outbound traffic on one
# cycle; it is the point of the feature, and it is worth watching the first time.
#
#COMPOSE_PROFILES=i3
#MUI_I3_ENABLED=true

# The name the network remembers. Chosen once — see above.
MUI_I3_NAME=MUIndex

# §11's obligation in the network's own vocabulary: an admin who finds us in their who-log reaches a
# person. No default in the tree, for the same reason MUI_CRAWL_INFO_URL has none.
MUI_I3_ADMIN_EMAIL=

# Two secrets for the sidecar's LOCAL API, which is not published outside the compose network.
# Generate both — `openssl rand -hex 32` — and do not reuse the example keys upstream ships.
# MUI_I3_API_KEY is the one the site authenticates with; they must not be the same value.
MUI_I3_SECRET=
MUI_I3_API_KEY=

# Which router. *i4 is where the interoperability run was made. The documented test router, *wir at
# 136.144.155.250:3004, does not answer — *wpr responds on the same address at 8080 — so there is no
# rehearsal available and the first connection is a real one.
MUI_I3_ROUTER_NAME=*i4
MUI_I3_ROUTER_HOST=204.209.44.3
MUI_I3_ROUTER_PORT=8080
